*.html text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.patch text eol=lf
*.proto text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.c text eol=lf
*.h text eol=lf
*.bin binary
*.wasm binary
*.node binary
rust/crates/auth/fuzz/corpus/** binary
rust/crates/filesystem/fuzz/corpus/** binary
rust/codec-fuzz/corpus/*/* binary
rust/crates/harness-providers/fuzz/corpus/*/* binary
rust/codec-fuzz/captures/*.requests.jsonl binary
rust/codec-fuzz/captures/*.stdout.jsonl binary

# Preserve byte-exact patch context.
*.patch -whitespace
# Vendored sources retain upstream whitespace, like their recorded source bytes.
rust/vendor/** -whitespace
# ts-rs emits spaces before line breaks in its generated declarations.
typescript/packages/actors/src/generated/**/*.ts whitespace=-blank-at-eol

# Fuzz corpus entries are byte-exact inputs, including intentional trailing spaces.
rust/crates/harness-fuzz/corpus/** binary
rust/fuzz/corpus/** binary

rust/crates/harness-fuzz/corpus/reader_snapshot-*.tsv text eol=lf diff
rust/crates/stream/fuzz/corpus/status/** binary

# Captured external-tool output retains the generator's Windows newlines.
scripts/graphcoder-e2e/fixtures/npm-command.cmd -text whitespace=cr-at-eol

# Provider captures are original wire bytes, including their original newlines.
rust/crates/conformance/fixtures/inference/**/*.body binary
rust/crates/conformance/fixtures/inference/**/*.request.json -text

# Outside vendored sources, each exception below is exact; all other paths are diff --check clean.
# streaming_seed_corpus replays these seeds: spaces before a newline are the hard-break grammar they cover.
rust/crates/markdown/fuzz/corpus/streaming/grammar-visibility -whitespace
rust/crates/markdown/fuzz/corpus/streaming/inline-adjacency -whitespace
# browser_corpus_uses_the_shared_rust_codec_and_exact_outcomes decodes this protobuf seed and asserts its outcome.
rust/crates/stream/fuzz/corpus/session/browser-opened-foreign binary
# Protobuf-encoded task-volume seeds: their tab, newline and space bytes are field data, not text.
rust/fuzz/task-volume/corpus/task_volume/head_31 binary
rust/fuzz/task-volume/corpus/task_volume/head_32 binary
