*.json text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.proto text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.c text eol=lf
*.h text eol=lf
*.bin binary
*.wasm binary
*.node binary
rust/crates/auth/fuzz/corpus/** binary
fuzz/corpus/objects_batch/** binary

# Preserve byte-exact patch context.
patches/*.patch -whitespace
# ts-rs emits spaces before line breaks in its generated declarations.
typescript/packages/actors/src/generated/**/*.ts whitespace=-blank-at-eol

# Fuzz corpus entries are byte-exact inputs, including intentional trailing spaces.
rust/crates/harness-fuzz/corpus/** binary

rust/crates/objects/fuzz/corpus/batch_reply/*.pb binary
