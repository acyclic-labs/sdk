{
  "description": "Routes Codex subagents through isolated Acyclic filesystem workspaces.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "acyclic_agent_workspaces",
            "tool": "_hook_session_start",
            "input": {
              "session_id": "${session_id}",
              "cwd": "${cwd}"
            },
            "timeout": 120,
            "statusMessage": "Attaching the root Acyclic workspace"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "acyclic_agent_workspaces",
            "tool": "_hook_user_prompt",
            "input": {
              "session_id": "${session_id}",
              "turn_id": "${turn_id}"
            },
            "timeout": 30,
            "statusMessage": "Binding the root agent turn"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "acyclic_agent_workspaces",
            "tool": "_hook_pre_tool",
            "input": {
              "session_id": "${session_id}",
              "turn_id": "${turn_id}",
              "tool_use_id": "${tool_use_id}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}"
            },
            "timeout": 30,
            "statusMessage": "Opening the Acyclic operation window"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "acyclic_agent_workspaces",
            "tool": "_hook_post_tool",
            "input": {
              "session_id": "${session_id}",
              "turn_id": "${turn_id}",
              "tool_use_id": "${tool_use_id}",
              "tool_name": "${tool_name}"
            },
            "timeout": 120,
            "statusMessage": "Publishing the Acyclic operation window"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "acyclic_agent_workspaces",
            "tool": "_hook_subagent_start",
            "input": {
              "session_id": "${session_id}",
              "turn_id": "${turn_id}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}"
            },
            "timeout": 120,
            "statusMessage": "Forking an isolated Acyclic workspace"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "acyclic_agent_workspaces",
            "tool": "_hook_subagent_stop",
            "input": {
              "session_id": "${session_id}",
              "turn_id": "${turn_id}",
              "agent_id": "${agent_id}"
            },
            "timeout": 120,
            "statusMessage": "Sealing the subagent workspace"
          }
        ]
      }
    ]
  }
}
