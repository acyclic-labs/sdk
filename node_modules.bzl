"""Builds a node_modules tree in runfiles from declared package targets."""

def _node_modules_impl(ctx):
    output = ctx.actions.declare_directory("node_modules")
    inputs = []
    copies = []
    for target, spec in ctx.attr.packages.items():
        files = target[DefaultInfo].files.to_list()
        inputs.append(target[DefaultInfo].files)
        name, directory = spec.split("=", 1)
        root = "/".join([part for part in [target.label.workspace_root, directory] if part])
        for file in files:
            if file.is_directory:
                copies.append(file.path + "/.\t" + name)
            else:
                prefix = root + "/" if root else ""
                if not file.path.startswith(prefix):
                    fail("package input is outside its declared root: " + file.path)
                copies.append(file.path + "\t" + name + "/" + file.path[len(prefix):])
    manifest = ctx.actions.declare_file(ctx.label.name + ".copies")
    ctx.actions.write(manifest, "\n".join(copies) + "\n")
    ctx.actions.run_shell(
        inputs = depset([manifest], transitive = inputs),
        outputs = [output],
        arguments = [output.path, manifest.path],
        command = """set -eu
mkdir -p "$1"
while IFS=$'\\t' read -r source destination; do
    mkdir -p "$1/$(dirname "$destination")"
    cp -rL "$source" "$1/$destination"
done < "$2"
""",
        mnemonic = "NodeModules",
    )
    return [DefaultInfo(files = depset([output]))]

node_modules = rule(
    implementation = _node_modules_impl,
    attrs = {
        "packages": attr.label_keyed_string_dict(allow_files = True, mandatory = True),
    },
)
