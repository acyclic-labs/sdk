"""Builds a node_modules tree in runfiles from declared package targets."""

def _workspace_package_impl(ctx):
    output = ctx.actions.declare_directory(ctx.label.name)
    inputs = [ctx.attr.srcs[DefaultInfo].files]
    arguments = [output.path, ctx.attr.directory]
    excludes = ["--exclude=./node_modules"]
    for path in ctx.attr.generated.values():
        excludes.append("--exclude=./%s" % path)
    commands = [
        "mkdir -p \"$1\"",
        "tar -C \"$2\" -h %s -cf - . | tar -C \"$1\" -xf -" % " ".join(excludes),
    ]
    for generated, path in ctx.attr.generated.items():
        files = generated[DefaultInfo].files.to_list()
        if len(files) != 1 or not files[0].is_directory:
            fail("%s: generated %s is not one directory" % (ctx.label, generated.label))
        inputs.append(generated[DefaultInfo].files)
        arguments.append(files[0].path)
        source = len(arguments)
        arguments.append(path)
        destination = len(arguments)
        commands.append("mkdir -p \"$1/$%d\"" % destination)
        commands.append("cp -rL \"$%d\"/. \"$1/$%d\"/" % (source, destination))
    ctx.actions.run_shell(
        inputs = depset(transitive = inputs),
        outputs = [output],
        arguments = arguments,
        command = " && ".join(commands),
        mnemonic = "WorkspacePackage",
    )
    return [DefaultInfo(files = depset([output]))]

workspace_package = rule(
    implementation = _workspace_package_impl,
    attrs = {
        "srcs": attr.label(mandatory = True),
        "directory": attr.string(mandatory = True),
        "generated": attr.label_keyed_string_dict(allow_files = True),
    },
)

def _node_modules_impl(ctx):
    output = ctx.actions.declare_directory("node_modules")
    inputs = []
    arguments = [output.path]
    commands = ["mkdir -p \"$1\""]
    for target, spec in ctx.attr.packages.items():
        files = target[DefaultInfo].files.to_list()
        inputs.append(target[DefaultInfo].files)
        name, directory = spec.split("=", 1)
        parent = name.rsplit("/", 1)[0] if "/" in name else ""
        if parent:
            commands.append("mkdir -p \"$1/%s\"" % parent)
        source = files[0].path if len(files) == 1 and files[0].is_directory else directory
        arguments.append(source)
        commands.append("cp -rL \"$%d\" \"$1/%s\"" % (len(arguments), name))
    ctx.actions.run_shell(
        inputs = depset(transitive = inputs),
        outputs = [output],
        arguments = arguments,
        command = " && ".join(commands),
        mnemonic = "NodeModules",
    )
    return [DefaultInfo(files = depset([output], transitive = inputs))]

node_modules = rule(
    implementation = _node_modules_impl,
    attrs = {
        "packages": attr.label_keyed_string_dict(allow_files = True, mandatory = True),
    },
)
