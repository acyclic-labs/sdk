+fn bazel_output_base(workspace: &std::path::Path) -> Option<&std::path::Path> {
+    // Both Bazel execroots end in execroot/<workspace>. A sandbox allocates that
+    // same layout under <output_base>/sandbox/<strategy>/<id>.
+    let base = workspace
+        .parent()
+        .filter(|dir| dir.file_name().is_some_and(|name| name == "execroot"))?
+        .parent()?;
+    let in_sandbox = base
+        .file_name()
+        .and_then(|name| name.to_str())
+        .is_some_and(|id| id.bytes().all(|byte| byte.is_ascii_digit()));
+    Some(
+        base.parent()
+            .and_then(|strategy| strategy.parent())
+            .filter(|sandbox| in_sandbox && sandbox.file_name().is_some_and(|name| name == "sandbox"))
+            .and_then(|sandbox| sandbox.parent())
+            .unwrap_or(base),
+    )
+}
+
+#[cfg(test)]
+#[test]
+fn sandbox_and_plain_execroots_share_the_output_base() {
+    use std::path::Path;
+    let output = Path::new("work/target/bazel");
+    let plain = output.join("execroot/_main");
+    let sandbox = output.join("sandbox/linux-sandbox/19/execroot/_main");
+    assert_eq!(bazel_output_base(&plain), Some(output));
+    assert_eq!(bazel_output_base(&sandbox), Some(output));
+    assert_eq!(bazel_output_base(Path::new("work/src")), None);
+}
