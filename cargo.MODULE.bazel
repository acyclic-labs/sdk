rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    versions = [
        "1.98.1",
    ],
    edition = "2024",
    opt_level = {"dbg":"0","fastbuild":"1","opt":"3"},
    extra_rustc_flags = [
        "--cfg",
        "tokio_unstable",
        "-Ccodegen-units=64",
        "-Clto=off",
    ],
    extra_exec_rustc_flags = [
        "--cfg",
        "tokio_unstable",
        "-Ccodegen-units=64",
        "-Clto=off",
    ],
)
