    crate = "blake3",
    rustc_flags = [
        "-Copt-level=3",
    ],
)

crate.annotation(
    crate = "loom",
    rustc_flags = [
        "-Copt-level=3",
    ],
)

crate.annotation(
    crate = "curve25519-dalek",
    rustc_flags = [
        "-Copt-level=3",
    ],
)

crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
    ],
    supported_platform_triples = [
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")
