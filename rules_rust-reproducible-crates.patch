+/// Copies `conf` to a regular file in a directory of this action's own, and returns that
+/// directory canonicalized. clippy canonicalizes its configuration file and folds the result into
+/// the crate hash: a declared input is a symlink into whichever checkout ran the build, so read in
+/// place it would give the same action a different crate in every checkout.
+fn stage_clippy_conf(conf: &str) -> Result<PathBuf, ProcessWrapperError> {
+    let staged = PathBuf::from(format!("_clippy_conf.{}", std::process::id()));
+    fs::create_dir_all(&staged)
+        .and_then(|()| copy(conf, staged.join("clippy.toml")).map(drop))
+        .and_then(|()| staged.canonicalize())
+        .map_err(|e| ProcessWrapperError(format!("failed to stage {conf}: {e}")))
+}
