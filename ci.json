{
  "revision": 6,
  "repository": "sdk",
  "default_branch": "main",
  "trigger": "continuous",
  "rust_toolchain": "rust-toolchain.toml",
  "cargo_lockfile": "Cargo.lock",
  "variables": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_TERM_COLOR": "always"
  },
  "authority": null,
  "jobs": [
    {
      "name": "gate",
      "runner": "linux_check",
      "timeout_minutes": 15,
      "checkout": "source",
      "condition": { "kind": "always" },
      "depends_on": [],
      "caches": ["rustup", "cargo_registry", "compiler", "tools"],
      "reuse": "exact_tree",
      "inputs": [], "qualifications": [], "releases": [],
      "steps": [{
        "name": "qualify-gate",
        "condition": "succeeded",
        "action": { "kind": "shell", "working_directory": ".", "command": "bash scripts/qualify-ci.sh gate" }
      }],
      "outputs": [{ "name": "coverage", "path": "$(Build.ArtifactStagingDirectory)/coverage", "condition": "succeeded" }]
    },
    {
      "name": "linux",
      "runner": "linux",
      "timeout_minutes": 15,
      "checkout": "source_history",
      "condition": { "kind": "always" },
      "depends_on": [],
      "caches": ["rustup", "cargo_registry", "compiler", "bun", "tools"],
      "reuse": "exact_tree",
      "inputs": [], "qualifications": [], "releases": [],
      "steps": [{
        "name": "qualify-linux",
        "condition": "succeeded",
        "action": { "kind": "shell", "working_directory": ".", "command": "bash scripts/qualify-ci.sh linux" }
      }],
      "outputs": [{ "name": "packages-linux", "path": "$(Build.ArtifactStagingDirectory)/packages", "condition": "succeeded" }]
    },
    {
      "name": "policy",
      "runner": "linux_check",
      "timeout_minutes": 15,
      "checkout": "source_history",
      "condition": { "kind": "always" },
      "depends_on": [],
      "caches": ["rustup", "cargo_registry", "compiler", "tools"],
      "reuse": "exact_tree",
      "inputs": [], "qualifications": [], "releases": [],
      "steps": [{
        "name": "qualify-policy",
        "condition": "succeeded",
        "action": { "kind": "shell", "working_directory": ".", "command": "bash scripts/qualify-ci.sh policy" }
      }],
      "outputs": []
    },
    {
      "name": "web",
      "runner": "linux",
      "timeout_minutes": 15,
      "checkout": "source",
      "condition": { "kind": "always" },
      "depends_on": [],
      "caches": ["rustup", "cargo_registry", "compiler", "tools"],
      "reuse": "exact_tree",
      "inputs": [], "qualifications": [], "releases": [],
      "steps": [{
        "name": "qualify-web",
        "condition": "succeeded",
        "action": { "kind": "shell", "working_directory": ".", "command": "bash scripts/qualify-ci.sh web" }
      }],
      "outputs": []
    },
    {
      "name": "linux-arm64",
      "runner": "linux_arm64",
      "timeout_minutes": 15,
      "checkout": "source",
      "condition": { "kind": "always" },
      "depends_on": [],
      "caches": ["rustup", "cargo_registry", "compiler", "bun", "tools"],
      "reuse": "exact_tree",
      "inputs": [], "qualifications": [], "releases": [],
      "steps": [{
        "name": "qualify-linux-arm64",
        "condition": "succeeded",
        "action": { "kind": "shell", "working_directory": ".", "command": "bash scripts/qualify-ci.sh linux-arm64" }
      }],
      "outputs": [{ "name": "packages-linux-arm64", "path": "$(Build.ArtifactStagingDirectory)/packages", "condition": "succeeded" }]
    },
    {
      "name": "windows",
      "runner": "windows",
      "timeout_minutes": 15,
      "checkout": "source",
      "condition": { "kind": "always" },
      "depends_on": [],
      "caches": ["rustup", "cargo_registry", "compiler", "bun", "tools"],
      "reuse": "exact_tree",
      "inputs": [], "qualifications": [], "releases": [],
      "steps": [{
        "name": "qualify-windows",
        "condition": "succeeded",
        "action": { "kind": "shell", "working_directory": ".", "command": ".\\scripts\\qualify-ci.ps1 -Lane windows" }
      }],
      "outputs": []
    },
    {
      "name": "macos",
      "runner": "macos",
      "timeout_minutes": 15,
      "checkout": "source",
      "condition": { "kind": "always" },
      "depends_on": [],
      "caches": ["rustup", "cargo_registry", "compiler", "bun", "tools"],
      "reuse": "exact_tree",
      "inputs": [], "qualifications": [], "releases": [],
      "steps": [{
        "name": "qualify-macos",
        "condition": "succeeded",
        "action": { "kind": "shell", "working_directory": ".", "command": "bash scripts/qualify-ci.sh macos" }
      }],
      "outputs": [{ "name": "packages-macos", "path": "$(Build.ArtifactStagingDirectory)/packages", "condition": "succeeded" }]
    }
  ]
}
