{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acyclic.dev/schemas/sdk-release-npm-packages.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["slug", "directory", "name", "source"],
    "properties": {
      "slug": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" },
      "directory": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" },
      "name": { "type": "string", "pattern": "^@acyclic-labs/[a-z]+(-[a-z]+)*$" },
      "source": { "enum": ["typescript", "plugin"] }
    },
    "additionalProperties": false
  }
}
