{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acyclic.dev/schemas/sdk-provenance.json",
  "type": "object",
  "required": ["imports", "references"],
  "properties": {
    "$schema": { "type": "string" },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceRepository", "sourceCommit", "sourcePath", "destinationPath", "license", "auditResult", "reviewer"],
        "properties": {
          "sourceRepository": { "type": "string" }, "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "sourcePath": { "type": "string" }, "destinationPath": { "type": "string" }, "license": { "const": "Apache-2.0" },
          "auditResult": { "enum": ["approved", "rejected", "pending"] }, "reviewer": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repository", "commit", "paths", "purpose"],
        "properties": {
          "repository": { "type": "string" },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "purpose": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
