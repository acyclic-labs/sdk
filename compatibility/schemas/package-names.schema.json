{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acyclic.dev/schemas/sdk-package-names.json",
  "type": "object",
  "required": ["families"],
  "properties": {
    "$schema": { "type": "string" },
    "families": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["registry", "umbrella", "implemented"],
        "properties": {
          "registry": { "type": "string" },
          "umbrella": { "type": ["string", "null"] },
          "implemented": { "type": "boolean" },
          "aliases": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
