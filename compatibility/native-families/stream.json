{
  "buildScript": "scripts/build-stream-native.mjs",
  "companionDirectory": "native",
  "features": [],
  "key": "stream",
  "manifestRelative": "rust/crates/stream-napi/Cargo.toml",
  "npmPackage": "@acyclic-labs/stream",
  "packageDirectory": "typescript/packages/stream",
  "packageRelative": "typescript/packages/stream/package.json",
  "rustPackageName": "acyclic-stream-napi",
  "rustTarget": "acyclic_stream_napi",
  "schema": "acyclic.native-family.v1",
  "sourceRoots": [
    ".cargo/config.toml",
    "Cargo.lock",
    "Cargo.toml",
    "buf.gen.yaml",
    "buf.lock",
    "buf.yaml",
    "bun.lock",
    "compatibility",
    "package.json",
    "patches/connect-2.3.0.patch",
    "patches/napi-rs-cli-3.10.12.patch",
    "rust-toolchain.toml",
    "rust/crates/auth",
    "rust/crates/auth-action",
    "rust/crates/collections",
    "rust/crates/contract-derive",
    "rust/crates/differential",
    "rust/crates/host-platform",
    "rust/crates/native-runtime",
    "rust/crates/observability",
    "rust/crates/proto-codegen",
    "rust/crates/stream",
    "rust/crates/stream-napi",
    "rust/vendor/napi-3.15.0",
    "rust/vendor/tonic-web-wasm-client-0.9.2",
    "rust/vendor/ts-rs-macros-12.0.1",
    "scripts",
    "tsconfig.base.json",
    "typescript/packages/stream/generated/proto",
    "typescript/packages/stream/package.json",
    "typescript/packages/stream/src",
    "typescript/packages/stream/tsconfig.json"
  ],
  "targets": [
    "x86_64-pc-windows-msvc",
    "x86_64-unknown-linux-gnu",
    "aarch64-apple-darwin"
  ],
  "version": "0.2.0",
  "wasm": {
    "artifact": "acyclic_stream",
    "features": [
      "wasm"
    ],
    "noDefaultFeatures": true,
    "outName": "acyclic_stream_wasm",
    "targetDirectory": "stream-wasm"
  },
  "wasmPackageName": "acyclic-stream"
}
