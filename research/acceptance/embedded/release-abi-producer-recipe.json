{
  "schema": "acyclic.sdk.embedded.release-abi-producer-recipe.v1",
  "producer": "embedded-release-abi",
  "authority": {
    "kind": "rust-crate",
    "source_root": "rust/crates/sdk-embedded-prototype",
    "source_manifest": "rust/crates/sdk-embedded-prototype/Cargo.toml",
    "source_lockfile": "rust/crates/sdk-embedded-prototype/Cargo.lock",
    "source_revision": "receipt.source.revision",
    "source_digest": "receipt.source.source_digest"
  },
  "entrypoint": "cpp/embedded-consumer/portable-package-test.ps1",
  "command": "pwsh -NoProfile -File {source_root}/cpp/embedded-consumer/portable-package-test.ps1 -Root {source_root} -BuildDirectory {output_root}",
  "inputs": [
    "rust/crates/sdk-embedded-prototype/Cargo.toml",
    "rust/crates/sdk-embedded-prototype/Cargo.lock",
    "rust/crates/sdk-embedded-prototype/build.rs",
    "rust/crates/sdk-embedded-prototype/src/lib.rs",
    "cpp/embedded-consumer/CMakeLists.txt",
    "cpp/embedded-consumer/AcyclicEmbeddedConfig.cmake.in",
    "cpp/embedded-consumer/include/acyclic/embedded.hpp",
    "cpp/embedded-consumer/main.cpp",
    "cpp/embedded-consumer/negative_lifetime_smoke.cpp",
    "cpp/embedded-consumer/cross_thread_cancel_smoke.cpp"
  ],
  "isolation": {
    "output_root": "{output_root}",
    "package_root": "{output_root}/prefix",
    "output_must_be_outside_source_root": true,
    "source_is_read_only_during_generation": true,
    "source_files_must_not_be_written": true
  },
  "outputs": {
    "package_format": "portable-cmake-prefix",
    "manifest": "research/acceptance/embedded/release-abi-20261004.json",
    "receipt_schema": "research/acceptance/embedded/release-abi-receipt.schema.json",
    "validator": "research/acceptance/embedded/verify-release-abi-receipt.ps1",
    "artifacts": [
      "include/acyclic_embedded_prototype.h",
      "include/acyclic/embedded.hpp",
      "bin/acyclic_sdk_embedded_prototype.dll",
      "lib/acyclic_sdk_embedded_prototype.dll.lib",
      "lib/cmake/AcyclicEmbedded/AcyclicEmbeddedConfig.cmake",
      "lib/cmake/AcyclicEmbedded/AcyclicEmbeddedConfigVersion.cmake"
    ]
  },
  "consumer_receipts": {
    "rust": "receipt.foreign_consumers.rust_unit_tests",
    "c": "receipt.foreign_consumers.c_consumer",
    "python": "receipt.foreign_consumers.python_ctypes_consumer",
    "cpp": "receipt.foreign_consumers.cpp_cross_thread_consumer",
    "cmake": "receipt.foreign_consumers.cmake_ctest",
    "clean_prefix": "receipt.foreign_consumers.clean_prefix_cpp_consumer",
    "actual_foreign_receipts": "receipt.consumer_receipts"
  },
  "reproducibility": {
    "required_clean_builds": 2,
    "normalize": [
      "PE COFF timestamp",
      "PE debug directory timestamps",
      "CodeView PDB GUID when the PDB is not packaged"
    ],
    "forbid_runtime_semantic_normalization": true,
    "receipt_binding": "receipt.reproducibility"
  },
  "publication": {
    "registry_publish": false,
    "production_deploy": false
  }
}
