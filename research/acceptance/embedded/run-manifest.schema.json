{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.acyclic.dev/schemas/embedded-run-manifest.v1.json",
  "title": "Rust-owned embedded ABI six-platform run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "source_revision", "source_digest", "platform_count", "platforms", "artifact_digest"],
  "properties": {
    "schema": { "const": "acyclic.sdk.embedded.run-manifest.v1" },
    "status": { "const": "qualified" },
    "source_revision": { "$ref": "#/$defs/hex40" },
    "source_digest": { "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "platform_count": { "const": 6 },
    "platforms": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/platform" }
    },
    "artifact_digest": { "pattern": "^sha256:[0-9a-fA-F]{64}$" }
  },
  "$defs": {
    "hex40": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "hex64": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "target", "receipt", "receipt_sha256", "artifact_digest", "source_revision", "source_digest", "consumers"],
      "properties": {
        "platform": { "enum": ["linux-arm64-musl", "linux-x64-musl", "macos-arm64", "macos-x64", "windows-arm64-msvc", "windows-x64-msvc"] },
        "target": { "enum": ["aarch64-unknown-linux-musl", "x86_64-unknown-linux-musl", "aarch64-apple-darwin", "x86_64-apple-darwin", "aarch64-pc-windows-msvc", "x86_64-pc-windows-msvc"] },
        "receipt": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "receipt_sha256": { "$ref": "#/$defs/hex64" },
        "artifact_digest": { "pattern": "^sha256:[0-9a-fA-F]{64}$" },
        "source_revision": { "$ref": "#/$defs/hex40" },
        "source_digest": { "pattern": "^sha256:[0-9a-fA-F]{64}$" },
        "consumers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["c", "python", "cpp"],
          "properties": {
            "c": { "const": "passed" },
            "python": { "const": "passed" },
            "cpp": { "const": "passed" }
          }
        }
      }
    }
  }
}
