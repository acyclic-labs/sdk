{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.acyclic.dev/schemas/embedded-platform-package-receipt.v1.json",
  "title": "Rust-owned embedded platform package receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "target", "source_revision", "source_digest",
    "source_inputs", "runtime", "runtime_artifact", "package_root",
    "artifacts", "consumers", "ctest", "clean_prefix"
  ],
  "properties": {
    "schema": { "const": "acyclic.sdk.embedded.platform-package.v1" },
    "status": { "enum": ["passed", "pending-execution"] },
    "target": { "type": "string", "minLength": 1 },
    "source_revision": { "$ref": "#/$defs/hex40" },
    "source_digest": { "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "source_inputs": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "runtime": { "type": "string", "minLength": 1 },
    "runtime_artifact": { "$ref": "#/$defs/portablePath" },
    "package_root": { "const": "prefix" },
    "artifacts": {
      "type": "object", "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/hex64" }
    },
    "consumers": {
      "type": "object", "additionalProperties": false,
      "required": ["c", "python", "cpp"],
      "properties": {
        "c": { "$ref": "#/$defs/consumer" },
        "python": { "$ref": "#/$defs/consumer" },
        "cpp": { "$ref": "#/$defs/consumer" }
      }
    },
    "ctest": { "enum": ["passed", "compiled-only-cross-target"] },
    "clean_prefix": { "enum": ["passed", "compiled-only-cross-target"] }
  },
  "$defs": {
    "hex40": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "hex64": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "portablePath": {
      "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "consumer": {
      "type": "object", "additionalProperties": false,
      "required": [
        "status", "scope", "invoked", "exit_code", "source_revision",
        "source", "source_sha256", "package_artifact",
        "package_artifact_sha256", "checks"
      ],
      "properties": {
        "status": { "enum": ["passed", "compiled-only-cross-target"] },
        "scope": { "const": "embedded-native-abi" },
        "invoked": { "type": "boolean" },
        "exit_code": { "type": ["integer", "null"] },
        "source_revision": { "$ref": "#/$defs/hex40" },
        "source": { "$ref": "#/$defs/portablePath" },
        "source_sha256": { "$ref": "#/$defs/hex64" },
        "package_artifact": { "$ref": "#/$defs/portablePath" },
        "package_artifact_sha256": { "$ref": "#/$defs/hex64" },
        "checks": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
