{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.acyclic.dev/schemas/embedded-release-abi-receipt.v1.json",
  "title": "Rust-owned embedded release ABI receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "source", "toolchain", "foreign_consumers", "consumer_receipts", "reproducibility", "artifacts", "validation", "publication"],
  "properties": {
    "schema": { "const": "acyclic.sdk.embedded.release-abi.v1" },
    "status": { "const": "qualified-local-release-package" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "crate", "version", "abi_version", "source_digest", "source_inputs", "cargo_lock_sha256"],
      "properties": {
        "revision": { "$ref": "#/$defs/hex40" },
        "crate": { "const": "rust/crates/sdk-embedded-prototype" },
        "version": { "type": "string", "minLength": 1 },
        "abi_version": { "type": "integer", "minimum": 1 },
        "source_digest": { "$ref": "#/$defs/hex64" },
        "source_inputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "cargo_lock_sha256": { "$ref": "#/$defs/hex64" }
      }
    },
    "toolchain": { "type": "object", "additionalProperties": false, "required": ["rust", "cbindgen", "clang", "cmake", "ninja", "offline_locked"], "properties": {
      "rust": { "type": "string", "minLength": 1 }, "cbindgen": { "type": "string", "minLength": 1 }, "clang": { "type": "string", "minLength": 1 }, "cmake": { "type": "string", "minLength": 1 }, "ninja": { "type": "boolean" }, "offline_locked": { "type": "boolean" }
    } },
    "foreign_consumers": {
      "type": "object", "additionalProperties": false,
      "required": ["rust_unit_tests", "c_consumer", "python_ctypes_consumer", "cpp_cross_thread_consumer", "cmake_ctest", "clean_prefix_cpp_consumer"],
      "properties": {
        "rust_unit_tests": { "$ref": "#/$defs/passed" },
        "c_consumer": { "$ref": "#/$defs/passedChecks" },
        "python_ctypes_consumer": { "$ref": "#/$defs/passedChecks" },
        "cpp_cross_thread_consumer": { "$ref": "#/$defs/passedChecks" },
        "cmake_ctest": { "type": "object", "additionalProperties": false, "required": ["status", "passed", "total"], "properties": { "status": { "const": "passed" }, "passed": { "type": "integer", "minimum": 1 }, "total": { "type": "integer", "minimum": 1 } } },
        "clean_prefix_cpp_consumer": { "$ref": "#/$defs/passed" }
      }
    },
    "consumer_receipts": {
      "type": "object", "additionalProperties": false, "required": ["c", "python", "cpp"],
      "properties": {
        "c": { "$ref": "#/$defs/consumerReceipt" },
        "python": { "$ref": "#/$defs/consumerReceipt" },
        "cpp": { "$ref": "#/$defs/consumerReceipt" }
      }
    },
    "reproducibility": {
      "type": "object", "additionalProperties": false,
      "required": ["independent_clean_builds", "source_digests_equal", "artifact_hashes_equal", "pe_coff_timestamp_normalized", "pe_debug_timestamps_normalized", "codeview_pdb_guid_normalized"],
      "properties": {
        "independent_clean_builds": { "const": 2 }, "source_digests_equal": { "const": true }, "artifact_hashes_equal": { "const": true },
        "pe_coff_timestamp_normalized": { "const": 0 }, "pe_debug_timestamps_normalized": { "const": 0 }, "codeview_pdb_guid_normalized": { "const": true }
      }
    },
    "artifacts": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/hex64" } },
    "validation": { "type": "object", "additionalProperties": false, "required": ["normalized_pe", "normalized_consumers", "tampered_artifact_rejected"], "properties": {
      "normalized_pe": { "type": "object", "additionalProperties": false, "required": ["mz", "pe", "export"], "properties": { "mz": { "const": true }, "pe": { "const": true }, "export": { "const": "acyclic_embedded_abi_version" } } },
      "normalized_consumers": { "type": "object", "additionalProperties": false, "required": ["c", "python", "cpp"], "properties": { "c": { "const": "passed" }, "python": { "const": "passed" }, "cpp": { "const": "passed" } } },
      "tampered_artifact_rejected": { "const": true }
    } },
    "publication": { "type": "object", "additionalProperties": false, "required": ["registry_published", "production_deployed", "qualification_scope"], "properties": { "registry_published": { "const": false }, "production_deployed": { "const": false }, "qualification_scope": { "type": "string", "minLength": 1 } } }
  },
  "$defs": {
    "hex40": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "hex64": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "passed": { "type": "object", "required": ["status"], "properties": { "status": { "const": "passed" } } },
    "passedChecks": { "type": "object", "required": ["status", "checks"], "properties": { "status": { "const": "passed" }, "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } }
    ,"consumerReceipt": { "type": "object", "additionalProperties": false, "required": ["status", "scope", "language", "source", "source_revision", "source_sha256", "command", "invoked", "exit_code", "package_artifact", "package_artifact_sha256", "checks"], "properties": { "status": { "const": "passed" }, "scope": { "const": "embedded-native-abi" }, "language": { "type": "string", "minLength": 1 }, "source": { "type": "string", "minLength": 1 }, "source_revision": { "$ref": "#/$defs/hex40" }, "source_sha256": { "$ref": "#/$defs/hex64" }, "command": { "type": "string", "minLength": 1 }, "invoked": { "const": true }, "exit_code": { "const": 0 }, "package_artifact": { "const": "bin/acyclic_sdk_embedded_prototype.dll" }, "package_artifact_sha256": { "$ref": "#/$defs/hex64" }, "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } }
  }
}
