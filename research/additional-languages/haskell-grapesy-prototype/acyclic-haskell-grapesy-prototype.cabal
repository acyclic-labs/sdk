cabal-version:      3.0
name:               acyclic-haskell-grapesy-prototype
version:            0.1.0.0
synopsis:           Generated Haskell proof for the Rust-owned Stream v2 contract
description:        The proto is copied from the Rust source tree only for the pinned prototype run.
license:            BSD-3-Clause
build-type:         Simple

library
  hs-source-dirs:      src, generated
  exposed-modules:     Acyclic.Stream.Api, Proto.Stream.V2.Stream, Proto.Stream.V2.Stream_Fields
  build-depends:
      base >= 4.16 && < 4.17
    , bytestring >= 0.11 && < 0.12
    , grapesy == 1.2.1
    , proto-lens == 0.7.1.7
    , proto-lens-protobuf-types == 0.7.2.3
    , proto-lens-runtime == 0.7.0.8
  default-language: Haskell2010
  default-extensions: DataKinds, FlexibleInstances, MultiParamTypeClasses, OverloadedLabels, OverloadedStrings, TypeApplications, TypeFamilies, TypeSynonymInstances

executable acyclic-haskell-prototype
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
      base >= 4.16 && < 4.17
    , acyclic-haskell-grapesy-prototype
    , bytestring >= 0.11 && < 0.12
    , lens == 5.3.6
    , proto-lens == 0.7.1.7
  default-language: Haskell2010
  default-extensions: OverloadedStrings, TypeApplications
  ghc-options: -Wall
