cabal-version:      3.0
name:               acyclic-haskell-grapesy-prototype
version:            0.1.0.0
synopsis:           Generated Haskell proof for the Rust-owned Stream v2 contract
description:        The proto is copied from the Rust source tree only for the pinned prototype run.
license:            BSD-3-Clause
build-type:         Simple

library
  hs-source-dirs:      src, generated
  exposed-modules:
      Acyclic.Semantics
    , Acyclic.Stream.Api
    , Proto.Actors.V1.Actors
    , Proto.Actors.V1.Actors_Fields
    , Proto.Filesystem.V2.Filesystem
    , Proto.Filesystem.V2.Filesystem_Fields
    , Proto.Harness.V2.Harness
    , Proto.Harness.V2.Harness_Fields
    , Proto.Inference.V1.Inference
    , Proto.Inference.V1.Inference_Fields
    , Proto.Machines.V1.Machines
    , Proto.Machines.V1.Machines_Fields
    , Proto.Objects.V1.Objects
    , Proto.Objects.V1.Objects_Fields
    , Proto.Objects.V2.Objects
    , Proto.Objects.V2.Objects_Fields
    , Proto.Protocol.V1.Protocol
    , Proto.Protocol.V1.Protocol_Fields
    , Proto.Stream.V2.Stream
    , Proto.Stream.V2.Stream_Fields
    , Proto.Validation.V1.Options
    , Proto.Validation.V1.Options_Fields
    , Proto.Workers.V1.Workers
    , Proto.Workers.V1.Workers_Fields
  build-depends:
      base >= 4.16 && < 4.17
    , bytestring >= 0.11 && < 0.12
    , grapesy == 1.2.1
    , proto-lens == 0.7.1.7
    , proto-lens-protobuf-types == 0.7.2.3
    , proto-lens-runtime == 0.7.0.8
  default-language: Haskell2010
  default-extensions: DataKinds, FlexibleInstances, MultiParamTypeClasses, OverloadedLabels, OverloadedStrings, TypeApplications, TypeFamilies, TypeSynonymInstances

executable acyclic-haskell-prototype
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
      base >= 4.16 && < 4.17
    , acyclic-haskell-grapesy-prototype
    , bytestring >= 0.11 && < 0.12
    , lens == 5.3.6
    , proto-lens == 0.7.1.7
  default-language: Haskell2010
  default-extensions: OverloadedStrings, TypeApplications
  ghc-options: -Wall

executable acyclic-haskell-remote
  hs-source-dirs: app
  main-is: RemoteMain.hs
  build-depends:
      base >= 4.16 && < 4.17
    , acyclic-haskell-grapesy-prototype
    , grapesy == 1.2.1
    , proto-lens == 0.7.1.7
  default-language: Haskell2010
  default-extensions: DataKinds, ImportQualifiedPost, OverloadedStrings, TypeApplications, TypeFamilies
  ghc-options: -Wall -threaded

executable acyclic-haskell-full-typed
  hs-source-dirs: app
  main-is: FullTypedMain.hs
  build-depends:
      base >= 4.16 && < 4.17
    , acyclic-haskell-grapesy-prototype
    , proto-lens == 0.7.1.7
  default-language: Haskell2010
  default-extensions: AllowAmbiguousTypes, DataKinds, FlexibleContexts, FlexibleInstances, ImportQualifiedPost, KindSignatures, ScopedTypeVariables, TypeApplications, TypeOperators, UndecidableInstances
  ghc-options: -Wall

executable acyclic-haskell-semantic-types
  hs-source-dirs: app
  main-is: SemanticTypesMain.hs
  build-depends:
      base >= 4.16 && < 4.17
    , acyclic-haskell-grapesy-prototype
    , bytestring >= 0.11 && < 0.12
    , proto-lens == 0.7.1.7
  default-language: Haskell2010
  ghc-options: -Wall

executable acyclic-haskell-canonical-replay
  hs-source-dirs: app
  main-is: CanonicalReplayMain.hs
  build-depends:
      base >= 4.16 && < 4.17
    , acyclic-haskell-grapesy-prototype
    , bytestring >= 0.11 && < 0.12
    , grapesy == 1.2.1
    , proto-lens == 0.7.1.7
  default-language: Haskell2010
  default-extensions: DataKinds, ImportQualifiedPost, OverloadedStrings, ScopedTypeVariables, TypeApplications
  ghc-options: -Wall -threaded

executable acyclic-haskell-wire-semantics
  hs-source-dirs: app
  main-is: WireSemanticsMain.hs
  build-depends:
      base >= 4.16 && < 4.17
    , acyclic-haskell-grapesy-prototype
    , lens == 5.3.6
    , proto-lens == 0.7.1.7
  default-language: Haskell2010
  default-extensions: OverloadedLabels, OverloadedStrings, TypeApplications
  ghc-options: -Wall
