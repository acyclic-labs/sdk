/target/
# Acyclic's runtime state never belongs to a repository.
.acyclic/
/target-*/
/.tools/
node_modules/
/typescript/packages/*/dist/
# WASM is built for the target platform before TypeScript checking or packaging.
/typescript/packages/*/generated/wasm/*
!/typescript/packages/filesystem/generated/wasm/.npmignore
!/typescript/packages/filesystem/generated/wasm/package.json
# Keep the Rust-generated type surface available to clean standalone project
# builds. Runtime WASM/JS remains platform-generated by each package build.
!/typescript/packages/harness/generated/wasm/
!/typescript/packages/harness/generated/wasm/*.d.ts
*.tsbuildinfo
*.log
.DS_Store

# Isolated Rust-source generation prototypes and qualification outputs.
/.tmp-rust-authority/
/build/
/rust/crates/sdk-*/target/
/research/**/node_modules/
/research/**/target/
/python/**/__pycache__/
/python/**/.pytest_cache/
/python/**/build/
/python/**/dist/
/python/**/*.egg-info/
/python/**/.venv/
/jvm/**/target/
/dotnet/**/bin/
/dotnet/**/obj/
/cpp/**/build/
/cpp/**/.build/
/dart/**/.dart_tool/
/swift/**/.build/

# Portable qualification toolchains (downloaded locally, never source artifacts)
/dart/.toolchain/
/dotnet/.toolchain/
/ruby/.toolchain/
/php/.toolchain/
/go/.toolchain/
/jvm/.toolchain/
/cpp/.toolchain/
/swift/.toolchain/
/tmp-current-review-target/
/tmp-worker-model-target/
