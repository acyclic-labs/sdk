/target/
# Acyclic's runtime state never belongs to a repository.
.acyclic/
/target-*/
/.tools/
node_modules/
/typescript/packages/*/dist/
# WASM is built for the target platform before TypeScript checking or packaging.
/typescript/packages/*/generated/wasm/*
!/typescript/packages/filesystem/generated/wasm/.npmignore
!/typescript/packages/filesystem/generated/wasm/package.json
# NAPI native loaders and binaries are rebuilt for the host or release target;
# retain the Rust-owned declarations in generated/native for type checking.
/typescript/packages/actors/generated/native/*.cjs
/typescript/packages/actors/generated/native/*.node
/typescript/packages/actors/npm/
# Keep the Rust-generated type surface available to clean standalone project
# builds. Runtime WASM/JS remains platform-generated by each package build.
!/typescript/packages/harness/generated/wasm/
!/typescript/packages/harness/generated/wasm/*.d.ts
*.tsbuildinfo
*.log
.DS_Store
