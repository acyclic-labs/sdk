/target/
# Acyclic's runtime state never belongs to a repository.
.acyclic/
# Lane output belongs in the external lane root; CI also rejects forced adds.
/scratch/
/scratch-notes/
/lane-logs/
/lane-artifacts/
/study-classes-evidence/
/rev-*-verdict*
/target-*/
/.tools/
node_modules/
/typescript/packages/*/dist/
# WASM is built for the target platform before TypeScript checking or packaging.
*.tsbuildinfo
*.log
.DS_Store
/generated/

# Build-time protobuf, WASM, native and semantic projections.
/typescript/packages/*/generated/*
/typescript/packages/*/src/generated/
/typescript/packages/*/test/generated/
/typescript/packages/auth/src/contract.ts
/typescript/packages/actors/src/routes.ts
/typescript/packages/inference/src/routes.ts
/typescript/packages/machines/src/managed-oci-contract.ts
/typescript/packages/stream/src/http-contract.ts
/typescript/packages/stream/src/token-operations.ts
/typescript/packages/harness/src/child-page-contract.ts
/typescript/packages/harness/src/conversation-page-contract.ts
/typescript/packages/harness/src/private-directory-page-contract.ts
/typescript/packages/harness/src/limits-contract.ts
!/typescript/packages/filesystem/generated/wasm/
/typescript/packages/filesystem/generated/wasm/*
!/typescript/packages/filesystem/generated/wasm/package.json
!/typescript/packages/filesystem/generated/wasm/.npmignore
/rust/crates/*/src/generated/
