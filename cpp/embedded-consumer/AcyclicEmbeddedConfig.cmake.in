@PACKAGE_INIT@

if(NOT TARGET Acyclic::Embedded)
add_library(Acyclic::Embedded SHARED IMPORTED)
set_target_properties(Acyclic::Embedded PROPERTIES
  IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@ACYCLIC_RUNTIME_INSTALL_DIR@/@ACYCLIC_RUNTIME_NAME@"
  INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
if(WIN32)
  set_property(TARGET Acyclic::Embedded APPEND PROPERTY
    IMPORTED_IMPLIB "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@ACYCLIC_IMPORT_NAME@")
endif()
endif()

check_required_components(AcyclicEmbedded)
