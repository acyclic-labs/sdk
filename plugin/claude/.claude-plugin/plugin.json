{
  "name": "acyclic",
  "version": "0.2.0",
  "description": "Coordinate separate native sessions with the shared harness.",
  "author": {
    "name": "Acyclic Labs"
  },
  "license": "Apache-2.0",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/../bin/acyclic\" __hook claude-code SessionStart",
            "timeout": 120,
            "statusMessage": "Acyclic is capturing the native workspace"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/../bin/acyclic\" __hook claude-code Stop",
            "timeout": 120,
            "statusMessage": "Acyclic is capturing the native workspace"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/../bin/acyclic\" __hook claude-code SessionEnd",
            "timeout": 3,
            "statusMessage": "Acyclic is capturing the native workspace"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "mcp__plugin_acyclic_acyclic-sessions__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/../bin/acyclic\" __hook claude-code PermissionRequest",
            "timeout": 120,
            "statusMessage": "Acyclic is asking the harness approval policy"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "acyclic-sessions": {
      "command": "${CLAUDE_PLUGIN_ROOT}/../bin/acyclic",
      "args": [
        "__mcp",
        "claude-code"
      ]
    }
  }
}
