{
  "description": "Native events are immutable request files handled by the harness actor.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/acyclic\" __hook codex SessionStart",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\bin\\acyclic.exe\" __hook codex SessionStart",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/acyclic\" __hook codex PreToolUse",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\bin\\acyclic.exe\" __hook codex PreToolUse",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/acyclic\" __hook codex PostToolUse",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\bin\\acyclic.exe\" __hook codex PostToolUse",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/acyclic\" __hook codex SubagentStart",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\bin\\acyclic.exe\" __hook codex SubagentStart",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/acyclic\" __hook codex SubagentStop",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\bin\\acyclic.exe\" __hook codex SubagentStop",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/acyclic\" __hook codex SessionEnd",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\bin\\acyclic.exe\" __hook codex SessionEnd",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
