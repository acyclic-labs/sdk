{
  "description": "Maps Codex lifecycle and filesystem tools onto Acyclic workspace contexts.",
  "hooks": {
    "SessionStart": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/bin/acyclic.js\" __hook codex SessionStart",
        "timeout": 120,
        "statusMessage": "Acyclic is attaching the workspace"
      }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/bin/acyclic.js\" __hook codex UserPromptSubmit",
        "timeout": 30
      }]
    }],
    "PreToolUse": [{
      "matcher": ".*",
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/bin/acyclic.js\" __hook codex PreToolUse",
        "timeout": 120,
        "statusMessage": "Acyclic is routing the workspace"
      }]
    }],
    "PostToolUse": [{
      "matcher": ".*",
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/bin/acyclic.js\" __hook codex PostToolUse",
        "timeout": 120
      }]
    }],
    "SubagentStart": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/bin/acyclic.js\" __hook codex SubagentStart",
        "timeout": 120,
        "statusMessage": "Acyclic is forking the subagent workspace"
      }]
    }],
    "SubagentStop": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/bin/acyclic.js\" __hook codex SubagentStop",
        "timeout": 120
      }]
    }],
    "SessionEnd": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/bin/acyclic.js\" __hook codex SessionEnd",
        "timeout": 3
      }]
    }]
  }
}
