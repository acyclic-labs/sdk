{
  "mcpServers": {
    "acyclic-sessions": {
      "type": "stdio",
      "command": "./bin/acyclic",
      "args": [
        "__mcp",
        "codex"
      ],
      "cwd": ".",
      "env_vars": [
        "CODEX_HOME",
        "ACYCLIC_HOST_ARGS",
        "ACYCLIC_WORKSPACE",
        "ACYCLIC_TASK"
      ],
      "required": true
    }
  }
}
