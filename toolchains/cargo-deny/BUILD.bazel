load(":deny_test.bzl", "advisory_index")
load("@rules_rust//rust:defs.bzl", "rust_test")

advisory_index(name = "advisory_db")

rust_test(
    name = "offline_test",
    srcs = ["audit.rs"],
    data = [":advisory_db", "//:cargo-bazel-lock.json"],
    env = {
        "ADVISORY_INDEX": "$(rootpath :advisory_db)",
        "CRATE_LOCK": "$(rootpath //:cargo-bazel-lock.json)",
    },
    deps = ["@sdk_crates//semver-1.0.28", "@sdk_crates//serde_json-1.0.154"],
)
