load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen_toolchain")
load("//:wasm_cc_toolchain.bzl", "wasm_cc_toolchain")

wasm_cc_toolchain()

rust_wasm_bindgen_toolchain(
    name = "sdk_wasm_bindgen_toolchain_impl",
    wasm_bindgen_cli = "@wasm_bindgen//:wasm_bindgen_cli",
)

toolchain(
    name = "sdk_wasm_bindgen_toolchain",
    # @wasm_bindgen is the host's own release archive.
    exec_compatible_with = HOST_CONSTRAINTS,
    toolchain = ":sdk_wasm_bindgen_toolchain_impl",
    toolchain_type = "@rules_rust_wasm_bindgen//:toolchain_type",
)
