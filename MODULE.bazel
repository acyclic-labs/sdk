module(name = "acyclic_sdk")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "rules_rust_wasm_bindgen", version = "0.75.0")
bazel_dep(name = "toolchains_llvm", version = "1.13.0")
bazel_dep(name = "toolchains_musl", version = "0.2.0")

# rules_rust 0.75.0 from acyclic-labs/rules_rust, whose commits on the release:
# - a transitive module's crate lockfile labels resolve in that module's repository;
# - rust_check_aspect type-checks crates to metadata, as cargo check does;
# - the clippy_driver patch below runs the Rust compile action through clippy-driver, so lints are part of
#   compilation and no separate clippy aspect type-checks the same tree again;
# - build scripts see the toolchain's extra rustc flags in CARGO_ENCODED_RUSTFLAGS and CARGO_CFG_*, as
#   Cargo's do with RUSTFLAGS, so cc-rs compiles C for the static CRT a crt-static target links.
git_override(
    module_name = "rules_rust",
    remote = "https://github.com/acyclic-labs/rules_rust.git",
    commit = "4f0293883980add60314edace130d285b89f5941",
    patches = ["//:rules_rust-clippy-driver.patch"],
    patch_strip = 1,
)

# The C/C++ toolchains are this module's own build setup, so each is a dev dependency: a module that
# depends on this one registers its own, and needs no patch to drop these.

# Pinned C/C++ toolchain for build scripts, -sys crates and linking.
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
LLVM_VERSION = "22.1.8"
llvm.toolchain(llvm_version = LLVM_VERSION)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

# Browser modules need the same compiler when this SDK is a dependency too.
# Its distinct repository name keeps a consumer's native toolchain independent.
wasm_llvm = use_repo_rule("@toolchains_llvm//toolchain:rules.bzl", "llvm")
wasm_llvm(name = "wasm_llvm_distribution", llvm_versions = {"": LLVM_VERSION})
register_toolchains("//toolchains/browser:wasm_cc_toolchain", "//toolchains/browser:sdk_wasm_bindgen_toolchain")

# The musl C/C++ toolchain: musl's headers, CRT and libc for the //:linux_musl platform's build
# scripts, -sys crates and static links. It is registered first, because the LLVM toolchain matches
# every Linux x86_64 platform and would otherwise compile and link musl targets against glibc.
toolchains_musl = use_extension("@toolchains_musl//:toolchains_musl.bzl", "toolchains_musl", dev_dependency = True)
toolchains_musl.config(extra_target_compatible_with = ["//:libc_musl"])
use_repo(toolchains_musl, "musl_toolchains_hub")

register_toolchains("@musl_toolchains_hub//:all", dev_dependency = True)

register_toolchains("@llvm_toolchain//:all", dev_dependency = True)

# The Node.js runtime tests start, from the official release for the host platform. It is this
# module's own test setup, so a module that depends on this one fetches no Node.js.
node = use_extension("//:node_repo.bzl", "node", dev_dependency = True)
node.node(version = "24.22.2")
use_repo(node, "nodejs")

bun = use_extension("//:bun_repo.bzl", "bun", dev_dependency = True)
use_repo(bun, "bunjs")

# Standalone production proofs use the verifier's own pinned compiler.
kani = use_extension("//toolchains/kani:repositories.bzl", "kani", dev_dependency = True)
use_repo(kani, "kani")

# The Rust toolchain, rustc flags and crate universe, generated from the Cargo configuration.
include("//:cargo.MODULE.bazel")

# Artifact conformance executes the published Cargo and Rustdoc producers.
sdk_compilers = use_extension("//toolchains/sdk:repositories.bzl", "sdk_compilers", dev_dependency = True)
use_repo(sdk_compilers, "sdk_compilers")
wasm_bindgen_cli = use_repo_rule("//:wasm_bindgen.bzl", "wasm_bindgen_cli")
wasm_bindgen_cli(name = "wasm_bindgen")
