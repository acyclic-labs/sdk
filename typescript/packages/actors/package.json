{
  "name": "@acyclic-labs/actors",
  "version": "0.2.0",
  "private": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "Apache-2.0",
  "description": "Rust-owned Actors v1 contract and native/browser client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acyclic-labs/sdk.git",
    "directory": "typescript/packages/actors"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./proto": {
      "types": "./generated/proto/actors/v1/actors_pb.d.ts",
      "default": "./generated/proto/actors/v1/actors_pb.js"
    },
    "./client": {
      "default": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "generated/proto",
    "generated/native",
    "generated/wasm",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun run generate:client && bun run build:wasm && tsc -b",
    "build:wasm": "bun ../../../scripts/build-wasm.mjs actors",
    "generate:client": "node ../../../scripts/generate-actors.mjs write",
    "build:native": "node ../../../scripts/build-actors-native.mjs build",
    "stage:native": "node ../../../scripts/build-actors-native.mjs stage",
    "check:native": "node ../../../scripts/build-actors-native.mjs check",
    "assemble:native": "node ../../../scripts/assemble-actors-native-package.mjs",
    "test": "tsc -b --pretty false",
    "pack:dry": "bun pm pack --dry-run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0"
  },
  "optionalDependencies": {
    "@acyclic-labs/actors-darwin-arm64": "0.2.0",
    "@acyclic-labs/actors-linux-x64-gnu": "0.2.0",
    "@acyclic-labs/actors-win32-x64-msvc": "0.2.0"
  },
  "napi": {
    "binaryName": "index",
    "packageName": "@acyclic-labs/actors"
  },
  "devDependencies": {
    "@connectrpc/connect": "2.1.1",
    "@connectrpc/connect-node": "2.1.1",
    "typescript": "7.0.2",
    "@types/node": "26.6.4"
  }
}
