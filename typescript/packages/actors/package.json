{
  "name": "@acyclic-labs/actors",
  "version": "0.2.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Generated Actors v1 contracts and authenticated HTTP client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acyclic-labs/sdk.git",
    "directory": "typescript/packages/actors"
  },
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "node": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./proto": {
      "types": "./generated/proto/actors/v1/actors_pb.d.ts",
      "default": "./generated/proto/actors/v1/actors_pb.js"
    },
    "./grpc": {
      "default": "./dist/grpc.js",
      "types": "./dist/grpc.d.ts"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    },
    "./wasm": {
      "types": "./generated/wasm/acyclic_actors_wasm.d.ts",
      "default": "./generated/wasm/acyclic_actors_wasm.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "generated",
    "CHANGELOG.md"
  ],
  "napi": {
    "binaryName": "index",
    "packageName": "@acyclic-labs/actors"
  },
  "scripts": {
    "build:wasm": "bun ../../../scripts/build-actors-wasm.mjs ./generated/wasm",
    "stage:rust-types": "node ../../../scripts/stage-rust-actors-types.mjs",
    "build": "bun run build:wasm && tsc -b",
    "test": "bun run build:wasm && tsc -b --pretty false",
    "prepack": "npm run build",
    "pack:dry": "bun pm pack --dry-run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.1.1",
    "@connectrpc/connect-node": "2.1.1"
  },
  "optionalDependencies": {
    "@acyclic-labs/actors-darwin-arm64": "0.2.0",
    "@acyclic-labs/actors-darwin-x64": "0.2.0",
    "@acyclic-labs/actors-linux-arm64-gnu": "0.2.0",
    "@acyclic-labs/actors-linux-arm64-musl": "0.2.0",
    "@acyclic-labs/actors-linux-x64-gnu": "0.2.0",
    "@acyclic-labs/actors-linux-x64-musl": "0.2.0",
    "@acyclic-labs/actors-win32-arm64-msvc": "0.2.0",
    "@acyclic-labs/actors-win32-x64-msvc": "0.2.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.4.1"
  }
}
