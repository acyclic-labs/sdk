{
  "name": "@acyclic-labs/actors",
  "version": "0.2.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Rust-owned Actors v1 contract and native/browser client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acyclic-labs/sdk.git",
    "directory": "typescript/packages/actors"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./proto": {
      "types": "./generated/proto/actors/v1/actors_pb.d.ts",
      "default": "./generated/proto/actors/v1/actors_pb.js"
    },
    "./client": {
      "default": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "generated/proto",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun run build:wasm && tsc -b",
    "build:wasm": "bun ../../../scripts/build-wasm.mjs actors",
    "test": "tsc -b --pretty false",
    "pack:dry": "bun pm pack --dry-run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.4.1"
  }
}
