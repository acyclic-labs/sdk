{
  "name": "@acyclic-labs/sdk",
  "version": "0.2.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Umbrella TypeScript SDK for Acyclic runtime and infrastructure services",
  "keywords": [
    "sdk",
    "agents",
    "infrastructure"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acyclic-labs/sdk.git",
    "directory": "typescript/packages/sdk"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun run generate && bun run build:wasm && tsc -b",
    "test": "bun run generate && bun run build:wasm && tsc -b --pretty false",
    "pack:dry": "bun pm pack --dry-run",
    "generate": "bun ../../../scripts/generate.mjs sdk",
    "build:wasm": "bun ../../../scripts/build-wasm.mjs sdk",
    "prepack": "bun run generate"
  },
  "dependencies": {
    "@acyclic-labs/harness": "0.2.0",
    "@acyclic-labs/fs": "0.2.0",
    "@acyclic-labs/stream": "0.2.0",
    "@acyclic-labs/objects": "0.2.0",
    "@acyclic-labs/machines": "0.2.0",
    "@acyclic-labs/inference": "0.2.0",
    "@acyclic-labs/actors": "0.2.0",
    "@acyclic-labs/workers": "0.2.0"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "typescript": "7.0.2"
  }
}
