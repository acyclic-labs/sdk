{
  "name": "@acyclic-labs/auth",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Shared Acyclic capability chain contract",
  "license": "Apache-2.0",
  "exports": {
    "./grpc-refusal": {
      "types": "./dist/grpc-refusal.d.ts",
      "bun": "./src/grpc-refusal.ts",
      "default": "./dist/grpc-refusal.js"
    },
    "./refusal": {
      "types": "./dist/refusal.d.ts",
      "bun": "./src/refusal.ts",
      "default": "./dist/refusal.js"
    },
    "./credential-connect": {
      "types": "./dist/credential-connect.d.ts",
      "bun": "./src/credential-connect.ts",
      "default": "./dist/credential-connect.js"
    },
    "./credential": {
      "types": "./dist/credential.d.ts",
      "bun": "./src/credential.ts",
      "default": "./dist/credential.js"
    },
    "./addressing": {
      "types": "./dist/addressing.d.ts",
      "bun": "./src/addressing.ts",
      "default": "./dist/addressing.js"
    },
    "./owned-bytes": {
      "types": "./dist/owned-bytes.d.ts",
      "bun": "./src/owned-bytes.ts",
      "default": "./dist/owned-bytes.js"
    },
    ".": {
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./holder": {
      "types": "./dist/holder.d.ts",
      "bun": "./src/holder.ts",
      "default": "./dist/holder.js"
    },
    "./proto": {
      "types": "./generated/proto/auth/v1/auth_pb.d.ts",
      "default": "./generated/proto/auth/v1/auth_pb.js"
    },
    "./guest-admission": {
      "types": "./dist/guest-admission.d.ts",
      "bun": "./src/guest-admission.ts",
      "default": "./dist/guest-admission.js"
    },
    "./conformance": "./generated/conformance/secrets-v1.json"
  },
  "files": [
    "dist",
    "generated",
    "src"
  ],
  "dependencies": {
    "@acyclic-labs/core": "0.2.0",
    "@connectrpc/connect": "2.3.0",
    "@bufbuild/protobuf": "2.17.0"
  },
  "scripts": {
    "build": "bun run generate && bun run build:wasm && tsc -b",
    "build:wasm": "bun ../../../scripts/build-wasm.mjs auth",
    "generate": "bun ../../../scripts/generate.mjs auth",
    "test": "bun run generate",
    "prepack": "bun run generate"
  }
}
