# The deployable harness Actor artifact. The proto target projects the protobuf schemas the
# TypeScript packages import; the bundle target consumes the generated wasm packages and runs
# tsc and the Bun bundle over the owner configuration.
genrule(
    name = "proto",
    srcs = ["//:tools/generate-proto.mjs"],
    outs = ["proto.sh"],
    cmd = "printf '#!/usr/bin/env bash\\nset -euo pipefail\\nexec bun \"$$BUILD_WORKSPACE_DIRECTORY/tools/generate-proto.mjs\" \"$$@\"\\n' > $@ && chmod +x $@",
    executable = True,
)

genrule(
    name = "bundle",
    srcs = ["//:tools/harness-actor-bundle.mjs"],
    tools = [
        ":proto",
        "//rust/crates/harness-providers:acyclic_harness_wasm",
        "//rust/crates/manifest:acyclic_manifest_wasm",
        "//:wasm_auth_generated",
        "//:wasm_actors_generated",
        "//:wasm_filesystem_generated",
        "//:wasm_stream_generated",
        "//:wasm_objects_generated",
        "//:wasm_machines_generated",
        "//:wasm_inference_generated",
    ],
    outs = ["bundle.sh"],
    cmd = "printf '#!/usr/bin/env bash\\nset -euo pipefail\\nhere=\"$$(cd \"$$(dirname \"$$0\")\" && pwd)\"\\nexecroot=\"$${here%%/bazel-out/*}\"\\ncd \"$$execroot\"\\nexec bun \"$$BUILD_WORKSPACE_DIRECTORY/tools/harness-actor-bundle.mjs\" --proto \"$(location :proto)\" --wasm \"$(location //rust/crates/harness-providers:acyclic_harness_wasm)=typescript/packages/harness/generated/wasm\" --wasm \"$(location //rust/crates/manifest:acyclic_manifest_wasm)=typescript/packages/workers/generated/wasm\" --wasm \"$(location //:wasm_auth_generated)=typescript/packages/auth/generated/wasm\" --wasm \"$(location //:wasm_actors_generated)=typescript/packages/actors/generated/wasm\" --wasm \"$(location //:wasm_filesystem_generated)=typescript/packages/filesystem/generated/wasm\" --wasm \"$(location //:wasm_stream_generated)=typescript/packages/stream/generated/wasm\" --wasm \"$(location //:wasm_objects_generated)=typescript/packages/objects/generated/wasm\" --wasm \"$(location //:wasm_machines_generated)=typescript/packages/machines/generated/wasm\" --wasm \"$(location //:wasm_inference_generated)=typescript/packages/inference/generated/wasm\" \"$$@\"\\n' > $@ && chmod +x $@",
    executable = True,
)
