{
  "name": "@acyclic-labs/harness",
  "version": "0.2.0",
  "description": "Generic durable substrate and fully composable agent runtime",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acyclic-labs/sdk.git",
    "directory": "typescript/packages/harness"
  },
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "generated",
    "CHANGELOG.md"
  ],
  "exports": {
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "default": "./dist/svelte.js"
    },
    "./worker": {
      "types": "./dist/client-worker.d.ts",
      "default": "./dist/client-worker.js"
    },
    "./hosting": {
      "types": "./dist/event-host.d.ts",
      "default": "./dist/event-host.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    }
  },
  "scripts": {
    "build:wasm": "bun ../../../scripts/build-wasm.mjs harness",
    "build": "bun run generate && bun run build:wasm && bun x tsc -b tsconfig.json",
    "check": "bun run generate && bun run build:wasm && bun x tsc -b tsconfig.json --pretty false",
    "check:types": "bun x tsc -p tsconfig.type-tests.json",
    "test": "bun run generate && bun run build && node ../../../scripts/generate-proto.mjs && bash ../../../scripts/build-host-fixture.sh && bun test test",
    "test:browser:mcp": "node test/mcp-http-fixture.mjs",
    "test:client:browser": "bun test/client-framework-browser.mjs",
    "generate": "bun ../../../scripts/generate.mjs harness",
    "prepack": "bun run generate"
  },
  "dependencies": {
    "@acyclic-labs/machines": "0.2.0",
    "@acyclic-labs/objects": "0.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-types": "1.4.4",
    "fake-indexeddb": "6.2.6",
    "react-dom": "19.3.1",
    "svelte": "5.57.2",
    "typescript": "7.0.2",
    "react": "19.3.1",
    "@bufbuild/protobuf": "2.16.0"
  }
}
