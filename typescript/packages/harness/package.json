{
  "name": "@acyclic-labs/harness",
  "version": "0.1.5",
  "description": "Generic durable substrate and fully composable agent runtime",
  "repository": { "type": "git", "url": "git+https://github.com/acyclic-labs/sdk.git", "directory": "typescript/packages/harness" },
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "generated", "CHANGELOG.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./proto": { "types": "./generated/proto/harness/v2/harness_pb.d.ts", "default": "./generated/proto/harness/v2/harness_pb.js" }
  },
  "scripts": {
    "build:wasm": "bun ../../../scripts/build-harness-wasm.mjs",
    "build": "bun run build:wasm && bun x tsc -p tsconfig.json",
    "check": "bun x tsc -p tsconfig.json --noEmit",
    "check:types": "bun x tsc -p tsconfig.type-tests.json",
    "test": "bun run build && bun test test"
  },
  "dependencies": { "@bufbuild/protobuf": "2.14.1" },
  "devDependencies": { "@types/bun": "1.4.0", "bun-types": "1.4.0", "fake-indexeddb": "6.2.4", "typescript": "7.0.2" }
}
