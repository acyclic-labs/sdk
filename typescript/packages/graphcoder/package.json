{
  "name": "@acyclic-labs/graphcoder",
  "version": "0.2.0",
  "description": "Thin transport-neutral local GraphCoder session and terminal interface",
  "keywords": ["agents", "graphcoder", "terminal", "workflows"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acyclic-labs/sdk.git",
    "directory": "typescript/packages/graphcoder"
  },
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "bin": {
    "graphcoder": "dist/cli.js",
    "graphcoder-native": "dist/native-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./terminal": {
      "types": "./dist/terminal.d.ts",
      "default": "./dist/terminal.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "default": "./dist/mock.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "default": "./dist/bridge.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./node-dispatcher": {
      "types": "./dist/node-dispatcher.d.ts",
      "default": "./dist/node-dispatcher.js"
    },
    "./native-cli": {
      "types": "./dist/native-cli.d.ts",
      "default": "./dist/native-cli.js"
    }
  },
  "scripts": {
    "build": "bun x tsc -p tsconfig.json --composite false --incremental false",
    "check": "bun x tsc -p tsconfig.json --noEmit",
    "test": "bun test test"
  },
  "dependencies": {
    "@acyclic-labs/fs": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "bun-types": "1.4.0",
    "typescript": "7.0.2"
  }
}
