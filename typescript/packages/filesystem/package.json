{
  "name": "@acyclic-labs/fs",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "description": "Versioned workspaces for browser, memory, hosted, and native providers",
  "keywords": ["filesystem", "storage", "workspaces"],
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acyclic-labs/sdk.git",
    "directory": "typescript/packages/filesystem"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/browser.d.ts",
  "files": ["dist", "generated", "examples", "CHANGELOG.md"],
  "exports": {
    ".": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "node": "./dist/memory-node.js",
      "default": "./dist/memory.js"
    },
    "./hosted": {
      "types": "./dist/hosted.d.ts",
      "default": "./dist/hosted.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    },
    "./proto": {
      "types": "./generated/proto/filesystem/v2/filesystem_pb.d.ts",
      "default": "./generated/proto/filesystem/v2/filesystem_pb.js"
    }
  },
  "scripts": {
    "build:proto": "cd ../../.. && bun x buf format --diff --exit-code --path proto/filesystem/v2 && bun x buf lint && bun run generate",
    "clean": "bun -e \"import { rmSync } from 'node:fs'; for (const path of ['dist', 'tsconfig.tsbuildinfo']) rmSync(path, { recursive: true, force: true })\"",
    "build": "bun run build:wasm && bun x tsc -p tsconfig.json",
    "build:clean": "bun run clean && bun run build",
    "build:wasm": "bun ../../../scripts/build-wasm.mjs filesystem",
    "build:native": "node ../../../scripts/build-filesystem-native.mjs build",
    "stage:native": "node ../../../scripts/build-filesystem-native.mjs stage",
    "check:native": "node ../../../scripts/build-filesystem-native.mjs check",
    "assemble:native": "node ../../../scripts/assemble-filesystem-native-package.mjs",
    "check": "bun run build:wasm && bun x tsc -p tsconfig.json --noEmit",
    "check:types": "bun x tsc -p tsconfig.type-tests.json --pretty false",
    "test": "bun run build && bun run test:composition && bun run test:s3",
    "test:composition": "bun test/node-memory.mjs",
    "test:native:installed": "node test/native-public-installed.mjs",
    "test:s3": "bun test test/hosted-s3.test.mjs",
    "test:browser": "bun test/browser-qualify.mjs",
    "pack:dry": "bun run build:clean && bun pm pack --dry-run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.1.1",
    "@connectrpc/connect-web": "2.1.1"
  },
  "optionalDependencies": {
    "@acyclic-labs/fs-darwin-arm64": "0.2.0",
    "@acyclic-labs/fs-darwin-x64": "0.2.0",
    "@acyclic-labs/fs-linux-arm64-gnu": "0.2.0",
    "@acyclic-labs/fs-linux-x64-gnu": "0.2.0",
    "@acyclic-labs/fs-win32-arm64-msvc": "0.2.0",
    "@acyclic-labs/fs-win32-x64-msvc": "0.2.0"
  },
  "napi": {
    "binaryName": "acyclic-fs-0.2.0",
    "packageName": "@acyclic-labs/fs"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2"
  }
}
