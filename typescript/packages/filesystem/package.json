{
  "name": "@acyclic-labs/fs",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "description": "Versioned workspaces for browser, memory, hosted, and native providers",
  "keywords": [
    "filesystem",
    "storage",
    "workspaces"
  ],
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acyclic-labs/sdk.git",
    "directory": "typescript/packages/filesystem"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "generated",
    "examples",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "node": "./dist/memory-node.js",
      "default": "./dist/memory.js"
    },
    "./hosted": {
      "types": "./dist/hosted.d.ts",
      "default": "./dist/hosted.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    },
    "./proto": {
      "types": "./generated/proto/filesystem/v2/filesystem_pb.d.ts",
      "default": "./generated/proto/filesystem/v2/filesystem_pb.js"
    },
    "./grpc": {
      "types": "./dist/grpc.d.ts",
      "default": "./dist/grpc.js"
    }
  },
  "scripts": {
    "build:proto": "cd ../../.. && bun x buf format --diff --exit-code --path rust/crates/filesystem/proto/filesystem/v2 && bun x buf lint && bun scripts/generate.mjs filesystem",
    "clean": "bun -e \"import { rmSync } from 'node:fs'; for (const path of ['dist', 'tsconfig.tsbuildinfo']) rmSync(path, { recursive: true, force: true })\"",
    "build": "bun run generate && bun run build:wasm && bun x tsc -b tsconfig.json",
    "build:clean": "bun run clean && bun run build",
    "build:wasm": "bun ../../../scripts/build-wasm.mjs filesystem",
    "check": "bun run generate && bun run build:wasm && bun x tsc -b tsconfig.json --pretty false",
    "check:types": "bun x tsc -p tsconfig.type-tests.json --pretty false",
    "test": "bun run generate && bun run build && bun run test:composition && bun run test:s3",
    "test:composition": "bun test/node-memory.mjs",
    "test:native:installed": "node test/native-public-installed.mjs",
    "test:native:mount": "node test/native-mount-installed.mjs",
    "test:s3": "bun test test/hosted-s3.test.mjs",
    "test:browser": "bun test/browser-qualify.mjs",
    "pack:dry": "bun run build:clean && bun pm pack --dry-run",
    "test:cloud": "node --test test/cloud-contract.test.mjs",
    "generate": "bun ../../../scripts/generate.mjs filesystem",
    "prepack": "bun run generate"
  },
  "dependencies": {
    "@acyclic-labs/actors": "0.2.0",
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@connectrpc/connect-node": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
