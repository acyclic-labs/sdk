{
  "name": "@acyclic-labs/objects",
  "version": "0.1.5",
  "private": false,
  "license": "Apache-2.0",
  "description": "Immutable object versions, buckets, snapshots, and typed provider adapters",
  "keywords": [
    "objects",
    "storage",
    "versioning"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acyclic-labs/sdk.git",
    "directory": "typescript/packages/objects"
  },
  "type": "module",
  "exports": {
    "./v2": {
      "types": "./dist/v2.d.ts",
      "default": "./dist/v2.js"
    },
    "./v2/proto": {
      "types": "./generated/proto/objects/v2/objects_pb.d.ts",
      "default": "./generated/proto/objects/v2/objects_pb.js"
    },
    "./v2/http": {
      "types": "./dist/v2-http.d.ts",
      "default": "./dist/v2-http.js"
    },
    "./v2/grpc": {
      "types": "./dist/v2-grpc.d.ts",
      "default": "./dist/v2-grpc.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./proto": {
      "types": "./generated/proto/objects/v1/objects_pb.d.ts",
      "default": "./generated/proto/objects/v1/objects_pb.js"
    },
    "./grpc": {
      "default": "./dist/grpc.js",
      "types": "./dist/grpc.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "generated",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun run build:wasm && tsc -b",
    "build:wasm": "bun ../../../scripts/build-objects-wasm.mjs",
    "test": "bun run build && bun test test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.1.1",
    "@connectrpc/connect-node": "2.1.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.4.1",
    "typescript": "7.0.2"
  }
}
