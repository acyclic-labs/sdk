{
  "name": "@acyclic-labs/objects",
  "version": "0.2.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Logical Objects v2 with memory, HTTP, and Node/Bun gRPC providers",
  "keywords": [
    "objects",
    "storage",
    "buckets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acyclic-labs/sdk.git",
    "directory": "typescript/packages/objects"
  },
  "type": "module",
  "exports": {
    "./v2": {
      "types": "./dist/v2.d.ts",
      "default": "./dist/v2.js"
    },
    "./v2/proto": {
      "types": "./generated/proto/objects/v2/objects_pb.d.ts",
      "default": "./generated/proto/objects/v2/objects_pb.js"
    },
    "./v2/http": {
      "types": "./dist/v2-http.d.ts",
      "default": "./dist/v2-http.js"
    },
    "./v2/grpc": {
      "types": "./dist/v2-grpc.d.ts",
      "default": "./dist/v2-grpc.js"
    },
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "node": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./proto": {
      "types": "./generated/proto/objects/v2/objects_pb.d.ts",
      "default": "./generated/proto/objects/v2/objects_pb.js"
    },
    "./http": { "types": "./dist/v2-http.d.ts", "default": "./dist/v2-http.js" },
    "./grpc": {
      "default": "./dist/v2-grpc.js",
      "types": "./dist/v2-grpc.d.ts"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "default": "./dist/platform.js"
    },
    "./wasm": {
      "types": "./dist/wasm-runtime.d.ts",
      "default": "./dist/wasm-runtime.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "generated",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun run build:wasm && tsc -b",
    "build:wasm": "bun ../../../scripts/build-objects-wasm.mjs",
    "test": "bun run build && bun test test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.1.1",
    "@connectrpc/connect-node": "2.1.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.4.1",
    "typescript": "7.0.2"
  }
}
