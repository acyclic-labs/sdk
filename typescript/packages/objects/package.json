{
  "name": "@acyclic-labs/objects",
  "version": "0.2.0-rc.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Current-value replaceable Objects API with opaque identities and typed provider adapters",
  "keywords": ["objects", "storage", "cas"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acyclic-labs/sdk.git",
    "directory": "typescript/packages/objects"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./proto": {
      "types": "./generated/proto/objects/v1/objects_pb.d.ts",
      "default": "./generated/proto/objects/v1/objects_pb.js"
    },
    "./proto/v2": {
      "types": "./generated/proto/objects/v2/objects_pb.d.ts",
      "default": "./generated/proto/objects/v2/objects_pb.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "generated", "CHANGELOG.md"],
  "scripts": {
    "build": "bun run build:wasm && tsc -b",
    "build:wasm": "bun scripts/build-wasm.mjs",
    "test": "bun run build && bun test test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.1",
    "@noble/hashes": "2.0.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  }
}
