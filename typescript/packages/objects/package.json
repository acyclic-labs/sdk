{
  "name": "@acyclic-labs/objects",
  "version": "0.2.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Logical Objects v1 with memory, HTTP, and Node/Bun gRPC providers",
  "keywords": [
    "objects",
    "storage",
    "buckets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acyclic-labs/sdk.git",
    "directory": "typescript/packages/objects"
  },
  "type": "module",
  "exports": {
    "./v1": {
      "types": "./dist/v1.d.ts",
      "default": "./dist/v1.js"
    },
    "./v1/proto": {
      "types": "./generated/proto/objects/v1/objects_pb.d.ts",
      "default": "./generated/proto/objects/v1/objects_pb.js"
    },
    "./v1/http": {
      "types": "./dist/v1-http.d.ts",
      "default": "./dist/v1-http.js"
    },
    "./v1/grpc": {
      "types": "./dist/v1-grpc.d.ts",
      "default": "./dist/v1-grpc.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./proto": {
      "types": "./generated/proto/objects/v1/objects_pb.d.ts",
      "default": "./generated/proto/objects/v1/objects_pb.js"
    },
    "./http": { "types": "./dist/v1-http.d.ts", "default": "./dist/v1-http.js" },
    "./grpc": {
      "default": "./dist/v1-grpc.js",
      "types": "./dist/v1-grpc.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "generated",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun run build:wasm && tsc -b",
    "build:wasm": "bun ../../../scripts/build-wasm.mjs objects",
    "test": "bun run build && bun test test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-node": "2.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
