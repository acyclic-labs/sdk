{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeploymentManifest",
  "description": "Versioned deployment document; project and account identity come from the deploy call.",
  "type": "object",
  "properties": {
    "environments": {
      "description": "Independent DNS-label-named deployment environments.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Environment"
      }
    },
    "schemaVersion": {
      "description": "Schema discriminator, exactly one.",
      "type": "integer",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environments"
  ],
  "$defs": {
    "ActorLimits": {
      "type": "object",
      "properties": {
        "checkpointBytes": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "handlerTimeoutMillis": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "memoryBytes": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            {
              "type": "integer"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "AssetCache": {
      "description": "Browser cache behavior for content-addressed asset paths.",
      "oneOf": [
        {
          "description": "Cache the immutable bundle path without revalidation.",
          "type": "string",
          "const": "immutable"
        },
        {
          "description": "Require revalidation for browser responses.",
          "type": "string",
          "const": "revalidate"
        }
      ]
    },
    "AssetSpec": {
      "description": "Immutable asset bundle served through a selected Objects binding.",
      "type": "object",
      "properties": {
        "binding": {
          "description": "Selected environment binding name.",
          "type": "string"
        },
        "bundleSha256": {
          "description": "Immutable Objects keys are assets/<bundleSha256>/<path>.",
          "type": "string"
        },
        "cache": {
          "description": "Explicit cache policy for bundle responses.",
          "$ref": "#/$defs/AssetCache"
        },
        "entry": {
          "description": "Target entry name in this environment.",
          "type": "string"
        },
        "spaFallback": {
          "description": "Serve the bundle index for missing asset paths when enabled.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "entry",
        "binding",
        "bundleSha256",
        "spaFallback",
        "cache"
      ]
    },
    "Binding": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "BindingGrant": {
      "description": "Named S1 grant and optional ceilings used to derive a workload capability.",
      "type": "object",
      "properties": {
        "grant": {
          "description": "Authority using the shared auth.v1 resource and action contract.",
          "$ref": "#/$defs/ResourceGrant"
        },
        "limits": {
          "description": "Product-specific execution or capability ceilings.",
          "anyOf": [
            {
              "$ref": "#/$defs/Limits"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "description": "Declaration name; environment names are DNS labels, env properties are identifiers.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "grant"
      ]
    },
    "CronSpec": {
      "description": "UTC numeric five-field cron; restricted day-of-month and weekday use OR.",
      "type": "object",
      "properties": {
        "entry": {
          "description": "Target entry name in this environment.",
          "type": "string"
        },
        "inbox": {
          "description": "Exact streams:/ resource; the target must subscribe to this stream.",
          "$ref": "#/$defs/ResourcePattern"
        },
        "inboxBinding": {
          "description": "Selected Streams binding authorizing append to this inbox.",
          "type": "string"
        },
        "name": {
          "description": "Declaration name; environment names are DNS labels, env properties are identifiers.",
          "type": "string"
        },
        "schedule": {
          "description": "Five numeric UTC cron fields, with lists, ranges and positive steps.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "schedule",
        "entry",
        "inboxBinding",
        "inbox"
      ]
    },
    "EgressRule": {
      "description": "Exact canonical DNS authority, resolved and pinned by the host before use.",
      "type": "object",
      "properties": {
        "host": {
          "description": "Lowercase canonical ASCII DNS name, excluding numeric IP forms.",
          "type": "string"
        },
        "port": {
          "description": "The host always uses TLS with certificate validation, on this port.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "host",
        "port"
      ]
    },
    "Entry": {
      "description": "Content-addressed guest entry with explicitly selected environment handles.",
      "type": "object",
      "properties": {
        "artifactSha256": {
          "description": "Nonzero lowercase SHA-256 of the immutable code artifact.",
          "type": "string"
        },
        "bindings": {
          "description": "Explicitly selected binding names.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fetch": {
          "description": "Optional scoped HTTPS handle; absence denies outbound HTTPS.",
          "anyOf": [
            {
              "$ref": "#/$defs/FetchBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "module": {
          "description": "Logical artifact module identifier, never a filesystem path.",
          "type": "string"
        },
        "name": {
          "description": "Declaration name; environment names are DNS labels, env properties are identifiers.",
          "type": "string"
        },
        "runtime": {
          "description": "Actor instance or stateless Worker configuration.",
          "$ref": "#/$defs/EntryRuntime"
        },
        "secrets": {
          "description": "Credential-store references available only through explicit selection.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "artifactSha256",
        "module",
        "bindings",
        "secrets",
        "runtime"
      ]
    },
    "EntryRuntime": {
      "description": "Product configuration lowered to the corresponding platform request.",
      "oneOf": [
        {
          "description": "One actor instance per project/environment/entry deploy identity.",
          "type": "object",
          "properties": {
            "homeRegion": {
              "description": "Explicit initial placement region.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "actor"
            },
            "limits": {
              "description": "Product-specific execution or capability ceilings.",
              "$ref": "#/$defs/ActorLimits"
            },
            "subscriptions": {
              "description": "Canonical Actors subscription specs, including starts and placement anchors.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/SubscriptionSpec"
              }
            },
            "timerInbox": {
              "description": "Optional durable alarm destination; enabling timers requires its wake subscription.",
              "anyOf": [
                {
                  "$ref": "#/$defs/TimerInbox"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "homeRegion",
            "limits",
            "subscriptions"
          ]
        },
        {
          "description": "Stateless Worker with explicit request ceilings.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "worker"
            },
            "limits": {
              "description": "Product-specific execution or capability ceilings.",
              "$ref": "#/$defs/WorkerLimits"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "limits"
          ]
        }
      ]
    },
    "Environment": {
      "description": "Complete isolated configuration; no environment overlays or implicit selections.",
      "type": "object",
      "properties": {
        "assets": {
          "description": "Content-addressed asset bundle declarations.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetSpec"
          }
        },
        "bindings": {
          "description": "The Actors contract binding, with capability naming a typed grant below.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Binding"
          }
        },
        "crons": {
          "description": "UTC schedules delivering idempotent records to subscribed inboxes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CronSpec"
          }
        },
        "entries": {
          "description": "Artifact entries available for deployment.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entry"
          }
        },
        "grants": {
          "description": "Named typed workload grants; account spend entitlements remain host-owned.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/BindingGrant"
          }
        },
        "name": {
          "description": "Declaration name; environment names are DNS labels, env properties are identifiers.",
          "type": "string"
        },
        "routes": {
          "description": "Customer routes; host/prefix pairs are unique across all environments.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RouteSpec"
          }
        },
        "secrets": {
          "description": "Credential-store references available only through explicit selection.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SecretRef"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "entries",
        "bindings",
        "grants",
        "secrets",
        "crons",
        "assets",
        "routes"
      ]
    },
    "FetchBinding": {
      "description": "One entry-owned HTTPS handle and its complete destination allow-list.",
      "type": "object",
      "properties": {
        "egress": {
          "description": "Complete allow-list; an empty list is rejected.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EgressRule"
          }
        },
        "name": {
          "description": "Declaration name; environment names are DNS labels, env properties are identifiers.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "egress"
      ]
    },
    "Limits": {
      "type": "object",
      "properties": {
        "burst": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "bytes": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "bytesPerS": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "channels": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "concurrency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "rps": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "spendMicros": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            {
              "type": "integer"
            }
          ]
        },
        "tokens": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            {
              "type": "integer"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ResourceGrant": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resource": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "prefix": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ResourcePattern": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "prefix": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "RouteSpec": {
      "description": "Customer route with canonical segment-boundary prefix matching.",
      "type": "object",
      "properties": {
        "entry": {
          "description": "Target entry name in this environment.",
          "type": "string"
        },
        "host": {
          "description": "Lowercase canonical ASCII DNS name, excluding numeric IP forms.",
          "type": "string"
        },
        "pathPrefix": {
          "description": "Canonical absolute prefix; segment-boundary matching, no trailing slash except /.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "host",
        "pathPrefix",
        "entry"
      ]
    },
    "SecretRef": {
      "description": "Typed credential-store reference, resolved by the host outside the manifest.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Declaration name; environment names are DNS labels, env properties are identifiers.",
          "type": "string"
        },
        "reference": {
          "description": "Only secrets:/ followed by nonempty ASCII identifier path segments.",
          "$ref": "#/$defs/SecretReference"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "reference"
      ]
    },
    "SecretReference": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^secrets:/[A-Za-z0-9_-]{1,63}(/[A-Za-z0-9_-]{1,63})*$"
    },
    "SubscriptionSpec": {
      "type": "object",
      "properties": {
        "placementAnchor": {
          "type": "boolean"
        },
        "start": {
          "type": "object",
          "properties": {
            "currentHead": {
              "type": "boolean"
            },
            "cursor": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+$"
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "streamPath": {
          "type": "string"
        },
        "subscriptionId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "TimerInbox": {
      "description": "Durable alarm destination, admitted only with a matching wake subscription.",
      "type": "object",
      "properties": {
        "binding": {
          "description": "Selected environment binding name.",
          "type": "string"
        },
        "stream": {
          "description": "Exact canonical Streams resource for durable fires.",
          "$ref": "#/$defs/ResourcePattern"
        }
      },
      "additionalProperties": false,
      "required": [
        "binding",
        "stream"
      ]
    },
    "WorkerLimits": {
      "description": "Positive stateless Worker CPU, memory and wall-clock ceilings.",
      "type": "object",
      "properties": {
        "cpuMillis": {
          "description": "Positive CPU milliseconds per request.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "memoryBytes": {
          "description": "Positive memory ceiling in bytes.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "timeoutMillis": {
          "description": "Positive wall-clock milliseconds per request.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "cpuMillis",
        "memoryBytes",
        "timeoutMillis"
      ]
    }
  }
}
