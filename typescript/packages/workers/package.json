{
  "name": "@acyclic-labs/workers",
  "version": "0.2.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Cloud Worker deployment through Objects and Actors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acyclic-labs/sdk.git",
    "directory": "typescript/packages/workers"
  },
  "type": "module",
  "exports": {
    "./manifest.schema.json": "./src/generated/manifest.schema.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./manifest.wasm": "./generated/wasm/acyclic_manifest_bg.wasm"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/generated/manifest.schema.json",
    "CHANGELOG.md",
    "generated/wasm"
  ],
  "scripts": {
    "build": "bun run generate && bun run --cwd ../actors build && bun run --cwd ../objects build && bun run build:wasm && tsc -b",
    "test": "bun run generate && bun run build:wasm && tsc -b --pretty false",
    "pack:dry": "bun pm pack --dry-run",
    "test:cloud": "bun run generate && bun run build:wasm && tsc -b && tsc -p tsconfig.type-tests.json --pretty false && node --test test/cloud-contract.test.mjs",
    "check:types": "tsc -p tsconfig.type-tests.json --pretty false",
    "build:wasm": "bun ../../../scripts/build-wasm.mjs manifest",
    "test:manifest": "bun run build:wasm && node --test test/manifest-wasm.test.mjs",
    "generate": "bun ../../../scripts/generate.mjs workers",
    "prepack": "bun run generate"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@acyclic-labs/actors": "0.2.0",
    "@acyclic-labs/objects": "0.2.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.4"
  }
}
