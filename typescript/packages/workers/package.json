{
  "name": "@acyclic-labs/workers",
  "version": "0.2.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Rust-owned Workers contracts and unified native/browser client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acyclic-labs/sdk.git",
    "directory": "typescript/packages/workers"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./proto": {
      "types": "./generated/proto/workers/v1/workers_pb.d.ts",
      "default": "./generated/proto/workers/v1/workers_pb.js"
    },
    "./grpc": {
      "default": "./dist/grpc.js",
      "types": "./dist/grpc.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "generated/proto",
    "CHANGELOG.md",
    "generated/native",
    "generated/wasm"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -b --pretty false",
    "pack:dry": "bun pm pack --dry-run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.4"
  },
  "napi": {
    "binaryName": "index",
    "packageName": "@acyclic-labs/workers"
  }
}
