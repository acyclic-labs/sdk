{
  "name": "@acyclic-labs/workers",
  "version": "0.2.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Cloud Worker deployment through Objects and Actors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acyclic-labs/sdk.git",
    "directory": "typescript/packages/workers"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -b --pretty false",
    "pack:dry": "bun pm pack --dry-run",
