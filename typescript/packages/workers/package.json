    "check:types": "tsc -p tsconfig.type-tests.json --pretty false"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@acyclic-labs/actors": "0.2.0",
    "@acyclic-labs/objects": "0.2.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.4.1"
  }
}
