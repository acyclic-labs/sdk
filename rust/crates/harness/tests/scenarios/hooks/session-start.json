{
 "home": {
  ".claude/settings.json": {
   "hooks": {
    "SessionStart": [
     {
      "matcher": "",
      "hooks": [
       {
        "type": "command",
        "shell": "sh",
        "command": "cat >/dev/null; printf '%s' 'HOOK-SESSION-LYNX'"
       }
      ]
     }
    ]
   }
  }
 },
 "expect": {
  "results": {
   "call": {
    "name": "shell",
    "content": {"kind":"parts","parts":[{"kind":"text","text":"Exit code: 0\nvisible"}]}
   }
  },
  "requests": [
   {
    "messages": [
     {
      "$contains": "HOOK-SESSION-LYNX"
     }
    ]
   },
   {
    "messages": [
     {
      "$contains": "HOOK-SESSION-LYNX"
     }
    ]
   }
  ]
 },
 "platforms": {
  "windows": {
   "home": {
    ".claude/settings.json": {
     "hooks": {
      "SessionStart": [
       {
        "matcher": "",
        "hooks": [
         {
          "type": "command",
          "shell": "powershell",
          "command": "$null=[Console]::In.ReadToEnd(); [Console]::Write('HOOK-SESSION-LYNX')"
         }
        ]
       }
      ]
     }
    }
   },
   "expect": {
    "results": {
     "call": {
      "name": "shell"
     }
    }
   }
  }
 }
}
