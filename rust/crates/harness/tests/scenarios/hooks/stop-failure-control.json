{
 "home": {
  ".claude/settings.json": {
   "hooks": {
    "Stop": [
     {
      "hooks": [
       {
        "type": "command",
        "shell": "sh",
        "onFailure": "block",
        "command": "cat >/dev/null; printf HOOK-STOP-FAILED >&2; exit 1"
       }
      ]
     }
    ]
   }
  }
 },
 "expect": {
  "not_requests": [
   {
    "$contains": "HOOK-STOP-FAILED"
   }
  ],
  "results": {
   "call": {
    "name": "shell",
    "content": {"kind":"parts","parts":[{"kind":"text","text":"Exit code: 0\nvisible"}]}
   }
  }
 },
 "platforms": {
  "windows": {
   "home": {
    ".claude/settings.json": {
     "hooks": {
      "Stop": [
       {
        "hooks": [
         {
          "type": "command",
          "shell": "powershell",
          "onFailure": "block",
          "command": "$null=[Console]::In.ReadToEnd(); [Console]::Error.Write('HOOK-STOP-FAILED'); exit 1"
         }
        ]
       }
      ]
     }
    }
   },
   "expect": {
    "results": {
     "call": {
      "name": "shell"
     }
    }
   }
  }
 }
}
