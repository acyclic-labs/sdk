{
 "home": {
  ".claude/settings.json": {
   "hooks": {
    "PreToolUse": [
     {
      "matcher": "Edit",
      "hooks": [
       {
        "type": "command",
        "shell": "sh",
        "command": "printf '%s' '{\"decision\":\"block\",\"reason\":\"HOOK-WRONG-TOOL\"}'"
       }
      ]
     }
    ],
    "PostToolUse": [
     {
      "matcher": "Read",
      "hooks": [
       {
        "type": "command",
        "shell": "sh",
        "command": "printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"HOOK-WRONG-TOOL\"}}'"
       }
      ]
     }
    ]
   }
  }
 },
 "expect": {
  "results": {
   "call": {
    "name": "bash",
    "content": {
     "kind": "json",
     "value": {
      "success": true,
      "exit_code": 0,
      "stdout": "visible",
      "stderr": "",
      "stop": null
     }
    }
   }
  },
  "not_requests": [
   {
    "$contains": "HOOK-WRONG-TOOL"
   }
  ]
 }
,
 "platforms":{
  "windows": {
    "home": {
      ".claude/settings.json": {
        "hooks": {
          "PreToolUse": [
            {
              "matcher": "Edit",
              "hooks": [
                {
                  "type": "command",
                  "shell": "powershell",
                  "command": "$null=[Console]::In.ReadToEnd(); [Console]::Write('{\"decision\":\"block\",\"reason\":\"HOOK-WRONG-TOOL\"}')"
                }
              ]
            }
          ],
          "PostToolUse": [
            {
              "matcher": "Read",
              "hooks": [
                {
                  "type": "command",
                  "shell": "powershell",
                  "command": "$null=[Console]::In.ReadToEnd(); [Console]::Write('{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"HOOK-WRONG-TOOL\"}}')"
                }
              ]
            }
          ]
        }
      }
    },
    "expect": {
      "results": {
        "call": {
          "name": "powershell"
        }
      }
    }
  }
}}
