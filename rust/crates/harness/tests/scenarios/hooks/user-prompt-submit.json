{
 "home": {
  ".claude/settings.json": {
   "hooks": {
    "UserPromptSubmit": [
     {
      "hooks": [
       {
        "type": "command",
        "shell": "sh",
        "command": "grep -q '\"prompt\":\"Use the stock bash tool.\"' && printf HOOK-PROMPT-WREN"
       }
      ]
     }
    ]
   }
  }
 },
 "expect": {
  "results": {
   "call": {
    "name": "bash",
    "content": {
     "kind": "json",
     "value": {
      "success": true,
      "exit_code": 0,
      "stdout": "visible",
      "stderr": "",
      "stop": null
     }
    }
   }
  },
  "requests": [
   {
    "messages": [
     {
      "$contains": "HOOK-PROMPT-WREN"
     }
    ]
   },
   {
    "messages": [
     {
      "$contains": "HOOK-PROMPT-WREN"
     }
    ]
   }
  ]
 }
,
 "platforms":{
  "windows": {
    "home": {
      ".claude/settings.json": {
        "hooks": {
          "UserPromptSubmit": [
            {
              "hooks": [
                {
                  "type": "command",
                  "shell": "powershell",
                  "command": "$inputObject=[Console]::In.ReadToEnd() | ConvertFrom-Json; if ($inputObject.prompt -eq 'Use the stock bash tool.') { [Console]::Write('HOOK-PROMPT-WREN') } else { exit 1 }"
                }
              ]
            }
          ]
        }
      }
    },
    "expect": {
      "results": {
        "call": {
          "name": "powershell"
        }
      }
    }
  }
}}
