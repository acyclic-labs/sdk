{
 "driver": "local",
 "prompt": "Use the stock shell tool.",
 "seed": {
  "plans/a.md": "before\n"
 },
 "turns": [
  [
   {
    "type": "event",
    "kind": "tool_call",
    "call_id": "call",
    "name": "shell",
    "arguments": {
     "command": "printf changed > plans/a.md; printf visible"
    }
   },
   {
    "type": "event",
    "kind": "completed",
    "metadata": null
   }
  ],
  "done"
 ],
 "expect": {
  "text": "done",
  "diffs": null,
  "files": {
   "plans/a.md": "changed"
  }
 },
 "platforms": {
  "windows": {
   "turns": [
    [
     {
      "type": "event",
      "kind": "tool_call",
      "call_id": "call",
      "name": "shell",
      "arguments": {
       "command": "[IO.File]::WriteAllText('plans/a.md', 'changed', [Text.UTF8Encoding]::new($false)); [Console]::Write('visible')"
      }
     },
     {
      "type": "event",
      "kind": "completed",
      "metadata": null
     }
    ],
    "done"
   ]
  }
 }
}
