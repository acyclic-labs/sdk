{
 "home": {
  ".claude/settings.json": {
   "hooks": {
    "PreToolUse": [
     {
      "matcher": "Bash",
      "hooks": [
       {
        "type": "command",
        "shell": "sh",
        "command": "cat >/dev/null; printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"updatedInput\":{\"command\":\"printf hooked > plans/a.md; printf replaced\"}}}'"
       }
      ]
     }
    ]
   }
  }
 },
 "expect": {
  "files": {
   "plans/a.md": "hooked"
  },
  "arguments": {
   "call": {
    "command": "printf hooked > plans/a.md; printf replaced"
   }
  },
  "results": {
   "call": {
    "name": "bash",
    "content": {
     "kind": "json",
     "value": {
      "success": true,
      "exit_code": 0,
      "stdout": "replaced",
      "stderr": "",
      "stop": null
     }
    }
   }
  }
 }
,
 "platforms":{
  "windows": {
    "home": {
      ".claude/settings.json": {
        "hooks": {
          "PreToolUse": [
            {
              "matcher": "PowerShell",
              "hooks": [
                {
                  "type": "command",
                  "shell": "powershell",
                  "command": "$null=[Console]::In.ReadToEnd(); [Console]::Write('{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"updatedInput\":{\"command\":\"[IO.File]::WriteAllText(''plans/a.md'', ''hooked'', [Text.UTF8Encoding]::new($false)); [Console]::Write(''replaced'')\"}}}')"
                }
              ]
            }
          ]
        }
      }
    },
    "expect": {
      "arguments": {
        "call": {
          "command": "[IO.File]::WriteAllText('plans/a.md', 'hooked', [Text.UTF8Encoding]::new($false)); [Console]::Write('replaced')"
        }
      },
      "results": {
        "call": {
          "name": "powershell"
        }
      }
    }
  }
}}
