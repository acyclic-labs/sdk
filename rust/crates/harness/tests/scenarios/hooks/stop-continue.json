{
 "home": {
  ".claude/settings.json": {
   "hooks": {
    "Stop": [
     {
      "hooks": [
       {
        "type": "command",
        "shell": "sh",
        "command": "input=$(cat); case \"$input\" in *'\"stop_hook_active\":true'*) exit 0;; esac; printf '%s' '{\"decision\":\"block\",\"reason\":\"HOOK-STOP-FINCH\"}'"
       }
      ]
     }
    ]
   }
  }
 },
 "turns": [
  [
   {
    "type": "event",
    "kind": "tool_call",
    "call_id": "call",
    "name": "shell",
    "arguments": {
     "command": "printf changed > plans/a.md; printf visible"
    }
   },
   {
    "type": "event",
    "kind": "completed",
    "metadata": null
   }
  ],
  "done",
  "finished"
 ],
 "expect": {
  "text": "finished",
  "requests": [
   {
    "messages": [
     {
      "content": {
       "kind": "file",
       "file": {
        "display_name": "prompt"
       }
      }
     }
    ]
   },
   {
    "messages": [
     {
      "$contains": "visible"
     }
    ]
   },
   {
    "messages": [
     {
      "$contains": "done"
     },
     {
      "$contains": "HOOK-STOP-FINCH"
     }
    ]
   }
  ],
  "results": {
   "call": {
    "name": "shell",
    "content": {
     "kind": "json",
     "value": {
      "success": true,
      "exit_code": 0,
      "stdout": "visible",
      "stderr": "",
      "stop": null
     }
    }
   }
  }
 },
 "platforms": {
  "windows": {
   "home": {
    ".claude/settings.json": {
     "hooks": {
      "Stop": [
       {
        "hooks": [
         {
          "type": "command",
          "shell": "powershell",
          "command": "$inputObject=[Console]::In.ReadToEnd() | ConvertFrom-Json; if (!$inputObject.stop_hook_active) { [Console]::Write('{\"decision\":\"block\",\"reason\":\"HOOK-STOP-FINCH\"}') }"
         }
        ]
       }
      ]
     }
    }
   },
   "turns": [
    [
     {
      "type": "event",
      "kind": "tool_call",
      "call_id": "call",
      "name": "shell",
      "arguments": {
       "command": "[IO.File]::WriteAllText('plans/a.md', 'changed', [Text.UTF8Encoding]::new($false)); [Console]::Write('visible')"
      }
     },
     {
      "type": "event",
      "kind": "completed",
      "metadata": null
     }
    ],
    "done",
    "finished"
   ],
   "expect": {
    "results": {
     "call": {
      "name": "shell"
     }
    }
   }
  }
 }
}
