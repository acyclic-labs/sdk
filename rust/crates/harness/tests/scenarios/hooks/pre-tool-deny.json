{
 "home": {
  ".claude/settings.json": {
   "hooks": {
    "PreToolUse": [
     {
      "matcher": "shell",
      "hooks": [
       {
        "type": "command",
        "shell": "sh",
        "command": "cat >/dev/null; printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"HOOK-DENY-OTTER\"}}'"
       }
      ]
     }
    ]
   }
  }
 },
 "expect": {
  "files": {
   "plans/a.md": "before\n"
  },
  "results": {
   "call": {
    "name": "shell",
    "content": {
     "kind": "error",
     "message": {
      "$contains": "HOOK-DENY-OTTER"
     }
    }
   }
  },
  "requests": [
   {
    "messages": [
     {
      "content": {
       "kind": "file",
       "file": {
        "display_name": "prompt"
       }
      }
     }
    ]
   },
   {
    "messages": [
     {
      "$contains": "HOOK-DENY-OTTER"
     }
    ]
   }
  ]
 },
 "platforms": {
  "windows": {
   "home": {
    ".claude/settings.json": {
     "hooks": {
      "PreToolUse": [
       {
        "matcher": "shell",
        "hooks": [
         {
          "type": "command",
          "shell": "powershell",
          "command": "$null=[Console]::In.ReadToEnd(); [Console]::Write('{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"HOOK-DENY-OTTER\"}}')"
         }
        ]
       }
      ]
     }
    }
   },
   "expect": {
    "results": {
     "call": {
      "name": "shell"
     }
    }
   }
  }
 }
}
