{
 "home": {
  ".claude/settings.json": {
   "hooks": {
    "PreToolUse": [
     {
      "matcher": "Bash",
      "hooks": [
       {
        "type": "command",
        "shell": "sh",
        "command": "cat >/dev/null; printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"HOOK-DENY-OTTER\"}}'"
       }
      ]
     }
    ]
   }
  }
 },
 "expect": {
  "wire": [],
  "files": {
   "plans/a.md": "before\n"
  },
  "results": {
   "call": {
    "name": "bash",
    "content": {
     "kind": "error",
     "message": {
      "$contains": "HOOK-DENY-OTTER"
     }
    }
   }
  },
  "requests": [
   {
    "messages": [
     {
      "$contains": "Use the stock bash tool."
     }
    ]
   },
   {
    "messages": [
     {
      "$contains": "HOOK-DENY-OTTER"
     }
    ]
   }
  ]
 }
,
 "platforms":{
  "windows": {
    "home": {
      ".claude/settings.json": {
        "hooks": {
          "PreToolUse": [
            {
              "matcher": "PowerShell",
              "hooks": [
                {
                  "type": "command",
                  "shell": "powershell",
                  "command": "$null=[Console]::In.ReadToEnd(); [Console]::Write('{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"HOOK-DENY-OTTER\"}}')"
                }
              ]
            }
          ]
        }
      }
    },
    "expect": {
      "results": {
        "call": {
          "name": "powershell"
        }
      }
    }
  }
}}
