        "outcome": {
          "Succeeded": {
            "text": "first answer"
          }
        }
      },
      "agents/second/results/1.json": {
        "outcome": {
          "Succeeded": {
            "text": "second answer"
          }
        }
      }
    },
    "model_requests": {
      "parent": [
        {},
        {},
        {},
        {
          "messages": [
            {
              "role": "tool",
              "content": {
                "kind": "tool_result",
                "call_id": "wait-both",
                "name": "wait",
                "content": {
                  "kind": "json",
                  "value": {
                    "agents": [
                      {
                        "reference": "first",
                        "result": {
                          "file": {
                            "path": ".volumes/agents/first/results/1.json"
                          },
                          "outcome": {
