                            }
                          }
                        }
                      },
                      {
                        "reference": "second",
                        "result": {
                          "file": {
                            "path": ".volumes/agents/second/results/1.json"
                          },
                          "outcome": {
                            "Succeeded": {
                              "text": "second answer"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
