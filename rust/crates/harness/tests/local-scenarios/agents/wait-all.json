{
  "driver": "agents",
  "prompt": "Wait for both delegated answers",
  "models": {
    "parent": [
      [
        {
          "type": "event",
          "kind": "tool_call",
          "call_id": "spawn-first",
          "name": "spawn",
          "arguments": {
            "task": "Answer first",
            "name": "first"
          }
        },
        {
          "type": "event",
          "kind": "completed",
          "metadata": null
        }
      ],
      [
        {
          "type": "event",
          "kind": "tool_call",
          "call_id": "spawn-second",
          "name": "spawn",
          "arguments": {
            "task": "Answer second",
            "name": "second"
          }
        },
        {
          "type": "event",
          "kind": "completed",
          "metadata": null
        }
      ],
      [
        {
          "type": "event",
          "kind": "tool_call",
          "call_id": "wait-both",
          "name": "wait",
          "arguments": {
            "agents": [
              "first",
              "second"
            ],
            "mode": "all"
          }
        },
        {
          "type": "event",
          "kind": "completed",
          "metadata": null
        }
      ],
      "parent finished"
    ],
    "first": [
      "first answer"
    ],
    "second": [
      "second answer"
    ]
  },
  "routes": {
    "Answer first": "first",
    "Answer second": "second"
  },
  "expect": {
