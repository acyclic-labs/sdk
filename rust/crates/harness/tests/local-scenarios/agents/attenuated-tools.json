{
  "driver": "agents",
  "prompt": "Delegate with read-only tools",
  "models": {
    "parent": [
      [
        {
          "type": "event",
          "kind": "tool_call",
          "call_id": "spawn",
          "name": "spawn",
          "arguments": {
            "task": "Answer with attenuated tools",
            "name": "reader",
            "grants": [
              "model:generate",
              "mail:read",
              "tool:call:read",
              "tool:call:send",
              "tool:call:wait",
              "tool:call:archive"
            ]
          }
        },
        {
          "type": "event",
          "kind": "completed",
          "metadata": null
        }
      ],
      [
        {
          "type": "event",
          "kind": "tool_call",
          "call_id": "wait",
          "name": "wait",
          "arguments": {
            "agents": [
              "reader"
            ]
          }
        },
        {
          "type": "event",
          "kind": "completed",
          "metadata": null
        }
      ],
      "parent finished"
    ],
    "reader": [
      "reader finished"
    ]
  },
  "routes": {
    "Answer with attenuated tools": "reader"
  },
  "expect": {
    "text": "parent finished",
