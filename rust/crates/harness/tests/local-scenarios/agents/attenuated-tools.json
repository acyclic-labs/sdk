          "Succeeded": {
            "text": "reader finished"
          }
        }
      }
    },
    "toolsets": {
      "parent": [
        "bash",
        "fs",
        "read",
        "write",
        "edit",
        "spawn",
        "send",
        "wait",
        "archive"
      ],
      "reader": [
        "read"
      ]
    }
  }
,
 "platforms":{
