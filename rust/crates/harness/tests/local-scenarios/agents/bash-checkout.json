        ],
        [
          {
            "type": "event",
            "kind": "tool_call",
            "call_id": "side",
            "name": "fs",
            "arguments": {
              "command": "checkout -b side"
            }
          },
          {
            "type": "event",
            "kind": "completed",
            "metadata": null
          }
        ],
        [
          {
            "type": "event",
            "kind": "tool_call",
            "call_id": "side-shell",
            "name": "powershell",
            "arguments": {
              "command": "& ([scriptblock]::Create((Get-Content -Raw checkout-side-shell.ps1)))"
            }
          },
          {
            "type": "event",
            "kind": "completed",
            "metadata": null
          }
        ],
        [
          {
            "type": "event",
            "kind": "tool_call",
            "call_id": "main",
            "name": "fs",
            "arguments": {
              "command": "checkout main"
            }
          },
          {
            "type": "event",
            "kind": "completed",
            "metadata": null
          }
        ],
        [
          {
            "type": "event",
            "kind": "tool_call",
            "call_id": "main-shell",
            "name": "powershell",
            "arguments": {
              "command": "& ([scriptblock]::Create((Get-Content -Raw checkout-main-shell.ps1)))"
            }
          },
          {
            "type": "event",
            "kind": "completed",
            "metadata": null
          }
        ],
        "child finished"
      ]
    },
    "expect": {
      "model_requests": {
        "worker": [
          {},
          {
            "messages": [
              {
                "role": "tool",
                "content": {
                  "kind": "tool_result",
                  "call_id": "child-shell",
                  "name": "powershell",
                  "content": {
                    "kind": "json",
                    "value": {
                      "success": true,
                      "stdout": "child-shell-ok"
                    }
                  }
                }
              }
            ]
          },
          {},
          {
            "messages": [
              {
                "role": "tool",
                "content": {
                  "kind": "tool_result",
                  "call_id": "side-shell",
                  "name": "powershell",
                  "content": {
                    "kind": "json",
                    "value": {
                      "success": true,
                      "stdout": "side-result"
                    }
                  }
                }
              }
            ]
          },
          {},
          {
            "messages": [
              {
                "role": "tool",
                "content": {
                  "kind": "tool_result",
                  "call_id": "main-shell",
                  "name": "powershell",
                  "content": {
                    "kind": "json",
                    "value": {
                      "success": true,
                      "stdout": "shell-result"
                    }
                  }
                }
              }
            ]
          }
        ]
      },
      "files": {
        "checkout-child-shell.ps1": "if (Test-Path -LiteralPath .volumes/scratch/parent-secret) { exit 1 }; [IO.File]::WriteAllText('.volumes/scratch/parent-secret', 'child-private', [Text.UTF8Encoding]::new($false)); [IO.File]::WriteAllText('child.txt', 'shell-result', [Text.UTF8Encoding]::new($false)); [Console]::Write('child-shell-ok')",
        "checkout-side-shell.ps1": "[IO.File]::WriteAllText('side.txt', 'side-result', [Text.UTF8Encoding]::new($false)); [Console]::Write([IO.File]::ReadAllText('side.txt'))",
        "checkout-main-shell.ps1": "if (Test-Path -LiteralPath side.txt) { exit 1 }; [Console]::Write([IO.File]::ReadAllText('child.txt'))"
      }
    },
    "seed": {
      "checkout-child-shell.ps1": "if (Test-Path -LiteralPath .volumes/scratch/parent-secret) { exit 1 }; [IO.File]::WriteAllText('.volumes/scratch/parent-secret', 'child-private', [Text.UTF8Encoding]::new($false)); [IO.File]::WriteAllText('child.txt', 'shell-result', [Text.UTF8Encoding]::new($false)); [Console]::Write('child-shell-ok')",
      "checkout-side-shell.ps1": "[IO.File]::WriteAllText('side.txt', 'side-result', [Text.UTF8Encoding]::new($false)); [Console]::Write([IO.File]::ReadAllText('side.txt'))",
      "checkout-main-shell.ps1": "if (Test-Path -LiteralPath side.txt) { exit 1 }; [Console]::Write([IO.File]::ReadAllText('child.txt'))"
    }
  }
}
}
