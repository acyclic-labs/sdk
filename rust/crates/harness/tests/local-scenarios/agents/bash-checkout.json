              "command": "[IO.File]::WriteAllText('.volumes/scratch/parent-secret', 'parent-private', [Text.UTF8Encoding]::new($false))"
            }
          },
          {
            "type": "event",
            "kind": "completed",
            "metadata": null
          }
        ],
        [
          {
            "type": "event",
            "kind": "tool_call",
            "call_id": "spawn",
            "name": "spawn",
            "arguments": {
              "task": "run shell in the prepared fork",
              "name": "worker"
            }
          },
          {
            "type": "event",
            "kind": "completed",
            "metadata": null
          }
        ],
        [
          {
            "type": "event",
            "kind": "tool_call",
            "call_id": "wait",
