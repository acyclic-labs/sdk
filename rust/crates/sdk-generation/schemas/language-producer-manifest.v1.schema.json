{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.acyclic.dev/schemas/language-producer-manifest.v1.json",
  "title": "Acyclic Rust-bound language producer manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target",
    "source_revision",
    "source_digest",
    "rust_model_digest",
    "files",
    "artifact_digest"
  ],
  "properties": {
    "schema": {
      "const": "acyclic.sdk.language-producer-manifest.v1"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "source_digest": {
      "$ref": "#/$defs/sha256"
    },
    "rust_model_digest": {
      "$ref": "#/$defs/modelDigest"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "artifact_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "modelDigest": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
