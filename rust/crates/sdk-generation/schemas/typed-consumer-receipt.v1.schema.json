{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.acyclic.dev/schemas/typed-consumer-receipt.v1.json",
  "title": "Acyclic Rust-bound generated typed-consumer receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target",
    "source_revision",
    "source_digest",
    "rust_model_digest",
    "generated_consumer",
    "command",
    "assertions"
  ],
  "properties": {
    "schema": {
      "const": "acyclic.sdk.typed-consumer-receipt.v1"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "source_digest": {
      "$ref": "#/$defs/modelDigest"
    },
    "rust_model_digest": {
      "$ref": "#/$defs/modelDigest"
    },
    "generated_consumer": {
      "$ref": "#/$defs/boundFile"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed",
        "exit_code",
        "argv",
        "source_revision",
        "source_digest",
        "stdout_path",
        "stdout_sha256",
        "stderr_path",
        "stderr_sha256",
        "tool_path",
        "tool_sha256",
        "tool_version"
      ],
      "properties": {
        "executed": {
          "const": true
        },
        "exit_code": {
          "const": 0
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "source_digest": {
          "$ref": "#/$defs/modelDigest"
        },
        "stdout_path": {
          "$ref": "#/$defs/relativePath"
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderr_path": {
          "$ref": "#/$defs/relativePath"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tool_path": {
          "type": "string",
          "minLength": 1
        },
        "tool_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tool_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "executed",
          "source_bound",
          "evidence"
        ],
        "properties": {
          "id": {
            "enum": [
              "field-identities",
              "presence-oneof",
              "bytes",
              "uint64",
              "enums",
              "rpc-stream-signatures"
            ]
          },
          "status": {
            "const": "passed"
          },
          "executed": {
            "const": true
          },
          "source_bound": {
            "const": true
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runtime",
              "generated_consumer_path",
              "stdout_path",
              "stderr_path",
              "generated_consumer_sha256",
              "stdout_sha256",
              "stderr_sha256"
            ],
            "properties": {
              "runtime": {
                "const": true
              },
              "generated_consumer_path": {
                "$ref": "#/$defs/relativePath"
              },
              "stdout_path": {
                "$ref": "#/$defs/relativePath"
              },
              "stderr_path": {
                "$ref": "#/$defs/relativePath"
              },
              "generated_consumer_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "stdout_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "stderr_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "modelDigest": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "boundFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "source_revision",
        "source_digest"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "source_digest": {
          "$ref": "#/$defs/modelDigest"
        }
      }
    }
  }
}
