{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.acyclic.dev/schemas/rpc-scenario-log.v1.json",
  "title": "Acyclic SDK Rust-bound RPC scenario log",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_revision", "consumer", "scenarios"],
  "properties": {
    "schema": { "const": "acyclic.sdk.rpc-scenario-log.v1" },
    "source_revision": { "$ref": "#/$defs/gitOid" },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "artifact_path", "artifact_sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "artifact_path": { "$ref": "#/$defs/consumerPath" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["output_path", "output_sha256"],
        "properties": {
          "output_path": { "$ref": "#/$defs/consumerPath" },
          "output_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "gitOid": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "consumerPath": {
      "type": "string",
      "pattern": "^qualification/consumers/[A-Za-z0-9._/-]+$"
    }
  }
}
