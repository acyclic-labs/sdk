{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.acyclic.dev/schemas/rust-semantic-seed-graph.v1.json",
  "title": "Rust-owned ordered semantic seed graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "count",
    "steps"
  ],
  "properties": {
    "schema": {
      "const": "acyclic.sdk.rust-semantic-seed-graph.v1"
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "family",
          "operation",
          "seed",
          "depends_on",
          "known_output"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "family": {
            "enum": [
              "filesystem",
              "harness"
            ]
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "seed": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "known_output": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
