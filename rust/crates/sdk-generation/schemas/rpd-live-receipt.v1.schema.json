{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.acyclic.dev/schemas/rpd-live-receipt.v1.json",
  "title": "Acyclic Rust-bound live SDK receipt",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "authority", "methods", "executed_package"],
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^acyclic\\.sdk\\.rpd\\.(ruby|php|dart)-live-receipt\\.v1$"
    },
    "authority": { "$ref": "#/$defs/authority" },
    "methods": { "type": "array", "minItems": 1 },
    "executed_package": { "$ref": "#/$defs/executedPackage" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"
    },
    "authority": {
      "type": "object",
      "required": ["source_git_sha", "model_digest", "source_file_hashes"],
      "properties": {
        "source_git_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "model_digest": { "$ref": "#/$defs/sha256" },
        "source_file_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "executedPackage": {
      "type": "object",
      "required": ["source_git_sha", "source_file_hashes"],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "source_git_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "model_digest": { "$ref": "#/$defs/sha256" },
        "rust_model_digest": { "$ref": "#/$defs/sha256" },
        "source_file_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        },
        "artifact_path": { "type": "string", "minLength": 1 },
        "package_artifact_path": { "type": "string", "minLength": 1 },
        "archive_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "package_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "provenance": {
          "type": "object",
          "required": ["source_file_hashes"],
          "properties": {
            "source_file_hashes": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "$ref": "#/$defs/sha256" }
            },
            "artifact_path": { "type": "string", "minLength": 1 },
            "artifact_sha256": { "$ref": "#/$defs/sha256" },
            "package_artifact_path": { "type": "string", "minLength": 1 },
            "package_artifact_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      },
      "allOf": [
        {
          "oneOf": [
            { "required": ["artifact_path", "artifact_sha256"] },
            { "required": ["package_artifact_path", "package_artifact_sha256"] },
            { "required": ["archive_path", "artifact_sha256"] },
            {
              "required": ["provenance"],
              "properties": {
                "provenance": {
                  "anyOf": [
                    { "required": ["artifact_path", "artifact_sha256"] },
                    { "required": ["package_artifact_path", "package_artifact_sha256"] }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  }
}
