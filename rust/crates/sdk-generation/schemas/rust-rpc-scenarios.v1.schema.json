{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.acyclic.dev/schemas/rust-rpc-scenarios.v1.json",
  "title": "Rust-owned RPC semantic scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "count", "scenarios"],
  "properties": {
    "schema": { "const": "acyclic.sdk.rust-rpc-scenarios.v1" },
    "count": { "type": "integer", "minimum": 1 },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "operation", "input", "expected", "source"],
        "properties": {
          "family": { "enum": ["filesystem", "harness"] },
          "operation": { "type": "string", "minLength": 1 },
          "input": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 },
          "source": { "const": "rust/crates/sdk-examples/src/fixtures/filesystem_harness.rs" }
        }
      }
    }
  }
}
