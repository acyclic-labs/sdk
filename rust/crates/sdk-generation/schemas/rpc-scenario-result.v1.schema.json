{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.acyclic.dev/schemas/rpc-scenario-result.v1.json",
  "title": "Acyclic SDK Rust-bound RPC scenario result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "source_revision", "status", "invoked", "exit_code",
    "family", "rpc", "shape", "transport", "execution_mode", "rpc_outcome", "semantic_evidence", "checks"
  ],
  "properties": {
    "schema": { "const": "acyclic.sdk.rpc-scenario-result.v1" },
    "source_revision": { "$ref": "#/$defs/gitOid" },
    "status": { "const": "passed" },
    "invoked": { "const": true },
    "exit_code": { "const": 0 },
    "family": { "type": "string", "minLength": 1 },
    "rpc": { "type": "string", "minLength": 1 },
    "shape": { "enum": ["unary", "client", "server", "bidi"] },
    "transport": { "enum": ["grpc", "http", "http-json", "grpc-web"] },
    "execution_mode": { "enum": ["remote", "in-process"] },
    "rpc_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "code", "response_count"],
      "properties": {
        "status": { "const": "ok" },
        "code": { "const": 0 },
        "response_count": { "type": "integer", "minimum": 1 }
      }
    },
    "semantic_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_type", "present_fields", "checked_rules", "rule_results", "identity_matches", "observations"],
      "properties": {
        "response_type": { "type": "string", "minLength": 1 },
        "present_fields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "checked_rules": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "rule_results": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "identity_matches": { "type": "boolean" },
        "rust_scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "operation", "input", "expected", "source", "order", "seed", "depends_on", "known_output"],
          "properties": {
            "family": { "enum": ["filesystem", "harness"] },
            "operation": { "type": "string", "minLength": 1 },
            "input": { "type": "string", "minLength": 1 },
            "expected": { "type": "string", "minLength": 1 },
            "source": { "const": "rust/crates/sdk-examples/src/fixtures/filesystem_harness.rs" },
            "order": { "type": "integer", "minimum": 1 },
            "seed": { "type": "string", "minLength": 1 },
            "depends_on": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "known_output": { "type": "string", "minLength": 1 }
          }
        },
        "observations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity_pairs", "cursor_trace", "status_trace", "transitions"],
          "properties": {
            "identity_pairs": { "type": "array", "items": { "$ref": "#/$defs/identityPair" } },
            "cursor_trace": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
            "status_trace": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "contains": { "const": "invocation" },
      "allOf": [
        { "contains": { "const": "transport" } },
        { "contains": { "const": "receiver-response" } },
        { "contains": { "const": "serialization" } }
      ],
      "items": {
        "enum": ["invocation", "transport", "receiver-response", "serialization", "cancellation", "recovery"]
      }
    }
  },
  "$defs": {
    "gitOid": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "identityPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "request", "response"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "request": { "type": "string", "minLength": 1 },
        "response": { "type": "string", "minLength": 1 }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "before", "after"],
      "properties": {
        "kind": { "enum": ["cancellation", "recovery"] },
        "before": { "type": "string", "minLength": 1 },
        "after": { "type": "string", "minLength": 1 }
      }
    }
  }
}
