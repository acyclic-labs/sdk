@PACKAGE_INIT@

set(ACYCLIC_ACTORS_CXX_CARGO_PACKAGE_VERSION "@CPP_ACTORS_CARGO_PACKAGE_VERSION@")
set(ACYCLIC_ACTORS_CXX_CARGO_SOURCE_SHA256 "@CPP_ACTORS_CARGO_SOURCE_SHA256@")
set(ACYCLIC_ACTORS_CXX_GENERATED_HEADER_SHA256 "@CPP_ACTORS_GENERATED_HEADER_SHA256@")

if(NOT TARGET AcyclicActors::CXX)
  add_library(AcyclicActors::CXX STATIC IMPORTED)
  set_target_properties(AcyclicActors::CXX PROPERTIES
    IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@CPP_ACTORS_PACKAGE_LIBNAME@"
    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
  if(WIN32)
    set_property(TARGET AcyclicActors::CXX APPEND PROPERTY
      INTERFACE_LINK_LIBRARIES "ws2_32;bcrypt;userenv;advapi32;ntdll")
  else()
    set_property(TARGET AcyclicActors::CXX APPEND PROPERTY
      INTERFACE_LINK_LIBRARIES "dl;pthread;m")
  endif()
endif()
