@@ -0,0 +1,36 @@
+{# Generic nominal wrapper for a Rust-owned custom type. The wire representation
+   remains the canonical builtin type; only the Ruby API gains a checked value
+   object. Validators are configured by binding metadata, never handwritten per
+   Actors operation. #}
+class {{ name|class_name_rb }}
+  attr_reader :value
+
+  def initialize(value)
+    value = {{ "value"|coerce_rb(ci.namespace()|class_name_rb, builtin) }}
+    {%- match config.custom_types.get(name.as_str()) %}
+    {%- when Some with (custom_config) %}
+    {%- match custom_config.validator %}
+    {%- when Some with (validator) %}
+    {{ ci.namespace()|class_name_rb }}Uniffi.{{ validator }}(value)
+    {%- when None %}
+    {%- endmatch %}
+    {%- when None %}
+    {%- endmatch %}
+    @value = value
+  end
+
+  def ==(other)
+    other.is_a?(self.class) && other.value == @value
+  end
+
+  def self.uniffi_check_lower(value)
+    unless value.is_a?(self)
+      raise TypeError.new "Expected a {{ name|class_name_rb }} instance, got #{value}"
+    end
+  end
+
+  def self.uniffi_lower(value)
+    uniffi_check_lower(value)
+    value.value
+  end
+end
