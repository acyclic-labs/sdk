+/// Derive UniFFI's generated future-cancel symbol from its future-poll symbol.
+/// UniFFI exposes both symbols in the scaffolding header, but this backend only
+/// consumed the poll/free pair before context cancellation support was added.
+pub fn future_cancel_name(name: String) -> Result<String, askama::Error> {
+    Ok(name.replace("_rust_future_poll_", "_rust_future_cancel_"))
+}
