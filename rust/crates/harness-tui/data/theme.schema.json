{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["auto", "dark", "light"]
    },
    "dark": {
      "$ref": "#/$defs/tokens"
    },
    "light": {
      "$ref": "#/$defs/tokens"
    },
    "$schema": {
      "type": "string"
    }
  },
  "$defs": {
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fg": {
          "$ref": "#/$defs/color"
        },
        "muted": {
          "$ref": "#/$defs/color"
        },
        "accent": {
          "$ref": "#/$defs/color"
        },
        "attention": {
          "$ref": "#/$defs/color"
        },
        "success": {
          "$ref": "#/$defs/color"
        },
        "error": {
          "$ref": "#/$defs/color"
        },
        "diff-add": {
          "$ref": "#/$defs/color"
        },
        "diff-del": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "color": {
      "type": "string",
      "format": "ui-color"
    }
  }
}
