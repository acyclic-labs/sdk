{
  "openai": {
    "adapter": "responses",
    "authentication": "api_key",
    "base_url": "https://api.openai.com/v1",
    "models": {
      "gpt-6-luna": {
        "context_tokens": 8192,
        "output_tokens": 1024
      }
    },
    "max_event_bytes": 4096,
    "token_counter": {
      "path": "responses/input_tokens",
      "adapter": "responses",
      "response_field": "input_tokens",
      "framing_tokens": 0
    }
  }
}
