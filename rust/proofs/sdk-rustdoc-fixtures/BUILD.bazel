load(":fixture.bzl", "rustdoc_fixture_set")
load("@rules_rust//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "producer",
    srcs = ["producer.rs"],
    edition = "2021",
    rustc_flags = ["-Dwarnings"],
    deps = ["@sdk_crates//serde_json-1.0.154"],
)

_INPUTS = [
    "//rust/crates/sdk-generation:tests/fixtures/feature-profile/Cargo.lock",
    "//rust/crates/sdk-generation:tests/fixtures/feature-profile/Cargo.toml",
    "//rust/crates/sdk-generation:tests/fixtures/feature-profile/rust-toolchain.toml",
    "//rust/crates/sdk-generation:tests/fixtures/feature-profile/rust/crates/demo/Cargo.toml",
    "//rust/crates/sdk-generation:tests/fixtures/feature-profile/rust/crates/demo/src/lib.rs",
]

_PROFILES = {
    "default": [],
    "no_default": ["--no-default-features"],
    "base": ["--no-default-features", "--features", "base"],
    "extra": ["--no-default-features", "--features", "extra"],
    "all": ["--features", "base,extra"],
}

_FEATURE_DATA = rustdoc_fixture_set(
    srcs = _INPUTS,
    fixture_root = "rust/crates/sdk-generation/tests/fixtures/feature-profile/",
    package = "demo",
    owner_path = "rust/crates/demo",
    profiles = {"feature_" + name: flags for name, flags in _PROFILES.items()},
)

_RELOCATION_ROOT = "rust/crates/sdk-generation/tests/fixtures/relocation/"
_RELOCATION_INPUTS = [
    "//rust/crates/sdk-generation:tests/fixtures/relocation/Cargo.toml",
    "//rust/crates/sdk-generation:tests/fixtures/relocation/Cargo.lock",
    "//rust/crates/sdk-generation:tests/fixtures/relocation/rust/crates/demo/Cargo.toml",
    "//rust/crates/sdk-generation:tests/fixtures/relocation/rust/crates/demo/build.rs",
    "//rust/crates/sdk-generation:tests/fixtures/relocation/rust/crates/demo/src/lib.rs",
    "//rust/crates/sdk-generation:tests/fixtures/relocation/rust/crates/helper/Cargo.toml",
    "//rust/crates/sdk-generation:tests/fixtures/relocation/rust/crates/helper/src/lib.rs",
]
_RELOCATION_MAPPED = {
    "//rust/crates/sdk-generation:tests/fixtures/feature-profile/rust-toolchain.toml": "rust-toolchain.toml",
}

_RELOCATION_DATA = rustdoc_fixture_set(
    srcs = _RELOCATION_INPUTS,
    fixture_root = _RELOCATION_ROOT,
    package = "demo",
    owner_path = "rust/crates/demo",
    mapped_sources = _RELOCATION_MAPPED,
    needs_linker = True,
    retain_artifacts = True,
    profiles = {"relocation_" + name: flags for name, flags in _PROFILES.items()},
)

_RELOCATION_HELPER_DATA = rustdoc_fixture_set(
    srcs = _RELOCATION_INPUTS,
    fixture_root = _RELOCATION_ROOT,
    package = "relocation-helper",
    owner_path = "rust/crates/helper",
    mapped_sources = _RELOCATION_MAPPED,
    retain_artifacts = True,
    profiles = {"relocation_helper": []},
)

_LONG = "native-execution-observation-" * 8
_LONG_MANIFEST = "//rust/crates/sdk-generation:tests/fixtures/feature-profile/rust/crates/demo/long-features.toml"

_LONG_DATA = rustdoc_fixture_set(
    srcs = _INPUTS,
    fixture_root = "rust/crates/sdk-generation/tests/fixtures/feature-profile/",
    package = "demo",
    owner_path = "rust/crates/demo",
    mapped_sources = {_LONG_MANIFEST: "rust/crates/demo/Cargo.toml"},
    profiles = {"long_" + name: flags for name, flags in dict(
        _PROFILES,
        all = ["--features", "base,extra," + _LONG],
        feature = ["--no-default-features", "--features", _LONG],
    ).items()},
)

_EXCLUDED_ROOT = "rust/crates/sdk-generation/tests/fixtures/excluded-owners/"
_EXCLUDED_INPUTS = [
    "//rust/crates/sdk-generation:tests/fixtures/excluded-owners/Cargo.toml",
    "//rust/crates/sdk-generation:tests/fixtures/excluded-owners/Cargo.lock",
    "//rust/crates/sdk-generation:tests/fixtures/excluded-owners/rust/crates/demo/Cargo.toml",
    "//rust/crates/sdk-generation:tests/fixtures/excluded-owners/rust/vendor/helper/Cargo.toml",
    "//rust/crates/sdk-generation:tests/fixtures/excluded-owners/rust/vendor/helper/src/lib.rs",
    "//rust/crates/sdk-generation:tests/fixtures/excluded-owners/rust/vendor/macros/Cargo.toml",
    "//rust/crates/sdk-generation:tests/fixtures/excluded-owners/rust/vendor/macros/Cargo.lock",
    "//rust/crates/sdk-generation:tests/fixtures/excluded-owners/rust/vendor/macros/src/lib.rs",
    "//rust/crates/sdk-generation:tests/fixtures/excluded-owners/rust/vendor/macro-dev-helper/Cargo.toml",
    "//rust/crates/sdk-generation:tests/fixtures/excluded-owners/rust/vendor/macro-dev-helper/src/lib.rs",
]
_SHARED = {
    "//rust/crates/sdk-generation:tests/fixtures/feature-profile/rust-toolchain.toml": "rust-toolchain.toml",
    "//rust/crates/sdk-generation:tests/fixtures/feature-profile/rust/crates/demo/src/lib.rs": "rust/crates/demo/src/lib.rs",
}
_EXCLUDED_DEMO_DATA = rustdoc_fixture_set(
    srcs = _EXCLUDED_INPUTS,
    fixture_root = _EXCLUDED_ROOT,
    package = "demo",
    owner_path = "rust/crates/demo",
    mapped_sources = _SHARED,
    needs_linker = True,
    profiles = {"excluded_demo_" + name: flags for name, flags in _PROFILES.items()},
)

_EXCLUDED_MACROS_DATA = rustdoc_fixture_set(
    srcs = _EXCLUDED_INPUTS,
    fixture_root = _EXCLUDED_ROOT,
    package = "demo-macros",
    manifest_path = "rust/vendor/macros/Cargo.toml",
    owner_path = "rust/vendor/macros",
    selected_lock = "rust/vendor/macros/Cargo.lock",
    library_name = "renamed_macro_target",
    proc_macro = True,
    mapped_sources = _SHARED,
    profiles = {"excluded_macros_" + name: flags for name, flags in _PROFILES.items()},
)

_EXCLUDED_HELPER_DATA = rustdoc_fixture_set(
    srcs = _EXCLUDED_INPUTS,
    fixture_root = _EXCLUDED_ROOT,
    package = "demo-helper",
    manifest_path = "rust/vendor/helper/Cargo.toml",
    owner_path = "rust/vendor/helper",
    selected_lock = "Cargo.lock",
    mapped_sources = _SHARED,
    profiles = {"excluded_helper_default": []},
)

filegroup(
    name = "feature_profiles",
    srcs = {label: True for label in _FEATURE_DATA + _LONG_DATA +
                                    _RELOCATION_DATA + _RELOCATION_HELPER_DATA +
                                    _EXCLUDED_DEMO_DATA + _EXCLUDED_MACROS_DATA +
                                    _EXCLUDED_HELPER_DATA}.keys(),
)
