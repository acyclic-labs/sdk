load(":fixture.bzl", "rustdoc_fixture_set")
load("@rules_rust//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "producer",
    srcs = ["producer.rs"],
    edition = "2021",
)

_INPUTS = [
    "//rust/crates/sdk-generation:tests/fixtures/feature-profile/Cargo.lock",
    "//rust/crates/sdk-generation:tests/fixtures/feature-profile/Cargo.toml",
    "//rust/crates/sdk-generation:tests/fixtures/feature-profile/rust-toolchain.toml",
    "//rust/crates/sdk-generation:tests/fixtures/feature-profile/rust/crates/demo/Cargo.toml",
    "//rust/crates/sdk-generation:tests/fixtures/feature-profile/rust/crates/demo/src/lib.rs",
]

rustdoc_fixture_set(
    srcs = _INPUTS,
    fixture_root = "rust/crates/sdk-generation/tests/fixtures/feature-profile/",
    package = "demo",
    profiles = {
        "feature_default": [],
        "feature_no_default": ["--no-default-features"],
        "feature_base": ["--no-default-features", "--features", "base"],
        "feature_extra": ["--no-default-features", "--features", "extra"],
        "feature_all": ["--features", "base,extra"],
    },
)

filegroup(name = "feature_profiles", srcs = _INPUTS + [":feature_default", ":feature_no_default", ":feature_base", ":feature_extra", ":feature_all"])
