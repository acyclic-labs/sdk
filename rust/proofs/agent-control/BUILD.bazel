load("//toolchains/kani:defs.bzl", "kani_test")

_SRCS = [
    "//rust/crates/harness-control:src/agent.rs",
    "//rust/crates/harness-core:src/agent/release.rs",
    "//rust/crates/harness-core:tests/formal/agent_control_model.rs",
    "//rust/crates/harness-core:tests/formal/agent_control_contract.rs",
]

_POSITIVE = "//rust/crates/harness-core:tests/formal/agent_control.rs"
_NEGATIVE = "//rust/crates/harness-core:tests/formal/agent_control_negative.rs"

kani_test(
    name = "exactly_once",
    src = _POSITIVE,
    srcs = _SRCS,
    harness = "agent_control_is_exactly_once_and_never_loses_a_wake",
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    size = "small",
)

kani_test(
    name = "archive_cascade",
    src = _POSITIVE,
    srcs = _SRCS,
    harness = "archive_cascade_drains_and_reports_exactly_once",
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    size = "small",
)

kani_test(
    name = "released_generation",
    src = _POSITIVE,
    srcs = _SRCS,
    harness = "released_generation_is_terminal_and_has_no_committed_turn",
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    size = "small",
)

kani_test(
    name = "condition_wait",
    src = _POSITIVE,
