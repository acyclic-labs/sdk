load("//toolchains/kani:defs.bzl", "kani_test")
load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "contracts",
    crate_root = "//rust/crates/filesystem-base:src/numeric.rs",
    srcs = ["//rust/crates/filesystem-base:src/numeric.rs"],
    edition = "2024",
    lint_config = "//:workspace_lints",
    rustc_flags = ["-Dwarnings"],
)

kani_test(
    name = "exact_admission",
    src = "proof.rs",
    srcs = ["//rust/crates/filesystem-base:src/numeric.rs"],
    harness = "admission_preserves_all_numbers_and_accepts_every_u32",
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    size = "small",
)
