+def _add_incremental_flags(ctx, toolchain, tool_file, emit, args):
+    """Compiles the main repository's crates incrementally when `incremental_dir` names a directory.
+
+    Only rustc itself (not clippy or rustdoc) and only crates of the main repository: an external crate never
+    changes under a fixed lock, so it is a cache hit and needs no incremental state. The directory is the same
+    string on every host that shares a cache, so it changes no action key between them. Compilation modes,
+    targets and metadata-only checks keep separate state, so none invalidates another's.
+
+    Args:
+        ctx (ctx): The rule's context object.
+        toolchain (rust_toolchain): The current target's `rust_toolchain`.
+        tool_file (File): The compiler this action runs.
+        emit (list): What rustc emits.
+        args (Args): A reference to an Args object.
+    """
+    if not toolchain._incremental_dir or tool_file != toolchain.rustc or ctx.label.repo_name != "":
+        return
+    kinds = [kind[0] if type(kind) in ["tuple", "list"] else kind for kind in emit]
+    args.add("-Cincremental={}/{}-{}{}".format(
+        toolchain._incremental_dir,
+        ctx.var["COMPILATION_MODE"],
+        toolchain.target_flag_value.replace("/", "_"),
+        "" if "link" in kinds else "-check",
+    ))
+
