+def incremental_dir():
+    """An absolute directory for rustc's incremental state of the main repository's crates; empty disables it.
+
+    The same string on every host that shares a cache keeps action keys identical across them. Sandboxed
+    strategies need it writable: pass it to `--sandbox_writable_path` too.
+    """
+    string_flag(
+        name = "incremental_dir",
+        build_setting_default = "",
+    )
+
