+/// Immutable root-writeback admission returned after inspecting a direct
+/// child.  The interaction ticket is owned by the parent session; the child
+/// identity is retained so a later resolve cannot redirect the admission to a
+/// sibling or a different project.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct LocalSwarmWritebackInspection {
+    /// Child session whose project was inspected.
+    pub task: TaskId,
+    /// Parent session that owns the writeback interaction.
+    pub approval_task: TaskId,
+    /// Durable operator interaction awaiting a choice.
+    pub approval_id: InteractionId,
+    /// Operation identity selected by the caller.
+    pub operation_id: OperationId,
+    /// Digest binding the operation, child, projects, and generations.
+    pub action_digest: [u8; 32],
+    /// Child project generation inspected as the source.
+    pub source_generation: GenerationRef,
+    /// Parent project generation pinned as the CAS target.
+    pub expected_target_generation: GenerationRef,
+    /// Child project bound by the published fork.
+    pub source_project: VolumeRef,
+    /// Parent project that owns the root writeback.
+    pub target_project: VolumeRef,
+}
+
+/// Durable result of resolving a writeback operator interaction.  Approval is
+/// reported only after the interaction outcome is committed; provider effects
+/// remain behind the existing authenticated facade and recovery boundary.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct LocalSwarmWritebackResolution {
+    /// Child session whose inspected action was resolved.
+    pub task: TaskId,
+    /// Parent session that owns the approval ticket.
+    pub approval_task: TaskId,
+    /// Durable interaction identity.
+    pub approval_id: InteractionId,
+    /// Operation identity bound by the interaction.
+    pub operation_id: OperationId,
+    /// Exact action digest revalidated at resolution.
+    pub action_digest: [u8; 32],
+    /// Durable decision committed by the interaction journal.
+    pub outcome: InteractionOutcome,
+    /// Whether the exact root writeback request was admitted.  This is true
+    /// only for an approved interaction; it does not claim provider success.
+    pub admitted: bool,
+}
