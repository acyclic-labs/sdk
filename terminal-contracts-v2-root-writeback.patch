+    /// Inspects a direct child's published project through the parent-owned
+    /// merge controller and opens one durable, exact approval ticket.  No
+    /// provider mutation occurs here.  The action digest includes both
+    /// immutable generations so a later resolve cannot reuse the ticket after
+    /// either side has advanced.
+    pub async fn inspect_root_writeback(
+        &self,
+        task: TaskId,
+        operation_id: OperationId,
+    ) -> Result<LocalSwarmWritebackInspection> {
+        let prepared = self.prepare_root_writeback(task, operation_id).await?;
+        let approval_task = self
+            .session(task)
+            .await?
+            .parent
+            .ok_or_else(|| Error::Invalid("root writeback requires a direct child".into()))?;
+        let parent_harness = self.open_session(approval_task).await?;
+        let interaction_id = InteractionId::new();
+        parent_harness
+            .storage()
+            .open_interaction(
+                interaction_id,
+                Interaction::approval(
+                    "Approve exact root project writeback",
+                    operation_id,
+                    prepared.action_digest,
+                )?,
+            )
+            .await?;
+        Ok(LocalSwarmWritebackInspection {
+            task,
+            approval_task,
+            approval_id: interaction_id,
+            operation_id,
+            action_digest: prepared.action_digest,
+            source_generation: prepared.source_generation,
+            expected_target_generation: prepared.expected_target_generation,
+            source_project: prepared.source_project,
+            target_project: prepared.target_project,
+        })
+    }
+
+    /// Authenticates and durably resolves the exact operator decision for a
+    /// previously inspected child.  The current provider plan is rebuilt and
+    /// its binding is compared before the interaction is resolved, so stale
+    /// generations fail closed.  The returned `admitted` bit means only that
+    /// an exact `RootWritebackRequest` can now be constructed by the existing
+    /// provider facade; it never reports a workspace mutation as successful.
+    pub async fn resolve_root_writeback(
+        &self,
+        task: TaskId,
+        approval_id: InteractionId,
+        approved: bool,
+    ) -> Result<LocalSwarmWritebackResolution> {
+        let approval_task = self
+            .session(task)
+            .await?
+            .parent
+            .ok_or_else(|| Error::Invalid("root writeback requires a direct child".into()))?;
+        let approval = self
+            .list_approvals(approval_task)
+            .await?
+            .into_iter()
+            .find(|approval| approval.ticket.id == approval_id)
+            .ok_or_else(|| Error::NotFound(format!("root writeback approval {approval_id}")))?;
+        let binding = approval.ticket.approval.ok_or_else(|| {
+            Error::Invalid("root writeback ticket has no exact operation binding".into())
+        })?;
+        if approval.resolution.is_some() {
+            return Err(Error::Conflict(
+                "root writeback approval is no longer pending".into(),
+            ));
+        }
+        let prepared = self
+            .prepare_root_writeback(task, binding.operation_id)
+            .await?;
+        if prepared.action_digest != binding.action_digest {
+            return Err(Error::Conflict(
+                "root writeback inspected generations are stale; inspect again".into(),
+            ));
+        }
+
+        // The operator choice is accepted only through the host-owned
+        // credential boundary.  The existing resolver then signs the exact
+        // interaction grant and commits the outcome to the durable journal.
+        self.record_operator_approval(approval_task, approval_id, approved)
+            .await?;
+        let outcome = self
+            .resolve_recorded_operator_approval(approval_task, approval_id, approved)
+            .await?;
+        let admitted = matches!(outcome, InteractionOutcome::Approved);
+        Ok(LocalSwarmWritebackResolution {
+            task,
+            approval_task,
+            approval_id,
+            operation_id: binding.operation_id,
+            action_digest: binding.action_digest,
+            outcome,
+            admitted,
+        })
+    }
+
+    /// Reconstructs the existing facade request after a durable approved
+    /// outcome.  The caller supplies the host-authenticated parent scope; a
+    /// model-facing boolean cannot manufacture this request.  Provider
+    /// dispatch remains the responsibility of `FilesystemGitFacade`.
+    pub async fn approved_root_writeback_request(
+        &self,
+        task: TaskId,
+        approval_id: InteractionId,
+        scope: Scope,
+    ) -> Result<RootWritebackRequest> {
+        let approval_task = self
+            .session(task)
+            .await?
+            .parent
+            .ok_or_else(|| Error::Invalid("root writeback requires a direct child".into()))?;
+        let approval = self
+            .list_approvals(approval_task)
+            .await?
+            .into_iter()
+            .find(|approval| approval.ticket.id == approval_id)
+            .ok_or_else(|| Error::NotFound(format!("root writeback approval {approval_id}")))?;
+        let binding = approval.ticket.approval.ok_or_else(|| {
+            Error::Invalid("root writeback ticket has no exact operation binding".into())
+        })?;
+        if approval.resolution.as_ref().map(|resolution| &resolution.outcome)
+            != Some(&InteractionOutcome::Approved)
+        {
+            return Err(Error::Unauthorized(
+                "root writeback requires a durable approved operator outcome".into(),
+            ));
+        }
+        let prepared = self
+            .prepare_root_writeback(task, binding.operation_id)
+            .await?;
+        if prepared.action_digest != binding.action_digest {
+            return Err(Error::Conflict(
+                "root writeback inspected generations are stale; inspect again".into(),
+            ));
+        }
+        let parent_harness = self.open_session(approval_task).await?;
+        let storage = parent_harness.storage();
+        let approval = RootWritebackApproval::issue(
+            &storage.verifier(),
+            &scope,
+            prepared.target_project,
+            binding.operation_id,
+            prepared.source_generation,
+            prepared.expected_target_generation,
+        )?;
+        Ok(RootWritebackRequest::new(approval, scope))
+    }
+
+    async fn prepare_root_writeback(
+        &self,
+        task: TaskId,
+        operation_id: OperationId,
+    ) -> Result<PreparedRootWriteback> {
+        let child_session = self.session(task).await?;
+        let approval_task = child_session
+            .parent
+            .ok_or_else(|| Error::Invalid("root writeback requires a direct child".into()))?;
+        let seed = self.published_seed(task).await?;
+        seed.validate()?;
+        let project = seed
+            .resources
+            .iter()
+            .find_map(|resource| match (&resource.source, &resource.revision) {
+                (
+                    ResourceRevision::Project { volume: source, .. },
+                    ResourceRevision::Project { volume: child, .. },
+                ) => Some((source.clone(), child.clone())),
+                _ => None,
+            })
+            .ok_or_else(|| Error::NotFound("published child has no project capture".into()))?;
+        let parent_harness = self.open_session(approval_task).await?;
+        let aggregate = parent_harness
+            .conversation_aggregate(self.config.limits)
+            .await?;
+        let parent = aggregate.reducer();
+        if parent.authority() != &seed.parent || parent.fork(&seed.child).is_none() {
+            return Err(Error::Conflict(
+                "published child identity no longer matches its parent binding".into(),
+            ));
+        }
+        let storage = parent_harness.storage();
+        let verifier = storage.verifier();
+        let controller = ParentProjectController::new(
+            &self.filesystem_host,
+            parent,
+            &verifier,
+            storage.owner_scope(),
+            project.0.clone(),
+        )?;
+        let plan = controller.prepare_project_merge(&project.1).await?;
+        let source_generation = self.filesystem_host.generation_ref_id(plan.source_head())?;
+        let expected_target_generation =
+            self.filesystem_host.generation_ref_id(plan.target_head())?;
+        let action_digest = root_writeback_action_digest(
+            operation_id,
+            &seed.child,
+            &seed.parent,
+            &project.1,
+            &project.0,
+            &source_generation,
+            &expected_target_generation,
+        )?;
+        Ok(PreparedRootWriteback {
+            source_project: project.1,
+            target_project: project.0,
+            source_generation,
+            expected_target_generation,
+            action_digest,
+        })
+    }
