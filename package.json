{
  "name": "@acyclic-labs/sdk-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["typescript/packages/*"],
  "scripts": {
    "build:wasm": "bun scripts/build-wasm.mjs",
    "build": "bun run build:wasm && tsc -b --force",
    "check": "bun run build:wasm && tsc -b --force --pretty false",
    "generate": "bun scripts/generate.mjs",
    "check:generated": "bun scripts/check-generated.mjs",
    "test": "bun run check && bun test --parallel=4 typescript/packages && bun run --filter '@acyclic-labs/fs' test",
    "licenses": "bun scripts/check-js-licenses.mjs"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "2.14.1",
    "@types/bun": "1.4.0",
    "ajv": "8.20.0",
    "typescript": "7.0.2"
  }
}
