      "requires_installed_package": true,
      "requires_process_ownership": true,
      "requires_lazy_observation": true,
      "allows_mock_fixture": false,
      "required_markers": ["approval transitions to approved", "writeback applied only with matching operation and generation", "cancellation and resume state transitions"]
    },
