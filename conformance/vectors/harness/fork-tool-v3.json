{
  "version": 3,
  "tool": {
    "name": "acyclic.fork_child",
    "revision": "3",
    "description": "Request an owner-prepared recursive child after this model batch completes",
    "input_schema": {
      "type": "object",
      "required": ["child_operation", "task", "prompt"],
      "properties": {
        "fork_operation": { "type": "string" },
        "child_operation": { "type": "string" },
        "task": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "prompt": { "type": "string", "maxLength": 65536 },
        "requested_resources": {
          "type": "object",
          "required": ["model_steps", "output_bytes", "execution_time_ms"],
          "properties": {
            "model_steps": { "type": "integer", "minimum": 1 },
            "output_bytes": { "type": "integer", "minimum": 1 },
            "execution_time_ms": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "cases": [
    {
      "name": "bounded request",
      "value": {
        "child_operation": "11111111-1111-1111-1111-111111111111",
        "task": "lint the changed files",
        "prompt": "Inspect the current diff and report issues.",
        "requested_resources": {
          "model_steps": 8,
          "output_bytes": 65536,
          "execution_time_ms": 120000
        }
      },
      "expected": "accept"
    },
    {
      "name": "zero model steps",
      "value": {
        "child_operation": "22222222-2222-2222-2222-222222222222",
        "task": "invalid",
        "prompt": "This request is rejected.",
        "requested_resources": {
          "model_steps": 0,
          "output_bytes": 1,
          "execution_time_ms": 1
        }
      },
      "expected": "reject"
    },
    {
      "name": "unknown resource field",
      "value": {
        "child_operation": "33333333-3333-3333-3333-333333333333",
        "task": "invalid",
        "prompt": "This request is rejected.",
        "requested_resources": {
          "model_steps": 1,
          "output_bytes": 1,
          "execution_time_ms": 1,
          "unbounded": true
        }
      },
      "expected": "reject"
    }
  ]
}
