{
  "schema": "acyclic.agent-workspaces.eval-config.v1",
  "codex_version": "codex-cli 0.154.0",
  "model": "gpt-5.6-sol",
  "reasoning_effort": "high",
  "minimum_runs": 3,
  "case_pass_rate": 0.8,
  "suite_pass_rate": 0.9,
  "cases": [
    {
      "id": "debug-evidence-discard",
      "prompt": "prompts/debug-evidence-discard.md",
      "required_tools": {"spawn_agent": 1, "agent_changes": 1, "agent_discard": 1},
      "tool_results": {"agent_discard": [["\"status\":\"discarded\""]]},
      "route_count": 0,
      "absent": ["debug-evidence.txt"]
    },
    {
      "id": "parallel-hypotheses-selective-publication",
      "prompt": "prompts/parallel-hypotheses-selective-publication.md",
      "required_tools": {"spawn_agent": 2, "agent_changes": 2, "agent_merge": 1, "agent_discard": 1},
      "tool_results": {"agent_merge": [["\"status\":\"applied\""]], "agent_discard": [["\"status\":\"discarded\""]]},
      "minimum_routes": 1,
      "files": {"selected-hypothesis.txt": "selected alpha\n"},
      "absent": ["rejected-hypothesis.txt"]
    },
    {
      "id": "recursive-grandchild-publication",
      "prompt": "prompts/recursive-grandchild-publication.md",
      "required_tools": {"agent_changes": 1, "agent_merge": 2},
      "tool_results": {"agent_merge": [["\"status\":\"applied\""], ["\"status\":\"applied\""]]},
      "minimum_routes": 2,
      "files": {"grandchild.txt": "published through child\n"}
    },
    {
      "id": "discard",
      "prompt": "prompts/discard.md",
      "required_tools": {"agent_changes": 1, "agent_discard": 1},
      "tool_results": {"agent_discard": [["\"status\":\"discarded\""]]},
      "route_count": 0,
      "absent": ["discarded.txt"]
    },
    {
      "id": "repeated-merge",
      "prompt": "prompts/repeated-merge.md",
      "required_tools": {"agent_merge": 2},
      "tool_results": {"agent_merge": [["\"status\":\"applied\""], ["\"status\":\"already-applied\"", "\"status\":\"no-changes\""]]},
      "minimum_routes": 1,
      "files": {"repeat.txt": "merge once\n"}
    },
    {
      "id": "parent-child-conflict",
      "prompt": "prompts/parent-child-conflict.md",
      "seed_files": {"conflict.txt": "baseline\n"},
      "required_tools": {"agent_merge": 1},
      "tool_results": {"agent_merge": [["\"status\":\"conflicted\""]]},
      "minimum_routes": 1,
      "required_event_terms": ["conflict"],
      "files": {"conflict.txt": "parent version\n"}
    },
    {
      "id": "authenticated-acyclic-git-and-system-git",
      "prompt": "prompts/authenticated-acyclic-git-and-system-git.md",
      "required_tools": {"spawn_agent": 1, "agent_merge": 1},
      "tool_results": {"agent_merge": [["\"status\":\"applied\""]]},
      "minimum_routes": 1,
      "required_commands": [
        {"term": "acyclic git status", "exit_codes": [0]},
        {"term": "acyclic git commit", "exit_codes": [0]},
        {"term": "git --version", "exit_codes": [0]}
      ],
      "files": {"git-local.txt": "git compatible\n"},
      "git_unchanged": true
    },
    {
      "id": "unsupported-git-transport",
      "prompt": "prompts/unsupported-git-transport.md",
      "required_tools": {"agent_discard": 1},
      "tool_results": {"agent_discard": [["\"status\":\"discarded\""]]},
      "route_count": 0,
      "required_commands": [{"term": "acyclic git fetch", "exit_codes": [1, 2]}],
      "required_event_terms": ["transport"],
      "absent": ["transport-succeeded.txt"],
      "git_unchanged": true
    },
    {
      "id": "path-escape-attempts",
      "prompt": "prompts/path-escape-attempts.md",
      "required_tools": {"agent_discard": 1},
      "tool_results": {"agent_discard": [["\"status\":\"discarded\""]]},
      "route_count": 0,
      "required_rejected_commands": [
        "touch ../escaped.txt",
        "touch $OUTSIDE_SENTINEL"
      ],
      "absent": ["escaped.txt"],
      "outside_sentinel": "outside remains unchanged\n"
    },
    {
      "id": "speculative-dependent-reconcile-restart",
      "prompt": "prompts/speculative-dependent-reconcile-restart.md",
      "required_tools": {"spawn_agent": 1, "agent_changes": 2, "agent_merge": 2},
      "tool_results": {"agent_merge": [["\"status\":\"applied\""], ["\"status\":\"applied\""]]},
      "minimum_routes": 1,
      "files": {"foundation.txt": "foundation v1\n", "dependent.txt": "adapted to foundation v1\n"},
      "require_crash_marker": true
    }
  ]
}
