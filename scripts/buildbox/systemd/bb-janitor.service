[Unit]
Description=bb2 size-bounded janitor (sccache/jobs/wt-sdk)
[Service]
Type=oneshot
User=var
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=540
# Possess the user keyring so leaked test keys can be invalidated.
KeyringMode=shared
ExecStart=/usr/bin/python3 /usr/local/lib/buildbox/bb-janitor.py
