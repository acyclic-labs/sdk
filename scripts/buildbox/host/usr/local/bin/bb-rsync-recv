#!/bin/bash
# bb-rsync-recv DEST <rsync server args...>: receiving side of buildbox.mjs's sync (rsync --rsync-path).
# A new DEST is first seeded on the VM from the newest synced tree of the same host checkout (key prefix), else of any
# lane (all near main), so the slow host uplink carries only rsync's delta instead of the whole checkout. One sync per
# DEST at a time.
# Runs in bbsync.slice (CPUWeight/IOWeight 1000 vs user.slice 100; 2026-10-15): at VM load ~600 the receiver's checksum
# pass starved behind build jobs for minutes. The client keeps rsync -c: without it every file rsync rewrites gets a new
# mtime (full cargo rebuilds), and -t would let an edit with an old host mtime look fresh to a target built after it.
if [ -z "${BB_HI:-}" ] && [ -e /etc/systemd/system/bbsync.slice ]; then
  exec sudo -n systemd-run --scope -q --slice=bbsync.slice --uid="$(id -u)" --gid="$(id -g)" -- \
    env BB_HI=1 HOME="$HOME" PATH="$PATH" USER="${USER:-$(id -un)}" "$0" "$@"
fi
d=$1; shift
mkdir -p /mnt/bb/locks
k=${d##*/}
exec 9>"/mnt/bb/locks/$k.sync"; flock 9
if [ ! -e "$d" ]; then
  ref=$(ls -t /mnt/bb/src/"${k%.*}".*/.bb-synced 2>/dev/null | head -1)
  [ -n "$ref" ] || ref=$(ls -t /mnt/bb/src/*/.bb-synced 2>/dev/null | head -1)
  if [ -n "$ref" ]; then
    t="$d.seed.$$"
    if cp -a --reflink=auto "${ref%/.bb-synced}" "$t" 2>/dev/null; then rm -rf "$t/.bb-synced" "$t/.git"; mv -T "$t" "$d"; else rm -rf "$t"; fi
  fi
fi
mkdir -p "$d"
rsync "$@" && touch "$d/.bb-synced"
