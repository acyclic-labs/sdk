#!/bin/bash
# bb-vm-install NEW DEST [MINBYTES]: install a root-owned VM script atomically, refusing an empty, short or
# syntax-broken file (2026-10-15: a failed sed produced an empty bb-git-prep, which installed and exited 0 for ~10 s).
set -eu
new=$1 dest=$2 min=${3:-500}
[ -s "$new" ] || { echo "bb-vm-install: $new is empty" >&2; exit 1; }
[ "$(stat -c %s "$new")" -ge "$min" ] || { echo "bb-vm-install: $new is under $min bytes" >&2; exit 1; }
head -1 "$new" | grep -q '^#!' || { echo "bb-vm-install: $new has no shebang" >&2; exit 1; }
bash -n "$new"
[ ! -e "$dest" ] || sudo -n cp -p "$dest" "$dest.bak-$(date +%H%M%S)"
sudo -n install -m 755 -o root -g root "$new" "${dest%/*}/.${dest##*/}.new"
sudo -n mv "${dest%/*}/.${dest##*/}.new" "$dest"
echo "installed $dest ($(stat -c %s "$dest") B)"
