#!/bin/bash
# Assemble the VM's local (ephemeral) NVMe disks into /mnt/bb. Remote managed disks are "NVMe Accelerator"; skip them.
set -eu
mountpoint -q /mnt/bb && exit 0
devs=()
for d in /sys/block/nvme*n1; do
  m=$(cat "$d/device/model" 2>/dev/null || true)
  case "$m" in *"Direct Disk"*) devs+=("/dev/${d##*/}");; esac
done
mkdir -p /mnt/bb
if [ ${#devs[@]} -eq 0 ]; then echo "bb-nvme: no local NVMe; using the OS disk";
elif [ ${#devs[@]} -eq 1 ]; then mkfs.ext4 -q -F -E nodiscard -O ^has_journal "${devs[0]}"; mount -o noatime,nobarrier "${devs[0]}" /mnt/bb
else
  mdadm --stop /dev/md/bb 2>/dev/null || true
  yes | mdadm --create /dev/md/bb --force --level=0 --chunk=256 --raid-devices=${#devs[@]} "${devs[@]}"
  mkfs.ext4 -q -F -E nodiscard,stride=64,stripe-width=$((64*${#devs[@]})) -O ^has_journal /dev/md/bb
  mount -o noatime,nobarrier /dev/md/bb /mnt/bb
fi
mkdir -p /mnt/bb/src /mnt/bb/targets /mnt/bb/sccache /mnt/bb/tmp /mnt/bb/locks /mnt/bb/jobs
chown -R var:var /mnt/bb; chmod 1777 /mnt/bb/tmp
