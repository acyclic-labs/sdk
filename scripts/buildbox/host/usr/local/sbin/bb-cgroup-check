#!/bin/bash
# bb-cgroup-check (bb1, root; run by bb-rebuild verify): a scope shaped like a build-slot job (buildbox.mjs: bbjobs.slice,
# Delegate=yes, "job" leaf handed to var) must give both e2e launch forms an exclusive, memory-bounded child cgroup inside
# the job that can enable cpu/memory/pids for its own children (what ops/local/heap-cgroups.mjs requires):
#   var:  systemd-run --user --scope -p Delegate=yes -p MemoryMax=N CMD        (bbcg shim, first on the job PATH)
#   root: sudo systemd-run --scope -p Delegate=yes -p MemoryMax=N CMD          (bbcg shim, first in sudo's secure_path)
# Prints one line per form: "<user> cgroup=<path> exclusive=<procs> memory.max=<n> subtree=<controllers>".
set -u
exec systemd-run --scope -q --slice=bbjobs.slice -p Delegate=yes -- bash -c '
C=/sys/fs/cgroup$(sed -n s/^0:://p /proc/self/cgroup)
{ mkdir $C/job && echo $$ > $C/job/cgroup.procs && echo "+cpu +memory +pids" > $C/cgroup.subtree_control &&
  chown var $C $C/cgroup.procs $C/cgroup.subtree_control $C/cgroup.threads && chown -R var $C/job; } || { echo "FAIL job leaf in $C"; exit 1; }
probe='\''c=/sys/fs/cgroup$(sed -n s/^0:://p /proc/self/cgroup); mapfile -t p < $c/cgroup.procs; m=$(cat $c/memory.max)
mkdir $c/controller && echo $$ > $c/controller/cgroup.procs && echo "+cpu +memory +pids" > $c/cgroup.subtree_control &&
echo "$(id -un) cgroup=${c#/sys/fs/cgroup} exclusive=${#p[@]} memory.max=$m subtree=$(cat $c/cgroup.subtree_control)"'\''
runuser -u var -- env PATH=/home/var/bin/bbcg:/usr/bin:/bin systemd-run --user --scope -p Delegate=yes -p MemoryMax=1G bash -c "$probe" || echo "FAIL var form"
runuser -u var -- sudo -n systemd-run --scope -p Delegate=yes -p MemoryMax=1G bash -c "$probe" || echo "FAIL root form"
'
