#!/bin/bash
# bb-sshd-watchdog (build box VM, bb-sshd-watchdog.timer every 2 min; 2026-10-15 after a ~5 h "banner exchange" outage):
# probe sshd's banner on localhost and on the VM's own private IP (the path NSG traffic takes); restart ssh when either
# gives no SSH banner within 15 s. Log: journalctl -t bb-sshd-watchdog.
probe() { [ "$(timeout 15 bash -c "exec 3<>/dev/tcp/$1/22 && head -c 7 <&3" 2>/dev/null)" = SSH-2.0 ]; }
ip=$(ip -4 -o addr show dev "$(ip -4 route show default | awk "{print \$5; exit}")" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
bad=
probe 127.0.0.1 || bad="localhost"
[ -n "$ip" ] && { probe "$ip" || bad="${bad:+$bad,}$ip"; }
[ -z "$bad" ] && exit 0
logger -t bb-sshd-watchdog "no SSH banner from $bad; preauth=$(pgrep -fc 'sshd:.*\[preauth\]') estab=$(ss -tn state established sport = :22 | tail -n +2 | wc -l) synrecv=$(ss -tn state syn-recv sport = :22 | tail -n +2 | wc -l); restarting ssh"
systemctl restart ssh
sleep 3; probe 127.0.0.1 && logger -t bb-sshd-watchdog "ssh restarted: banner ok" || logger -t bb-sshd-watchdog "ssh restarted: still no banner"
