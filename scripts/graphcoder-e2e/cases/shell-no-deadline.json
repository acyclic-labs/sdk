{
  "id": "shell-no-deadline",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "when": {},
        "tools": [
          {
            "id": "unbounded",
            "name": "code",
            "arguments": {
              "code": "await tools.shell({\"command\":\"node -e \\\"console.log('OMITTED_LIFETIME')\\\"\"});"
            }
          }
        ]
      },
      {
        "when": {
          "tool_result": "OMITTED_LIFETIME"
        },
        "tools": [
          {
            "id": "explicit",
            "name": "code",
            "arguments": {
              "code": "await tools.shell({\"command\":\"node -e \\\"console.log('EXPLICIT_LONG_LIFETIME')\\\"\",\"timeout_ms\":300001});"
            }
          }
        ]
      },
      {
        "when": {
          "tool_result": "EXPLICIT_LONG_LIFETIME"
        },
        "text": [
          "done"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "headless",
      "text": "hello",
      "answer": "done"
    }
  ],
  "assert": {
    "requests": 3,
    "tool_contains": [
      "OMITTED_LIFETIME",
      "EXPLICIT_LONG_LIFETIME"
    ]
  },
  "physical": true
}
