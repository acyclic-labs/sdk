{
  "id": "fs-conflict-continue",
  "workspace": {
    "kind": ["git", "plain"],
    "files": {
      "seed.txt": "base\n"
    }
  },
  "model": {
    "steps": [
      {
        "when": {},
        "tools": [
          {
            "id": "branch",
            "name": "fs",
            "arguments": {
              "command": "branch topic"
            }
          }
        ]
      },
      {
        "when": {},
        "tools": [
          {
            "id": "topic",
            "name": "fs",
            "arguments": {
              "command": "switch topic"
            }
          }
        ]
      },
      {
        "when": {},
        "tools": [
          {
            "id": "topic-text",
            "name": "shell",
            "arguments": {
              "command": "node \"{{support}}/write-project.mjs\" \"seed.txt\" dG9waWMK"
            }
          }
        ]
      },
      {
        "when": {},
        "tools": [
          {
            "id": "topic-add",
            "name": "fs",
            "arguments": {
              "command": "add seed.txt"
            }
          }
        ]
      },
      {
        "when": {},
        "tools": [
          {
            "id": "topic-commit",
            "name": "fs",
            "arguments": {
              "command": "commit -m \"topic\""
            }
          }
        ]
      },
      {
        "when": {},
        "tools": [
          {
            "id": "main",
            "name": "fs",
            "arguments": {
              "command": "switch main"
            }
          }
        ]
      },
      {
        "when": {},
        "tools": [
          {
            "id": "main-text",
            "name": "shell",
            "arguments": {
              "command": "node \"{{support}}/write-project.mjs\" \"seed.txt\" bWFpbgo="
            }
          }
        ]
      },
      {
        "when": {},
        "tools": [
          {
            "id": "main-add",
            "name": "fs",
            "arguments": {
              "command": "add seed.txt"
            }
          }
        ]
      },
      {
        "when": {},
        "tools": [
          {
            "id": "main-commit",
            "name": "fs",
            "arguments": {
              "command": "commit -m \"main\""
            }
          }
        ]
      },
      {
        "when": {},
        "tools": [
          {
            "id": "conflict",
            "name": "fs",
            "arguments": {
              "command": "merge topic"
            }
          }
        ]
      },
      {
        "when": {
          "tool_result": "conflict"
        },
        "tools": [
          {
            "id": "resolve",
            "name": "shell",
            "arguments": {
              "command": "node \"{{support}}/write-project.mjs\" \"seed.txt\" cmVzb2x2ZWQK"
            }
          }
        ]
      },
      {
        "when": {},
        "tools": [
          {
            "id": "resolve-add",
            "name": "fs",
            "arguments": {
              "command": "add seed.txt"
            }
          }
        ]
      },
      {
        "when": {},
        "tools": [
          {
            "id": "continue",
            "name": "fs",
            "arguments": {
              "command": "merge --continue"
            }
          }
        ]
      },
      {
        "when": {},
        "tools": [
          {
            "id": "show",
            "name": "fs",
            "arguments": {
              "command": "show HEAD:seed.txt"
            }
          }
        ]
      },
      {
        "when": {
          "tool_result": "resolved"
        },
        "text": [
          "done"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "headless",
      "text": "hello",
      "answer": "done"
    }
  ],
  "assert": {
    "requests": 15,
    "files": {
      "seed.txt": "resolved\n"
    },
    "model_contains": [
      "conflict",
      "resolved"
    ],
    "tool_errors": [
      "conflict"
    ],
    "tool_contains": [
      "conflict"
    ]
  },
  "ntfs": true
}
