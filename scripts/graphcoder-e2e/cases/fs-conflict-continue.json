{
  "id": "fs-conflict-continue",
  "workspace": {
    "kind": [
      "git",
      "plain"
    ],
    "files": {
      "seed.txt": "base\n"
    }
  },
  "model": {
    "steps": []
  },
  "inputs": [
    {
      "format": "workspace-fs",
      "steps": [
        {
          "args": [
            "branch",
            "topic"
          ]
        },
        {
          "args": [
            "switch",
            "topic"
          ]
        },
        {
          "write": {
            "path": "seed.txt",
            "content": "topic\n"
          }
        },
        {
          "args": [
            "add",
            "seed.txt"
          ]
        },
        {
          "args": [
            "commit",
            "-m",
            "topic"
          ]
        },
        {
          "args": [
            "switch",
            "main"
          ]
        },
        {
          "write": {
            "path": "seed.txt",
            "content": "main\n"
          }
        },
        {
          "args": [
            "add",
            "seed.txt"
          ]
        },
        {
          "args": [
            "commit",
            "-m",
            "main"
          ]
        },
        {
          "args": [
            "show",
            "HEAD:seed.txt"
          ],
          "text": "main\n"
        },
        {
          "args": [
            "show",
            "topic:seed.txt"
          ],
          "text": "topic\n"
        },
        {
          "args": [
            "merge",
            "topic"
          ],
          "error": "conflict"
        },
        {
          "write": {
            "path": "seed.txt",
            "content": "resolved\n"
          }
        },
        {
          "args": [
            "add",
            "seed.txt"
          ]
        },
        {
          "args": [
            "merge",
            "--continue"
          ]
        },
        {
          "args": [
            "show",
            "HEAD:seed.txt"
          ],
          "text": "resolved\n"
        }
      ],
      "mode": "qualification"
    }
  ],
  "assert": {
    "requests": 0,
    "files": {
      "seed.txt": "resolved\n"
    },
    "wire_contains": [
      "conflict",
      "resolved"
    ]
  },
  "ntfs": true
}
