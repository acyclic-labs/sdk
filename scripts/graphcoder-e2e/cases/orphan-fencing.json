{
  "id": "orphan-fencing",
  "workspace": {
    "kind": "plain",
    "files": { "orphan-endpoint.txt": "{{url}}" }
  },
  "model": {
    "steps": [
      {
        "when": {
          "user": "ORPHAN_START"
        },
        "tools": [
          {
            "id": "native-tree",
            "name": "shell",
            "arguments": {
              "command": "node \"{{support}}/orphan.mjs\" tree orphan-endpoint.txt"
            }
          }
        ]
      },
      {
        "when": {
          "path": "orphan-ready"
        },
        "json": {
          "ok": true
        },
        "hold": true
      }
    ]
  },
  "inputs": [
    {
      "mode": "headless",
      "text": "ORPHAN_START",
      "kill_on": {
        "path": "orphan-ready",
        "step": 1
      }
    },
    {
      "mode": "headless",
      "text": "ORPHAN_START",
      "exit": 1,
      "outcome": {
        "completion": "failed",
        "error": "tool was interrupted before its outcome was recorded; it may have run, partly or fully"
      }
    }
  ],
  "assert": {
    "requests": 1,
    "dead_tree": "orphan-ready"
  }
}
