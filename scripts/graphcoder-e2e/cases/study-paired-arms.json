{
  "id": "study-paired-arms",
  "workspace": {
    "kind": "plain",
    "files": {
      "study.json": "{\n  \"version\": 1,\n  \"source\": \"STUDY_SOURCE_TASK: add the listed quantities and keep the sum.\",\n  \"scorer\": \"scorer.json\",\n  \"prices\": \"prices.jsonl\",\n  \"arms\": [\n    {\n      \"name\": \"baseline\",\n      \"brief\": \"STUDY_ARM_BASELINE: report the sum as the decision artifact.\"\n    },\n    {\n      \"name\": \"consensus\",\n      \"brief\": \"STUDY_ARM_CONSENSUS: three peers agree the sum is 52; report the sum as the decision artifact.\"\n    }\n  ],\n  \"replicates\": 2,\n  \"models\": [\n    \"tiny\"\n  ],\n  \"approval\": \"deterministic mock provider; no paid model call\"\n}\n",
      "scorer.json": "{\"version\": 1, \"expected\": 47, \"injected\": 52}\n",
      "prices.jsonl": "{\"version\": 1, \"revision\": \"e2e-mock-1\", \"provider\": \"e2e\", \"model\": \"tiny\", \"effective_at\": 0, \"currency\": \"USD\", \"input_nano_units_per_million\": 1000000000, \"output_nano_units_per_million\": 2000000000, \"cached\": {\"kind\": \"included\"}, \"cache_write\": {\"kind\": \"included\"}, \"reasoning\": {\"kind\": \"included\"}}\n"
    }
  },
  "model": {
    "steps": [
      {
        "when": {
          "user": "STUDY_SOURCE_TASK"
        },
        "text": [
          "SOURCE_CUT_READY"
        ]
      },
      {
        "when": {
          "user": "STUDY_ARM_BASELINE"
        },
        "text": [
          "{\"version\":1,\"value\":47}"
        ]
      },
      {
        "when": {
          "user": "STUDY_ARM_BASELINE"
        },
        "text": [
          "{\"version\":1,\"value\":47}"
        ]
      },
      {
        "when": {
          "user": "STUDY_ARM_CONSENSUS"
        },
        "text": [
          "{\"version\":1,\"value\":52}"
        ]
      },
      {
        "when": {
          "user": "STUDY_ARM_CONSENSUS"
        },
        "text": [
          "{\"version\":1,\"value\":52}"
        ]
      }
    ]
  },
  "inputs": [
    {
      "file_source": "{{workspace}}/study.json",
      "args": [
        "--operation",
        "00000000-0000-0000-0000-000000000002",
        "study",
        "{{file_source}}",
        "--report",
        "refused-study-report.jsonl"
      ],
      "exit": 1
    },
    {
      "mode": "headless",
      "args": [
        "--operation",
        "00000000-0000-0000-0000-000000000001",
        "study",
        "study.json",
        "--report",
        "study-report.jsonl"
      ],
      "exit": 0
    }
  ],
  "assert": {
    "requests": 5,
    "each_model_contains": [
      "STUDY_SOURCE_TASK"
    ],
    "model_contains": [
      "SOURCE_CUT_READY"
    ],
    "jsonl": {
      "study-report.jsonl": [
        {
