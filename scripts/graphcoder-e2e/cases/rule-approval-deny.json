{
  "id": "rule-approval-deny",
  "workspace": {
    "kind": "plain",
    "files": {
      ".fixtures/hook.exe": {
        "binary_env": "E2E_HOOK_BINARY"
      }
    }
  },
  "model": {
    "steps": [
      {
        "when": {},
        "tools": [
          {
            "id": "write",
            "name": "write",
            "arguments": {
              "path": "approved.txt",
              "content": "APPROVED_E2E\n"
            }
          }
        ]
      },
      {
        "when": {},
        "text": [
          "RULE_E2E_DONE"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "service"
    },
    {
      "mode": "headless",
      "answer": "RULE_E2E_DONE",
      "text": "apply deny policy"
    },
    {
      "mode": "pty",
      "resume": true,
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder",
              "○"
            ]
          },
          "prompt": "/merge "
        },
        {
          "when": {
            "contains": [
              "Merged into checkout:"
            ]
          },
          "detach": true
        }
      ]
    }
  ],
  "assert": {
    "requests": 2,
    "absent_files": [
      "approved.txt"
    ],
    "jsonl": {
      "hooks.jsonl": [
        {
          "hook_event_name": "PreToolUse"
        }
      ]
    },
    "tool_errors": [
      "E2E approval policy"
    ],
    "tool_contains": [
      "E2E approval policy"
    ]
  },
  "settings": {
    ".claude/settings.json": "{\"hooks\":{\"PreToolUse\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"./.fixtures/hook.exe hooks.jsonl deny\"}]}]}}"
  }
}
