{
  "id": "hook-failure-refuses",
  "adapter": "anthropic",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "when": {
          "user": "CREATE_APPROVAL_WORKER"
        },
        "tools": [
          {
            "id": "spawn-approval-worker",
            "name": "spawn",
            "arguments": {
              "name": "approval-worker",
              "task": "APPROVAL_WORKER_READY",
              "role": "worker"
            }
          }
        ]
      },
      {
        "when": {
          "user": "CREATE_APPROVAL_WORKER",
          "tool_result": "agent"
        },
        "tools": [
          {
            "id": "wait-approval-worker",
            "name": "wait",
            "arguments": {
              "agents": [
                {
                  "$tool_result": "/agent"
                }
              ]
            }
          }
        ]
      },
      {
        "when": {
          "user": "APPROVAL_WORKER_READY"
        },
        "text": [
          "WORKER_READY"
        ]
      },
      {
        "when": {
          "user": "CREATE_APPROVAL_WORKER",
          "tool_result": "WORKER_READY"
        },
        "text": [
          "WORKER_CREATED"
        ]
      },
      {
        "when": {
          "user": "write approved file"
        },
        "tools": [
          {
            "id": "write",
            "name": "Write",
            "arguments": {
              "file_path": "approved.txt",
              "content": "APPROVED_E2E\n"
            }
          }
        ]
      },
      {
        "when": {
          "user": "write approved file",
          "tool_result": "tool execution failed: process: exit Some(1): E2E_HOOK_FAILURE"
        },
        "tools": [
          {
            "id": "verify-write",
            "name": "Read",
            "arguments": {
              "file_path": "approved.txt"
            }
          }
        ]
      },
      {
        "when": {
          "user": "write approved file",
          "tool_result": "selected file does not exist"
        },
        "text": [
          "HOOK_REFUSED_DONE"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "headless",
      "text": "CREATE_APPROVAL_WORKER",
      "answer": "WORKER_CREATED"
    },
    {
      "mode": "headless",
      "text": "write approved file",
      "answer": "HOOK_REFUSED_DONE",
      "select_spawned_agent": {
        "record": "hooks.jsonl",
        "name": "approval-worker"
      }
    }
  ],
  "assert": {
    "requests": 7,
    "jsonl": {
      "hooks.jsonl": [
        {
          "hook_event_name": "PreToolUse",
          "fixture_action": "fail"
        }
      ]
    },
    "tool_errors": [
      "E2E_HOOK_FAILURE",
      "tool execution failed: tool rejected: selected file does not exist"
    ],
    "tool_contains": [
      "tool execution failed: process: exit Some(1): E2E_HOOK_FAILURE",
      "tool execution failed: tool rejected: selected file does not exist"
    ]
  },
  "settings": {
    ".claude/settings.json": "{\"hooks\":{\"SessionStart\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" fail\"}]}],\"UserPromptSubmit\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" fail\"}]}],\"PreToolUse\":[{\"matcher\":\"Write\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" fail\"}]}],\"PostToolUse\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" fail\"}]}],\"Stop\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" fail\"}]}]}}"
  }
}
