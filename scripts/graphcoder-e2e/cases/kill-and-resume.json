{
  "id": "kill-and-resume",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "when": {
          "path": "responses",
          "user": "resume marker"
        },
        "text": [
          "interrupted"
        ],
        "hold": true
      }
    ]
  },
  "inputs": [
    {
      "mode": "headless",
      "text": "resume marker",
      "kill_on": {
        "path": "responses",
        "step": 0
      }
    },
    {
      "mode": "headless",
      "text": "resume marker",
      "exit": 1,
      "outcome": {
        "completion": "failed",
        "error": "connection interrupted"
      }
    }
  ],
  "assert": {
    "requests": 1
  },
  "physical": true
}
