{
  "id": "pty-mention",
  "workspace": {
    "kind": "plain",
    "files": {
      "docs a/mention.txt": "PTY_MENTION_CONTENT\n"
    }
  },
  "model": {
    "steps": [
      {
        "when": {},
        "text": [
          "MENTION_RENDERED"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "cursor": true,
            "contains": [
              "GraphCoder"
            ]
          },
          "send": "\u001b[200~inspect @docs\u001b[201~"
        },
        {
          "when": {
            "contains": [
              "Completions",
              "docs a/"
            ]
          },
          "send": "\t"
        },
        {
          "when": {
            "contains": [
              "Completions",
              "docs a/mention.txt"
            ]
          },
          "send": "\t"
        },
        {
          "when": {
            "contains": [
              "inspect @\"docs a/mention.txt\""
            ],
            "absent": [
              "Completions"
            ],
            "cursor": true
          },
          "send": "\r"
        },
        {
          "when": {
            "contains": [
              "MENTION_RENDERED",
              "○"
            ]
          },
          "detach": true
        }
      ]
    }
  ],
  "assert": {
    "requests": 1,
    "model_contains": [
      "PTY_MENTION_CONTENT"
    ]
  }
}
