{
  "id": "goal-and-plan-files",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "when": {},
        "tools": [
          {
            "id": "goal",
            "name": "write",
            "arguments": {
              "path": "volume:///home/GOAL.md",
              "content": "---\nstatus: active\n---\nGOAL_E2E\n"
            }
          }
        ]
      },
      {
        "when": {},
        "tools": [
          {
            "id": "plan",
            "name": "write",
            "arguments": {
              "path": "volume:///home/plans/release.md",
              "content": "- [ ] PLAN_E2E\n"
            }
          }
        ]
      },
      {
        "when": {},
        "text": [
          "first"
        ]
      },
      {
        "when": {},
        "tools": [
          {
            "id": "done_goal",
            "name": "write",
            "arguments": {
              "path": "volume:///home/GOAL.md",
              "content": "---\nstatus: done\n---\nGOAL_E2E\n"
            }
          }
        ]
      },
      {
        "when": {},
        "text": [
          "done"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "headless",
      "text": "start goal",
      "answer": "done"
    }
  ],
  "assert": {
    "requests": 5,
    "each_model_absent": [
      "Plans and notes go in",
      "GOAL.md is used only when",
      "<model>",
      "<git_status>",
      "Approval mode:",
      "policy-controlled approvals",
      "workspace-write OS sandbox",
      "Shell commands retain the host boundary"
    ],
    "last_model_contains": [
      "---\\nstatus: active\\n---\\nGOAL_E2E\\n"
    ],
    "tool_contains": [
      "GOAL.md",
      "plans/release.md"
    ]
  }
}
