{
  "id": "pty-file-completion",
  "workspace": {
    "kind": "plain",
    "files": {
      "neighbour/mention target.txt": "PTY_COMPLETED_MENTION_CONTENT\n",
      ".gitignore": "ignored/\n",
      "ignored/mention target.txt": "MUST_NOT_BE_COMPLETED\n"
    }
  },
  "model": { "steps": [{ "when": {}, "text": ["FILE_COMPLETION_RENDERED"] }] },
  "inputs": [{
    "mode": "pty",
    "actions": [
      { "when": { "contains": ["GraphCoder"], "cursor": true }, "send": "inspect @mntgt" },
      { "when": { "contains": ["Completions", "neighbour/mention target.txt"], "absent": ["ignored/mention target.txt"] }, "send": "\t" },
      { "when": { "contains": ["@\"neighbour/mention target.txt\""], "absent": ["Completions"] }, "send": "\r" },
      { "when": { "contains": ["FILE_COMPLETION_RENDERED", "\u25cb"] }, "send": "\u0004" }
    ]
  }],
  "assert": { "requests": 1, "model_contains": ["PTY_COMPLETED_MENTION_CONTENT"] }
}
