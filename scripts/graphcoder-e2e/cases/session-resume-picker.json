{
  "id": "session-resume-picker",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "when": {
          "user": "PICKER_PREVIEW_INPUT"
        },
        "text": [
          "PICKER_PREVIEW_ANSWER"
        ]
      },
      {
        "when": {
          "contains": "What slowed you down or blocked you? Append feedback records; reply none if nothing."
        },
        "text": ["PICKER_FEEDBACK_COMPLETE"]
      }
    ]
  },
  "inputs": [
    {
      "mode": "service"
    },
    {
      "mode": "headless",
      "args": [
        "--new-session",
        "-p",
        "PICKER_PREVIEW_INPUT"
      ],
      "answer": "PICKER_PREVIEW_ANSWER"
    },
    {
      "mode": "pty",
      "args": [
        "-r"
      ],
      "actions": [
        {
          "when": {
            "contains": [
              "Session",
              "Last prompt: PICKER_PREVIEW_INPUT",
              "Diff:",
              "This agent cost: estimated token charge: ?"
            ]
          },
          "send": "1\r"
        },
        {
          "when": {
            "contains": [
              "GraphCoder",
              "PICKER_PREVIEW_ANSWER"
            ],
            "cursor": true
          },
          "after_request": { "path": "responses", "step": 1 },
          "send": "\u0013"
        },
        {
          "when": {
            "contains": [
              "Session",
              "Last prompt: PICKER_PREVIEW_INPUT",
              "Diff:",
              "This agent cost: estimated token charge: ?"
            ]
          },
          "send": "1\r"
        },
        {
          "when": {
            "contains": [
              "GraphCoder",
              "PICKER_PREVIEW_ANSWER"
            ],
            "cursor": true
          },
          "prompt": "/quit "
        }
      ]
    }
  ],
  "assert": {
    "requests": 2
  }
}
