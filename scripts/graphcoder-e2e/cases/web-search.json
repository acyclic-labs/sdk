{
  "id": "web-search",
  "workspace": {
    "kind": "plain"
  },
  "model": {
    "steps": [
      {
        "when": {},
        "tools": [
          {
            "id": "search",
            "name": "web_search",
            "arguments": {
              "query": "fixture query"
            }
          }
        ]
      },
      {
        "when": {
          "path": "search"
        },
        "json": {
          "results": [
            {
              "id": "https://example.invalid/e2e",
              "url": "https://example.invalid/e2e",
              "title": "SEARCH_E2E_RESULT",
              "text": "scripted backend result"
            }
          ]
        }
      },
      {
        "when": {
          "tool_result": "SEARCH_E2E_RESULT"
        },
        "text": [
          "done"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "headless",
      "text": "search fixture query",
      "answer": "done"
    },
    {
      "mode": "headless",
      "text": "search fixture query",
      "answer": "done"
    }
  ],
  "assert": {
    "requests": 2,
    "tool_contains": [
      "SEARCH_E2E_RESULT",
      "https://example.invalid/e2e"
    ],
    "model_contains": [
      "\"name\":\"web_search\""
    ],
    "http": [
      {
        "path": "search",
        "body": {
          "query": "fixture query",
          "numResults": 5,
          "contents": {
            "highlights": true
          }
        }
      }
    ]
  },
  "settings": {
    ".codex/search.json": "{\"provider\": \"exa\", \"api_keys\": {\"exa\": \"e2e-unused-key\"}, \"endpoint\": \"{{url}}/search\"}"
  }
}
