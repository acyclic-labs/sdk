{
  "id": "pty-quit-resume",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "when": {
          "user": "remember QUIT_E2E_HISTORY"
        },
        "text": [
          "QUIT_E2E_FIRST"
        ]
      },
      {
        "when": {
          "user": "continue after quit",
          "contains": "QUIT_E2E_HISTORY"
        },
        "text": [
          "QUIT_E2E_DONE"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "graphcoder"
            ],
            "cursor": true
          },
          "prompt": "remember QUIT_E2E_HISTORY"
        },
        {
          "when": {
            "contains": [
              "QUIT_E2E_FIRST",
              "Enter sends"
            ]
          },
          "prompt": "/quit "
        }
      ]
    },
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "QUIT_E2E_FIRST",
              "graphcoder"
            ],
            "cursor": true
          },
          "prompt": "continue after quit"
        },
        {
          "when": {
            "contains": [
              "QUIT_E2E_DONE",
              "Enter sends"
            ]
          },
          "send": "\u0004"
        }
      ],
      "resume": true
    }
  ],
  "assert": {
    "requests": 2,
    "last_model_contains": [
      "QUIT_E2E_HISTORY",
      "QUIT_E2E_FIRST"
    ]
  }
}
