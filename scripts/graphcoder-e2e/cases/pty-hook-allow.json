{
  "id": "pty-hook-allow",
  "adapter": "anthropic",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "when": {
          "user": "CREATE_APPROVAL_WORKER"
        },
        "tools": [
          {
            "id": "spawn-approval-worker",
            "name": "spawn",
            "arguments": {
              "name": "approval-worker",
              "task": "APPROVAL_WORKER_READY",
              "role": "worker"
            }
          }
        ]
      },
      {
        "when": {
          "user": "CREATE_APPROVAL_WORKER",
          "tool_result": "agent"
        },
        "tools": [
          {
            "id": "wait-approval-worker",
            "name": "wait",
            "arguments": {
              "agents": [
                {
                  "$tool_result": "/agent"
                }
              ]
            }
          }
        ]
      },
      {
        "when": {
          "user": "APPROVAL_WORKER_READY"
        },
        "text": [
          "WORKER_READY"
        ]
      },
      {
        "when": {
          "user": "CREATE_APPROVAL_WORKER",
          "tool_result": "WORKER_READY"
        },
        "text": [
          "WORKER_CREATED"
        ]
      },
      {
        "when": {
          "user": "write approved file"
        },
        "tools": [
          {
            "id": "write",
            "name": "Write",
            "arguments": {
              "file_path": "approved.txt",
              "content": "APPROVED_E2E\n"
            }
          }
        ]
      },
      {
        "when": {
          "user": "write approved file",
          "tool_result": "approved.txt"
        },
        "tools": [
          {
            "id": "verify-write",
            "name": "Read",
            "arguments": {
              "file_path": "approved.txt"
            }
          }
        ]
      },
      {
        "when": {
          "user": "write approved file",
          "tool_result": "APPROVED_E2E"
        },
        "text": [
          "APPROVAL_E2E_DONE"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "headless",
      "text": "CREATE_APPROVAL_WORKER",
      "answer": "WORKER_CREATED"
    },
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "write approved file"
        },
        {
          "when": {
            "contains": [
              "APPROVAL_E2E_DONE",
              "○"
            ]
          },
          "send": "\u0004"
        }
      ],
      "select_spawned_agent": {
        "record": "hooks.jsonl",
        "name": "approval-worker"
      }
    }
  ],
  "assert": {
    "requests": 7,
    "jsonl": {
      "hooks.jsonl": [
        {
          "hook_event_name": "PreToolUse"
        },
        {
          "hook_event_name": "PostToolUse"
        }
      ]
    },
    "tool_contains": [
      "APPROVED_E2E"
    ]
  },
  "settings": {
    ".claude/settings.json": "{\"hooks\":{\"SessionStart\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" allow\"}]}],\"UserPromptSubmit\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" allow\"}]}],\"PreToolUse\":[{\"matcher\":\"Write\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" allow\"}]}],\"PostToolUse\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" allow\"}]}],\"Stop\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" allow\"}]}]}}"
  }
}
