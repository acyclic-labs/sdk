{
  "id": "pty-checkpoint-rewind",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "when": {
          "user": "remember REWIND_E2E_FACT"
        },
        "tools": [
          {
            "id": "write-at-cut",
            "name": "shell",
            "arguments": {
              "command": "node -e \"require('node:fs').writeFileSync('rewind-file.txt','at cut');process.stdout.write('REWIND_FILE_WRITTEN')\""
            }
          }
        ]
      },
      {
        "when": {
          "tool_result": "REWIND_FILE_WRITTEN"
        },
        "text": [
          "REWIND_E2E_FIRST"
        ]
      },
      {
        "when": {
          "contains": "Summarize this conversation"
        },
        "text": [
          "REWIND_E2E_CHECKPOINT"
        ]
      },
      {
        "when": {
          "user": "discard this turn"
        },
        "tools": [
          {
            "id": "write-after-cut",
            "name": "shell",
            "arguments": {
              "command": "node -e \"require('node:fs').writeFileSync('rewind-file.txt','after cut');process.stdout.write('REWIND_FILE_CHANGED')\""
            }
          }
        ]
      },
      {
        "when": {
          "tool_result": "REWIND_FILE_CHANGED"
        },
        "text": [
          "REWIND_E2E_DISCARDED"
        ]
      },
      {
        "when": {
          "user": "continue after rewind",
          "contains": "REWIND_E2E_CHECKPOINT"
        },
        "tools": [
          {
            "id": "read-rewound-file",
            "name": "shell",
            "arguments": {
              "command": "node -e \"process.stdout.write('REWIND_FILE=' + require('node:fs').readFileSync('rewind-file.txt','utf8'))\""
            }
          }
        ]
      },
      {
        "when": {
          "tool_result": "REWIND_FILE=at cut",
          "contains": "REWIND_E2E_CHECKPOINT"
        },
        "text": [
          "REWIND_E2E_DONE"
        ]
      },
      {
        "when": {
          "user": "verify retained rewind",
          "contains": "REWIND_E2E_CHECKPOINT"
        },
        "text": [
          "REWIND_REOPEN_DONE"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "remember REWIND_E2E_FACT"
        },
        {
          "when": {
            "contains": [
              "REWIND_E2E_FIRST",
              "○"
            ]
          },
          "prompt": "/compact "
        },
        {
          "when": {
            "contains": [
              "Compacted conversation",
              "○"
            ]
          },
          "after_request": {
            "path": "responses",
            "step": 2
          },
          "prompt": "discard this turn"
        },
        {
          "when": {
            "contains": [
              "REWIND_E2E_DISCARDED",
              "○"
            ]
          },
          "prompt": "/rewind "
        },
        {
          "when": {
            "contains": [
              "Fork / rewind to turn",
              "Turn 2"
            ]
          },
          "send": "2\r"
        },
        {
          "when": {
            "contains": [
              "REWIND_E2E_FIRST",
              "GraphCoder"
            ],
            "absent": [
              "REWIND_E2E_DISCARDED"
            ],
            "cursor": true
          },
          "prompt": "/unpause "
        },
        {
          "when": {
            "contains": [
              "Session resumed",
              "○"
            ]
          },
          "prompt": "continue after rewind"
        },
        {
          "when": {
            "contains": [
              "REWIND_E2E_DONE",
              "○"
            ]
          },
          "send": "\u0004\u0004"
        }
      ]
    },
    {
      "mode": "pty",
      "resume": true,
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder",
              "REWIND_E2E_DONE"
            ],
            "cursor": true
          },
          "prompt": "verify retained rewind"
        },
        {
          "when": {
            "contains": [
              "REWIND_REOPEN_DONE",
              "○"
            ]
          },
          "send": "\u0004\u0004"
        }
      ]
    }
  ],
  "assert": {
    "requests": 8,
    "last_model_contains": [
      "REWIND_E2E_CHECKPOINT",
      "REWIND_E2E_DONE"
    ],
    "last_model_absent": [
      "REWIND_E2E_DISCARDED",
      "discard this turn"
    ],
    "tool_contains": [
      "REWIND_FILE=at cut"
    ]
  }
}
