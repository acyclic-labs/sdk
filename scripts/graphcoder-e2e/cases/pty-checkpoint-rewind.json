{
  "id": "pty-checkpoint-rewind",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "when": {
          "user": "remember REWIND_E2E_FACT"
        },
        "text": [
          "REWIND_E2E_FIRST"
        ]
      },
      {
        "when": {
          "contains": "Summarize this conversation"
        },
        "text": [
          "REWIND_E2E_CHECKPOINT"
        ]
      },
      {
        "when": {
          "user": "discard this turn"
        },
        "text": [
          "REWIND_E2E_DISCARDED"
        ]
      },
      {
        "when": {
          "user": "continue after rewind",
          "contains": "REWIND_E2E_CHECKPOINT"
        },
        "text": [
          "REWIND_E2E_DONE"
        ]
      },
      {
        "when": {
          "user": "verify retained rewind",
          "contains": "REWIND_E2E_CHECKPOINT"
        },
        "text": [
          "REWIND_REOPEN_DONE"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "graphcoder"
            ],
            "cursor": true
          },
          "prompt": "remember REWIND_E2E_FACT"
        },
        {
          "when": {
            "contains": [
              "REWIND_E2E_FIRST",
              "Enter sends"
            ]
          },
          "prompt": "/compact "
        },
        {
          "when": {
            "contains": [
              "Compacted conversation",
              "Enter sends"
            ]
          },
          "after_request": {
            "path": "responses",
            "step": 1
          },
          "prompt": "discard this turn"
        },
        {
          "when": {
            "contains": [
              "REWIND_E2E_DISCARDED",
              "Enter sends"
            ]
          },
          "prompt": "/rewind "
        },
        {
          "when": {
            "contains": [
              "Rewound to selected checkpoint",
              "Enter sends"
            ]
          },
          "prompt": "continue after rewind"
        },
        {
          "when": {
            "contains": [
              "REWIND_E2E_DONE",
              "Enter sends"
            ]
          },
          "send": "\u0004"
        }
      ]
    },
    {
      "mode": "pty",
      "resume": true,
      "actions": [
        {
          "when": {
            "contains": [
              "graphcoder",
              "REWIND_E2E_DONE"
            ],
            "cursor": true
          },
          "prompt": "verify retained rewind"
        },
        {
          "when": {
            "contains": [
              "REWIND_REOPEN_DONE",
              "Enter sends"
            ]
          },
          "send": "\u0004"
        }
      ]
    }
  ],
  "assert": {
    "requests": 5,
    "last_model_contains": [
      "REWIND_E2E_CHECKPOINT",
      "REWIND_E2E_DONE"
    ],
    "last_model_absent": [
      "REWIND_E2E_DISCARDED",
      "discard this turn"
    ]
  }
}
