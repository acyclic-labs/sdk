{
  "id": "mcp-tool",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "when": {
          "user": "MCP_PARENT_TASK"
        },
        "tools": [
          {
            "id": "spawn",
            "name": "spawn",
            "arguments": {
              "name": "mcp-worker",
              "task": "MCP_WORKER_TASK",
              "role": "worker"
            }
          }
        ]
      },
      {
        "when": {
          "user": "MCP_PARENT_TASK",
          "tool_result": "agent"
        },
        "tools": [
          {
            "id": "wait",
            "name": "wait",
            "arguments": {
              "agents": [
                {
                  "$tool_result": "/agent"
                }
              ]
            }
          }
        ]
      },
      {
        "when": {
          "user": "MCP_WORKER_TASK"
        },
        "tools": [
          {
            "id": "mcp",
            "name": "code",
            "arguments": {
              "code": "export default await tools['mcp.fixture.echo']({text: 'hello'})"
            }
          }
        ]
      },
      {
        "when": {
          "user": "MCP_WORKER_TASK",
          "tool_result": "MCP_E2E_hello"
        },
        "text": [
          "MCP_WORKER_DONE"
        ]
      },
      {
        "when": {
          "user": "MCP_PARENT_TASK",
          "tool_result": "MCP_WORKER_DONE"
        },
        "text": [
          "done"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "headless",
      "text": "MCP_PARENT_TASK",
      "answer": "done"
    }
  ],
  "assert": {
    "requests": 5,
    "jsonl": {
      "mcp.jsonl": [
        {
          "method": "initialize"
        },
        {
          "method": "notifications/initialized"
        },
        {
          "method": "tools/list"
        },
        {
          "method": "tools/call",
          "params": {
            "name": "echo",
            "arguments": {
              "text": "hello"
            }
          }
        }
      ]
    },
    "model_contains": [
      "MCP_E2E_hello"
    ],
    "tool_results": [
      {
        "settled": [
          {
            "phase": "idle",
            "answer": "MCP_WORKER_DONE"
          }
        ],
        "unsettled": []
      }
    ]
  },
  "settings": {
    ".claude.json": "{\"mcpServers\":{\"fixture\":{\"command\":\"node\",\"args\":[\"{{support}}/mcp.mjs\",\"{{workspace}}/mcp.jsonl\"]}}}"
  }
}
