{
  "id": "pty-diff-root-metadata",
  "workspace": {
    "kind": "plain",
    "files": {
      "d.txt": "DIFF_E2E_BEFORE\n"
    }
  },
  "model": {
    "steps": [
      {
        "when": {},
        "tools": [
          {
            "id": "change",
            "name": "shell",
            "arguments": {
              "command": "node -e \"const fs=require('node:fs'); fs.chmodSync('.',0o700); fs.utimesSync('.',1000000000,1000000000); fs.writeFileSync('d.txt','DIFF_E2E_CONTENT'+String.fromCharCode(10))\""
            }
          }
        ]
      },
      {
        "when": {},
        "text": [
          "DONE_EDIT"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "graphcoder"
            ],
            "cursor": true
          },
          "prompt": "edit a file"
        },
        {
          "when": {
            "contains": [
              "DONE_EDIT",
              "Enter sends"
            ]
          },
          "prompt": "/diff "
        },
        {
          "when": {
            "contains": [
              "d.txt (modified) +1 -1",
              "-DIFF_E2E_BEFORE",
              "+DIFF_E2E_CONTENT"
            ]
          },
          "send": "\u0004"
        }
      ]
    }
  ],
  "assert": {
    "requests": 2,
    "files": {
      "d.txt": "DIFF_E2E_CONTENT\n"
    }
  }
}
