{
  "id": "pty-diff-root-metadata",
  "workspace": {
    "kind": "plain",
    "metadata": { "mode": 448, "modified": 1000000000 },
    "files": {
      ".fixtures/fs.exe": { "binary_env": "E2E_FILESYSTEM_BINARY" },
      ".fixtures/operation-0.json": "[{\"op\":\"write\",\"path\":\"d.txt\",\"text\":\"DIFF_E2E_CONTENT\\n\"},{\"op\":\"write\",\"path\":\"temporary.txt\",\"text\":\"temporary\"},{\"op\":\"remove_file\",\"path\":\"temporary.txt\"}]",
      "d.txt": "DIFF_E2E_BEFORE\n"
    }
  },
  "model": {
    "steps": [
      {
        "when": {},
        "tools": [
          {
            "id": "change",
            "name": "shell",
            "arguments": {
              "command": "./.fixtures/fs.exe .fixtures/operation-0.json"
            }
          }
        ]
      },
      {
        "when": {},
        "text": [
          "DONE_EDIT"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "edit a file"
        },
        {
          "when": {
            "contains": [
              "DONE_EDIT",
              "○"
            ]
          },
          "prompt": "/diff "
        },
        {
          "when": {
            "contains": [
              "d.txt (modified) +1 -1",
              "-DIFF_E2E_BEFORE",
              "+DIFF_E2E_CONTENT"
            ]
          },
          "prompt": "/merge "
        },
        {
          "when": {
            "contains": [
              "Merged into checkout:"
            ]
          },
          "detach": true
        }
      ]
    }
  ],
  "assert": {
    "requests": 2,
    "files": {
      "d.txt": "DIFF_E2E_CONTENT\n"
    }
  }
}
