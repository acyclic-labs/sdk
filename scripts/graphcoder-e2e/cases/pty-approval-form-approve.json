{
  "id": "pty-approval-form-approve",
  "adapter": "anthropic",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "when": {},
        "tools": [
          {
            "id": "write",
            "name": "write",
            "arguments": {
              "path": "approved.txt",
              "content": "APPROVED_E2E\n"
            }
          }
        ]
      },
      {
        "when": {
          "tool_result": "approved.txt"
        },
        "text": [
          "APPROVAL_E2E_DONE"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "write approved file"
        },
        {
          "when": {
            "contains": [
              "E2E approval policy",
              "approved.txt"
            ]
          },
          "reject": {
            "contains": [
              "APPROVAL_E2E_DONE"
            ]
          },
          "prompt": "/cost",
          "before_request": {
            "path": "messages",
            "step": 1
          }
        },
        {
          "send": "\u001b",
          "when": {
            "contains": [
              "Subtree cost"
            ],
            "absent": [
              "Original action"
            ]
          }
        },
        {
          "reject": {
            "contains": [
              "APPROVAL_E2E_DONE"
            ]
          },
          "prompt": "/feedback ",
          "when": {
            "contains": [
              "Original action",
              "approved.txt"
            ]
          }
        },
        {
          "when": {
            "contains": [
              "Enter saves locally"
            ]
          },
          "prompt": "n"
        },
        {
          "when": {
            "contains": [
              "E2E approval policy",
              "approved.txt"
            ],
            "absent": [
              "Enter saves locally"
            ]
          },
          "reject": {
            "contains": [
              "APPROVAL_E2E_DONE"
            ]
          },
          "send": "y\r",
          "before_request": {
            "path": "messages",
            "step": 1
          }
        },
        {
          "when": {
            "contains": [
              "APPROVAL_E2E_DONE",
              "○"
            ]
          },
          "prompt": "/merge "
        },
        {
          "when": {
            "contains": [
              "Merged into checkout:"
            ]
          },
          "detach": true
        }
      ]
    }
  ],
  "assert": {
    "requests": 2,
    "files": {
      "approved.txt": "APPROVED_E2E\n"
    },
    "jsonl": {
      "hooks.jsonl": [
        {
          "hook_event_name": "PreToolUse"
        },
        {
          "hook_event_name": "PostToolUse"
        }
      ]
    }
  },
  "settings": {
    ".claude/settings.json": "{\"hooks\":{\"SessionStart\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" ask\"}]}],\"UserPromptSubmit\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" ask\"}]}],\"PreToolUse\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" ask\"}]}],\"PostToolUse\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" ask\"}]}],\"Stop\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" ask\"}]}]}}"
  }
}
