{
  "id": "session-attached-cancel-query",
  "workspace": { "kind": "plain", "files": {} },
  "model": { "steps": [
    { "when": { "user": "cancel this attached root" }, "text": ["ATTACHED_ROOT_IS_RUNNING"], "hold": true }
  ] },
  "inputs": [
    { "mode": "service" },
    { "mode": "pty", "actions": [
      { "when": { "contains": ["GraphCoder"], "cursor": true }, "prompt": "/history" },
      { "when": { "contains": ["History"] }, "send": "\u0003" },
      { "when": { "contains": ["○ GraphCoder"], "absent": ["History", "cancelled"] }, "prompt": "cancel this attached root" },
      { "when": { "contains": ["ATTACHED_ROOT_IS_RUNNING"] }, "prompt": "/quit " }
    ] },
    { "mode": "pty", "resume": true, "actions": [
      { "when": { "contains": ["GraphCoder", "ATTACHED_ROOT_IS_RUNNING"], "cursor": true }, "prompt": "/history" },
      { "when": { "contains": ["History", "● GraphCoder"] }, "send": "\u0003" },
      { "when": { "contains": ["○ GraphCoder", "STOPPED", "History"] }, "send": "\u001b" },
      { "when": { "contains": ["interaction cancelled", "○ GraphCoder"], "absent": ["History"] }, "detach": true }
    ], "exit": 2 }
  ],
  "assert": { "requests": 1, "model_contains": ["cancel this attached root"] }
}
