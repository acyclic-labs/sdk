{
  "id": "child-discard",
  "workspace": {
    "kind": "git",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "spawn",
            "name": "spawn",
            "arguments": {
              "name": "worker",
              "task": "CHILD_E2E_TASK",
              "role": "worker"
            }
          }
        ]
      },
      {
        "when": {
          "user": "CHILD_E2E_TASK"
        },
        "tools": [
          {
            "id": "child-write",
            "name": "write",
            "arguments": {
              "path": "child.txt",
              "content": "child\n"
            }
          }
        ]
      },
      {
        "when": {
          "user": "CHILD_E2E_TASK",
          "tool_result": "file"
        },
        "text": [
          "child finished"
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "wait",
            "name": "wait",
            "arguments": {
              "agents": [
                "worker"
              ]
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "archive",
            "name": "archive",
            "arguments": {
              "agent": "worker"
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "archive-wait",
            "name": "wait",
            "arguments": {
              "agents": [
                "worker"
              ]
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "child-diff",
            "name": "fs",
            "arguments": {
              "command": "diff agents/worker"
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "child-final",
            "name": "fs",
            "arguments": {
              "command": "discard agents/worker"
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "text": [
          "done"
        ]
      }
    ]
  },
  "inputs": [
    { "mode": "service" },
    {
      "mode": "pty",
      "actions": [
        { "when": { "contains": ["GraphCoder"], "cursor": true }, "prompt": "PARENT_E2E_TASK" },
        { "when": { "contains": ["done", "○"], "cursor": true }, "prompt": "/merge " },
        { "when": { "contains": ["Merged into checkout:"] }, "prompt": "/quit " }
      ]
    }
  ],
  "assert": {
    "requests": 9,
    "files": {
      "child.txt": "child\n"
    }
  },
  "ntfs": true,
  "physical": true
}
