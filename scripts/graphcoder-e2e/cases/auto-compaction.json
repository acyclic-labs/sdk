{
  "id": "auto-compaction",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "capacity": {
    "context_tokens": 24576,
    "output_tokens": 1024
  },
  "model": {
    "input_tokens": 512,
    "count_bytes": true,
    "steps": [
      {
        "when": {
          "user": "remember AUTO_E2E_FACT"
        },
        "text": [
          "AUTO_E2E_OLD \n\nAUTO_E2E_FIRST"
        ]
      },
      {
        "when": {
          "contains": "Summarize the preceding context"
        },
        "text": [
          "AUTO_E2E_COMPRESSED"
        ]
      },
      {
        "when": {
          "user": "continue after automatic compaction",
          "contains": "AUTO_E2E_COMPRESSED"
        },
        "text": [
          "AUTO_E2E_DONE"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "remember AUTO_E2E_FACT"
        },
        {
          "when": {
            "contains": [
              "AUTO_E2E_FIRST",
              "○"
            ]
          },
          "prompt": "continue after automatic compaction"
        },
        {
          "when": {
            "contains": [
              "AUTO_E2E_DONE",
              "○"
            ]
          },
          "send": "\u0004"
        }
      ]
    }
  ],
  "assert": {
    "requests": 3,
    "last_model_contains": [
      "AUTO_E2E_COMPRESSED"
    ],
    "last_model_absent": [
      "AUTO_E2E_OLD"
    ]
  }
}
