{
  "id": "auto-compaction",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "capacity": {
    "context_tokens": 32768,
    "output_tokens": null
  },
  "model": {
    "count_bytes": true,
    "input_tokens": 512,
    "steps": [
      {
        "when": {
          "contains": "Summarize the preceding context"
        },
        "text": [
          "AUTO_E2E_COMPRESSED"
        ]
      },
      {
        "when": {},
        "tools": [
          {
            "id": "large-write",
            "name": "write",
            "arguments": {
              "path": "large.txt",
              "text": "",
              "media_type": "text/plain",
              "display_name": "large.txt"
            }
          }
        ]
      },
      {
        "when": {
          "tool_result": "file"
        },
        "tools": [
          {
            "id": "large-read",
            "name": "read",
            "arguments": {
              "file": {
                "$tool_result": "/file"
              }
            }
          }
        ]
      },
      {
        "when": {
          "contains": "AUTO_E2E_COMPRESSED"
        },
        "text": [
          "done"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "headless",
      "text": "perform two operations",
      "answer": "done"
    }
  ],
  "assert": {
    "requests": 4,
    "last_model_contains": [
      "AUTO_E2E_COMPRESSED"
    ],
    "model_contains": [
      "Summarize the preceding context"
    ]
  }
}
