{
  "id": "auto-compaction",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "capacity": {
    "context_tokens": 24576,
    "output_tokens": 1024
  },
  "model": {
    "input_tokens": 512,
    "count_bytes": true,
    "steps": [
      {
        "when": {
          "user": "remember AUTO_E2E_FACT"
        },
        "tools": [
          {
            "id": "old",
            "name": "write",
            "arguments": {
              "path": "old.txt",
              "content": "AUTO_E2E_OLD \n"
            }
          }
        ]
      },
      {
        "when": {
          "tool_result": "file"
        },
        "tools": [
          {
            "id": "recent",
            "name": "write",
            "arguments": {
              "path": "recent.txt",
              "content": "AUTO_E2E_RECENT \n"
            }
          }
        ]
      },
      {
        "when": {
          "contains": "[context backstop:"
        },
        "text": [
          "AUTO_E2E_DONE"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "remember AUTO_E2E_FACT"
        },
        {
          "when": {
            "contains": [
              "AUTO_E2E_DONE",
              "â—‹"
            ]
          },
          "send": "\u0004"
        }
      ]
    }
  ],
  "assert": {
    "requests": 3,
    "last_model_contains": [
      "[context backstop:",
      "AUTO_E2E_RECENT"
    ],
    "last_model_absent": [
      "AUTO_E2E_OLD",
      "AUTO_E2E_COMPRESSED",
      "Summarize the preceding context"
    ],
    "files": {
      "old.txt": "AUTO_E2E_OLD \n",
      "recent.txt": "AUTO_E2E_RECENT \n"
    }
  }
}
