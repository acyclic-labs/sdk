{
  "ntfs": true,
  "physical": true,
  "workspace": {
    "files": {},
    "kind": "plain"
  },
  "id": "bestofn-model-chosen",
  "model": {
    "steps": [
      {
        "tools": [
          {
            "name": "spawn",
            "arguments": {
              "name": "alpha",
              "role": "worker",
              "task": "ATTEMPT_alpha"
            },
            "id": "call-0-spawn"
          }
        ],
        "when": {
          "user": "COMPARE_CANDIDATES"
        }
      },
      {
        "tools": [
          {
            "name": "write",
            "arguments": {
              "content": "alpha\n",
              "path": "selected.txt"
            },
            "id": "call-1-write"
          }
        ],
        "when": {
          "user": "ATTEMPT_alpha"
        }
      },
      {
        "tools": [
          {
            "name": "read",
            "arguments": {
              "path": "selected.txt"
            },
            "id": "call-2-read"
          }
        ],
        "when": {
          "user": "ATTEMPT_alpha"
        }
      },
      {
        "tools": [
          {
            "name": "write",
            "arguments": {
              "content": "{\"version\":1,\"checks\": [{\"kind\":\"file_read\",\"path\":\"selected.txt\",\"passed\":true}],\"candidate\":\"alpha\"}",
              "path": "results/alpha/tests.json"
            },
            "id": "call-3-write"
          }
        ],
        "when": {
          "user": "ATTEMPT_alpha",
          "tool_result": "alpha"
        }
      },
      {
        "text": [
          "CANDIDATE_DONE_alpha"
        ],
        "when": {
          "user": "ATTEMPT_alpha"
        }
      },
      {
        "tools": [
          {
            "name": "spawn",
            "arguments": {
              "name": "beta",
              "role": "worker",
              "task": "ATTEMPT_beta"
            },
            "id": "call-5-spawn"
          }
        ],
        "when": {
          "user": "COMPARE_CANDIDATES"
        }
      },
      {
        "tools": [
          {
            "name": "write",
            "arguments": {
              "content": "beta\n",
              "path": "selected.txt"
            },
            "id": "call-6-write"
          }
        ],
        "when": {
          "user": "ATTEMPT_beta"
        }
      },
      {
        "tools": [
          {
            "name": "read",
            "arguments": {
              "path": "selected.txt"
            },
            "id": "call-7-read"
          }
        ],
        "when": {
          "user": "ATTEMPT_beta"
        }
      },
      {
        "tools": [
          {
            "name": "write",
            "arguments": {
              "content": "{\"version\":1,\"checks\": [{\"kind\":\"file_read\",\"path\":\"selected.txt\",\"passed\":true}],\"candidate\":\"beta\"}",
              "path": "results/beta/tests.json"
            },
            "id": "call-8-write"
          }
        ],
        "when": {
          "user": "ATTEMPT_beta",
          "tool_result": "beta"
        }
      },
      {
        "text": [
          "CANDIDATE_DONE_beta"
        ],
        "when": {
          "user": "ATTEMPT_beta"
        }
      },
      {
        "tools": [
          {
            "name": "spawn",
            "arguments": {
              "name": "gamma",
              "role": "worker",
              "task": "ATTEMPT_gamma"
            },
            "id": "call-10-spawn"
          }
        ],
        "when": {
          "user": "COMPARE_CANDIDATES"
        }
      },
      {
        "tools": [
          {
            "name": "write",
            "arguments": {
              "content": "gamma\n",
              "path": "selected.txt"
            },
            "id": "call-11-write"
          }
        ],
        "when": {
          "user": "ATTEMPT_gamma"
        }
      },
      {
        "tools": [
          {
            "name": "read",
            "arguments": {
              "path": "selected.txt"
            },
            "id": "call-12-read"
          }
        ],
        "when": {
          "user": "ATTEMPT_gamma"
        }
      },
      {
        "tools": [
          {
            "name": "write",
            "arguments": {
              "content": "{\"version\":1,\"checks\": [{\"kind\":\"file_read\",\"path\":\"selected.txt\",\"passed\":true}],\"candidate\":\"gamma\"}",
              "path": "results/gamma/tests.json"
            },
            "id": "call-13-write"
          }
        ],
        "when": {
          "user": "ATTEMPT_gamma",
          "tool_result": "gamma"
        }
      },
      {
        "text": [
          "CANDIDATE_DONE_gamma"
        ],
        "when": {
          "user": "ATTEMPT_gamma"
        }
      },
      {
        "tools": [
          {
            "name": "wait",
            "arguments": {
              "agents": [
                "alpha",
                "beta",
                "gamma"
              ]
            },
            "id": "call-15-wait"
          }
        ],
        "when": {
          "user": "COMPARE_CANDIDATES"
        }
      },
      {
        "tools": [
          {
            "name": "fs",
            "arguments": {
              "command": "diff agents/alpha"
            },
            "id": "call-16-fs"
          }
        ],
        "when": {
          "user": "COMPARE_CANDIDATES"
        }
      },
      {
        "tools": [
          {
            "name": "fs",
            "arguments": {
              "command": "diff agents/beta"
            },
            "id": "call-17-fs"
          }
        ],
        "when": {
          "user": "COMPARE_CANDIDATES"
        }
      },
      {
        "tools": [
          {
            "name": "fs",
            "arguments": {
              "command": "diff agents/gamma"
            },
            "id": "call-18-fs"
          }
        ],
        "when": {
          "user": "COMPARE_CANDIDATES"
        }
      },
      {
        "tools": [
          {
            "name": "write",
            "arguments": {
              "content": "# Candidate comparison\n\nalpha: valid\nbeta: preferred by the parent\ngamma: valid\n\n```input pick-fork id=winner\n- alpha\n- beta\n- gamma\n```\n",
              "path": "volume:///private/ui/compare.md"
            },
            "id": "call-19-write"
          }
        ],
        "when": {
          "user": "COMPARE_CANDIDATES"
        }
      },
      {
        "tools": [
          {
            "name": "read",
            "arguments": {
              "path": "volume:///private/ui/compare.md"
            },
            "id": "call-20-read"
          }
        ],
        "when": {
          "user": "COMPARE_CANDIDATES"
        }
      },
      {
        "tools": [
          {
            "name": "write",
            "arguments": {
              "content": "# Candidate comparison\n\nalpha: valid\nbeta: preferred by the parent\ngamma: valid\n\n```input pick-fork id=winner\n- alpha\n- beta\n- gamma\n```\n\r\n```ui:default\r\n```\r\n",
              "path": "volume:///private/ui/index.md"
            },
            "id": "call-21-write"
          }
        ],
        "when": {
          "user": "COMPARE_CANDIDATES"
        }
      },
      {
        "tools": [
          {
            "name": "fs",
            "arguments": {
              "command": "merge agents/beta"
            },
            "id": "call-22-fs"
          }
        ],
        "when": {
          "user": "COMPARE_CANDIDATES"
        }
      },
      {
        "tools": [
          {
            "name": "archive",
            "arguments": {
              "agent": "alpha"
            },
            "id": "call-23-archive"
          }
        ],
        "when": {
          "user": "COMPARE_CANDIDATES"
        }
      },
      {
        "tools": [
          {
            "name": "archive",
            "arguments": {
              "agent": "gamma"
            },
            "id": "call-24-archive"
          }
        ],
        "when": {
          "user": "COMPARE_CANDIDATES"
        }
      },
      {
        "tools": [
          {
            "name": "wait",
            "arguments": {
              "agents": [
                "alpha",
                "gamma"
              ]
            },
            "id": "call-25-wait"
          }
        ],
        "when": {
          "user": "COMPARE_CANDIDATES"
        }
      },
      {
        "tools": [
          {
            "name": "read",
            "arguments": {
              "path": "selected.txt"
            },
            "id": "call-26-read"
          }
        ],
        "when": {
          "user": "COMPARE_CANDIDATES"
        }
      },
      {
        "text": [
          "SEARCH_DONE"
        ],
        "when": {
          "user": "COMPARE_CANDIDATES"
        }
      }
    ]
  },
  "inputs": [
    {
      "mode": "service"
    },
    {
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "COMPARE_CANDIDATES"
        },
        {
          "when": {
            "contains": [
              "Candidate comparison",
              "SEARCH_DONE",
              "○"
            ],
            "cursor": true
          },
          "prompt": "/merge "
        },
        {
          "when": {
            "contains": [
              "Merged into checkout:"
            ]
          },
          "prompt": "/quit "
        }
      ],
      "mode": "pty"
    }
  ],
  "assert": {
    "requests": 28,
    "tool_contains": [
      "pick-fork",
      "beta",
      "archived"
    ],
    "files": {
      "selected.txt": "beta\n"
    }
  }
}
