{
  "id": "session-approval-reattach",
  "workspace": {
    "kind": "plain",
    "files": {".fixtures/fs.exe": {"binary_env": "E2E_FILESYSTEM_BINARY"}, ".fixtures/count.json": "[{\"op\":\"line_count\",\"path\":\"hooks.jsonl\",\"prefix\":\"APPROVED_AFTER_ATTACH hooks=\"}]", ".fixtures/hook.exe": {"binary_env": "E2E_HOOK_BINARY"}}
  },
  "model": {
    "steps": [
      {
        "when": {
          "user": "approval across detach"
        },
        "tools": [
          {
            "id": "approval-shell",
            "name": "shell",
            "arguments": {
              "command": "./.fixtures/fs.exe .fixtures/count.json"
            }
          }
        ]
      },
      {
        "when": {
          "tool_result": "APPROVED_AFTER_ATTACH"
        },
        "text": [
          "APPROVAL_RESUMED"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "service"
    },
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "approval across detach"
        },
        {
          "when": {
            "contains": [
              "Original action",
              "PgDn: more · PgUp: start"
            ]
          },
          "prompt": "/quit "
        }
      ]
    },
    {
      "mode": "pty",
      "resume": true,
      "actions": [
        {
          "when": {
            "contains": [
              "Original action",
              "PgDn: more · PgUp: start"
            ],
            "cursor": true
          },
          "send": "y\r"
        },
        {
          "when": {
            "contains": [
              "APPROVAL_RESUMED",
              "○"
            ]
          },
          "prompt": "/quit "
        }
      ]
    }
  ],
  "assert": {
    "requests": 2,
    "tool_contains": [
      "APPROVED_AFTER_ATTACH hooks=1"
    ]
  },
  "settings": {
    ".claude/settings.json": "{\"hooks\":{\"PreToolUse\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"./.fixtures/hook.exe hooks.jsonl ask\"}]}]}}"
  }
}
