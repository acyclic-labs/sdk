{
  "id": "pty-slash",
  "workspace": {
    "kind": "plain",
    "files": {
      ".claude/commands/marker.md": "PTY_SLASH_MARKER $ARGUMENTS\n",
      ".codex/prompts/collect/review.md": "NESTED_SLASH_MARKER $ARGUMENTS\n"
    }
  },
  "model": {
    "steps": [
      {
        "when": {},
        "text": [
          "SLASH_RENDERED"
        ]
      },
      {
        "when": {},
        "text": [
          "NESTED_RENDERED"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "send": "\u001b[200~/marke\u001b[201~"
        },
        {
          "when": {
            "contains": [
              "Completions",
              "/marker"
            ]
          },
          "send": "\u001b[27u\r"
        },
        {
          "when": {
            "contains": [
              "resource not found: Unknown command: /marke"
            ],
            "query_failure": "resource not found: Unknown command: /marke"
          },
          "prompt": "r extra"
        },
        {
          "when": {
            "contains": [
              "SLASH_RENDERED",
              "○"
            ]
          },
          "send": "\u001b[200~/col\u001b[201~"
        },
        {
          "when": {
            "contains": [
              "Completions",
              "/collect:"
            ]
          },
          "send": "\t"
        },
        {
          "when": {
            "contains": [
              "Completions",
              "/collect:review"
            ]
          },
          "send": "\t"
        },
        {
          "when": {
            "contains": [
              "/collect:review "
            ],
            "absent": [
              "Completions"
            ],
            "cursor": true
          },
          "send": "extra\r"
        },
        {
          "when": {
            "contains": [
              "NESTED_RENDERED",
              "○"
            ]
          },
          "detach": true
        }
      ]
    }
  ],
  "assert": {
    "requests": 2,
    "model_contains": [
      "PTY_SLASH_MARKER extra",
      "NESTED_SLASH_MARKER extra"
    ]
  }
}
