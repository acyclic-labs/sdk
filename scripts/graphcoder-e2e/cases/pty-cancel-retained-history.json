    {"mode":"pty","resume":true,"actions":[
      {"when":{"contains":["graphcoder","CANCELLED_E2E_HISTORY","Enter sends"],"cursor":true},"send":"\u0004"}
    ],"exit":2,"settled_contains":["CANCELLED_E2E_HISTORY","Enter sends"]}
  ],
  "assert":{"requests":1}
}
