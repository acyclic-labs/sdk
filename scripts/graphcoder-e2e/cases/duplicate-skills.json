{
  "id": "duplicate-skills",
  "workspace": {
    "kind": "plain",
    "files": {
      ".claude/skills/a/SKILL.md": "---\nname: repeated\ndescription: First declaration\n---\nFIRST BODY\n",
      ".claude/skills/b/SKILL.md": "---\nname: repeated\ndescription: Second declaration\n---\nSECOND BODY\n"
    }
  },
  "model": {
    "steps": [
      {
        "when": {
          "user": "hello"
        },
        "text": [
          "done"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "headless",
      "text": "hello",
      "answer": "done"
    },
    {
      "mode": "jsonl",
      "args": [
        "--operation",
        "00000000-0000-0000-0000-000000000002",
        "--input-format",
        "jsonl"
      ],
      "stdin": "{\"prompt\":\"/repeated\",\"id\":\"ambiguous\"}\n",
      "exit": 1,
      "stdout_contains": [
        "\"id\":\"ambiguous\"",
        "ambiguous skill: repeated"
      ]
    }
  ],
  "assert": {
    "requests": 1,
    "model_contains": [
      "First declaration",
      "Second declaration"
    ]
  }
}
