{
  "id": "bash-capture",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "when": {},
        "tools": [
          {
            "id": "bash",
            "name": "bash",
            "arguments": {
              "command": "printf 'BASH_E2E_CONTENT\\n' > bash.txt; cat bash.txt"
            }
          }
        ]
      },
      {
        "when": {
          "tool_result": "BASH_E2E_CONTENT"
        },
        "text": [
          "done"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "headless",
      "text": "hello",
      "answer": "done"
    }
  ],
  "assert": {
    "requests": 2,
    "files": {
      "bash.txt": "BASH_E2E_CONTENT\n"
    }
  }
}
