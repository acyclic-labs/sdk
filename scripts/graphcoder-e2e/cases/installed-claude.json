{
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "inputs": [
    {
      "mode": "qualification",
      "format": "installed-host",
      "host": "claude-code",
      "tools": [
        "spawn",
        "wait",
        "resume",
        "archive"
      ],
      "prompt": "NATIVE_PLUGIN_MODEL",
      "answer": "NATIVE_PLUGIN_MODEL_DONE",
      "native_permissions": [
        "Bash(node '{{support}}/../../plugin/tests/hosts/native-effects.mjs' parent '{{workspace}}')",
        "Bash(node '{{support}}/../../plugin/tests/hosts/native-effects.mjs' merge '{{workspace}}')",
        "Bash(node '{{support}}/../../plugin/tests/hosts/native-effects.mjs' finish '{{workspace}}')",
        "Bash(node '{{support}}/../../plugin/tests/hosts/native-effects.mjs' child '{{workspace}}')",
        "Bash(node '{{support}}/../../plugin/tests/hosts/native-effects.mjs' resumed '{{workspace}}')"
      ]
    }
  ],
  "model": {
    "steps": [
      {
        "when": {
          "user": "NATIVE_PLUGIN_MODEL"
        },
        "tools": [
          {
            "id": "native_parent",
            "name": "Bash",
            "arguments": {
              "command": "node '{{support}}/../../plugin/tests/hosts/native-effects.mjs' parent '{{workspace}}'"
            }
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_MODEL",
          "tool_result": "NATIVE_EFFECT_PARENT"
        },
        "tools": [
          {
            "id": "native_spawn_1",
            "name": "mcp__plugin_acyclic_acyclic-sessions__spawn",
            "arguments": {
              "reference": "native-child",
              "prompt": "NATIVE_PLUGIN_CHILD"
            }
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_MODEL",
          "tool_result": "inbox"
        },
        "tools": [
          {
            "id": "native_wait_2",
            "name": "mcp__plugin_acyclic_acyclic-sessions__wait",
            "arguments": {
              "reference": "native-child"
            }
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_MODEL",
          "tool_result": "NATIVE_PLUGIN_CHILD_DONE"
        },
        "tools": [
          {
            "id": "native_merge",
            "name": "Bash",
            "arguments": {
              "command": "node '{{support}}/../../plugin/tests/hosts/native-effects.mjs' merge '{{workspace}}'"
            }
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_MODEL",
          "tool_result": "NATIVE_EFFECT_MERGE"
        },
        "tools": [
          {
            "id": "native_resume_4",
            "name": "mcp__plugin_acyclic_acyclic-sessions__resume",
            "arguments": {
              "reference": "native-child",
              "prompt": "NATIVE_PLUGIN_RESUMED"
            }
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_MODEL",
          "tool_result": "inbox"
        },
        "tools": [
          {
            "id": "native_wait_5",
            "name": "mcp__plugin_acyclic_acyclic-sessions__wait",
            "arguments": {
              "reference": "native-child"
            }
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_MODEL",
          "tool_result": "NATIVE_PLUGIN_CHILD_RESUMED"
        },
        "tools": [
          {
            "id": "native_finish",
            "name": "Bash",
            "arguments": {
              "command": "node '{{support}}/../../plugin/tests/hosts/native-effects.mjs' finish '{{workspace}}'"
            }
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_MODEL",
          "tool_result": "NATIVE_EFFECT_FINISH"
        },
        "tools": [
          {
            "id": "native_archive_7",
            "name": "mcp__plugin_acyclic_acyclic-sessions__archive",
            "arguments": {
              "reference": "native-child"
            }
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_MODEL",
          "tool_result": "archive"
        },
        "text": [
          "NATIVE_PLUGIN_MODEL_DONE"
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_CHILD"
        },
        "tools": [
          {
            "id": "native_child",
            "name": "Bash",
            "arguments": {
              "command": "node '{{support}}/../../plugin/tests/hosts/native-effects.mjs' child '{{workspace}}'"
            }
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_CHILD",
          "tool_result": "NATIVE_EFFECT_CHILD"
        },
        "text": [
          "NATIVE_PLUGIN_CHILD_DONE"
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_RESUMED"
        },
        "tools": [
          {
            "id": "native_resumed",
            "name": "Bash",
            "arguments": {
              "command": "node '{{support}}/../../plugin/tests/hosts/native-effects.mjs' resumed '{{workspace}}'"
            }
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_RESUMED",
          "tool_result": "NATIVE_EFFECT_RESUMED"
        },
        "text": [
          "NATIVE_PLUGIN_CHILD_RESUMED"
        ]
      }
    ]
  },
  "id": "installed-claude",
  "assert": {
    "requests": 13,
    "tool_contains": [
      "NATIVE_PLUGIN_CHILD_DONE",
      "NATIVE_PLUGIN_CHILD_RESUMED",
      "Succeeded",
      "NATIVE_EFFECT_MERGE",
      "NATIVE_EFFECT_FINISH"
    ],
    "files": {
      "parent.txt": "PARENT",
      "child.txt": "CHILD",
      "resumed.txt": "RESUMED"
    }
  }
}
