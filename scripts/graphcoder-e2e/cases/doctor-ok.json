{
  "id": "doctor-ok",
  "workspace": { "kind": "plain", "files": {} },
  "settings": { "credentials.json": "{\"api_keys\":{\"morph\":\"E2E_DOCTOR_NONSECRET\"},\"keychain_service\":\"{{credential_service}}\"}" },
  "authentication": "api_key",
  "model": { "steps": [] },
  "inputs": [{
    "mode": "headless",
    "args": ["--credentials", "{{workspace}}/../settings/credentials.json", "doctor"],
    "stdout_contains": ["\"version\":1", "\"kind\":\"doctor\"", "\"mode\":\"headless\"", "\"ready\":true", "\"refusals\":[]", "provider credentials: available", "provider network: reachable", "keychain:", "terminal: ready", "filesystem mode:", "shell and state directory:"],
    "stdout_absent": ["E2E_DOCTOR_NONSECRET", "refused:"],
    "exit": 0
  }],
  "assert": { "requests": 0, "http": [{ "method": "HEAD", "step": null }] }
}
