{
  "id": "pty-approval-deny",
  "adapter": "anthropic",
  "workspace": {
    "kind": "plain",
    "files": {".fixtures/hook.exe": {"binary_env": "E2E_HOOK_BINARY"}}
  },
  "model": {
    "steps": [
      {
        "when": {},
        "tools": [
          {
            "id": "write",
            "name": "write",
            "arguments": {
              "path": "approved.txt",
              "content": "APPROVED_E2E\n"
            }
          }
        ]
      },
      {
        "when": {
          "tool_result": "tool execution failed: interaction declined"
        },
        "text": [
          "DENIAL_E2E_DONE"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "write approved file"
        },
        {
          "when": {
            "contains": [
              "E2E approval policy"
            ]
          },
          "send": "n\r",
          "before_request": {
            "path": "messages",
            "step": 1
          }
        },
        {
          "when": {
            "contains": [
              "DENIAL_E2E_DONE",
              "○"
            ]
          },
          "detach": true
        }
      ]
    }
  ],
  "assert": {
    "requests": 2,
    "absent_files": [
      "approved.txt"
    ],
    "jsonl": {
      "hooks.jsonl": [
        {
          "hook_event_name": "PreToolUse"
        }
      ]
    },
    "tool_errors": [
      "tool execution failed: interaction declined"
    ],
    "tool_contains": [
      "tool execution failed: interaction declined"
    ]
  },
  "settings": {
    ".claude/settings.json": "{\"hooks\":{\"SessionStart\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"./.fixtures/hook.exe hooks.jsonl ask\"}]}],\"UserPromptSubmit\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"./.fixtures/hook.exe hooks.jsonl ask\"}]}],\"PreToolUse\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"./.fixtures/hook.exe hooks.jsonl ask\"}]}],\"PostToolUse\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"./.fixtures/hook.exe hooks.jsonl ask\"}]}],\"Stop\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"./.fixtures/hook.exe hooks.jsonl ask\"}]}]}}"
  }
}
