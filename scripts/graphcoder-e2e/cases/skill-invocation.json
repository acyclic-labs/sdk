{
  "id": "skill-invocation",
  "workspace": {
    "kind": "plain",
    "files": {
      "AGENTS.md": "AGENTS_E2E_INSTRUCTION\n",
      "CLAUDE.md": "CLAUDE_E2E_INSTRUCTION\n",
      ".agents/skills/directory-label/SKILL.md": "---\nname: inventory\ndescription: Report the supplied instruction and skill inventory\n---\nSKILL_E2E_BODY\n$ARGUMENTS\n"
    }
  },
  "model": {
    "steps": [
      {
        "when": {
          "contains": "SKILL_E2E_BODY"
        },
        "text": [
          "INVENTORY_E2E_DONE"
        ]
      },
      {
        "when": {
          "contains": "SKILL_E2E_BODY"
        },
        "text": [
          "INVENTORY_E2E_PTY_DONE"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "headless",
      "text": "/inventory Report the exact instruction and skill markers supplied in your context.",
      "answer": "INVENTORY_E2E_DONE"
    },
    {
      "mode": "pty",
      "actions": [
        {
          "send": "\u001b[200~/inven\u001b[201~",
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          }
        },
        {
          "send": "\t",
          "when": {
            "contains": [
              "Completions",
              "/inventory"
            ]
          }
        },
        {
          "send": "Report the exact instruction and skill markers supplied in your context.\r",
          "when": {
            "absent": [
              "Completions"
            ],
            "contains": [
              "/inventory "
            ],
            "cursor": true
          }
        },
        {
          "when": {
            "contains": [
              "INVENTORY_E2E_PTY_DONE",
              "○"
            ]
          },
          "detach": true
        }
      ]
    }
  ],
  "assert": {
    "requests": 2,
    "last_model_contains": [
      "AGENTS_E2E_INSTRUCTION",
      "CLAUDE_E2E_INSTRUCTION",
      "SKILL_E2E_BODY",
      "Report the exact instruction and skill markers supplied in your context."
    ],
    "model_absent": [
      "$ARGUMENTS"
    ]
  }
}
