{
  "id": "child-conflict",
  "workspace": {
    "kind": "git",
    "files": {
      "seed.txt": "base\n"
    }
  },
  "model": {
    "steps": [
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "capture-common-base",
            "name": "fs",
            "arguments": {
              "command": "status"
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "spawn",
            "name": "spawn",
            "arguments": {
              "name": "worker",
              "task": "CHILD_INITIAL",
              "role": "worker"
            }
          }
        ]
      },
      {
        "when": {
          "user": "CHILD_INITIAL"
        },
        "text": [
          "CHILD_READY"
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "initial-wait",
            "name": "wait",
            "arguments": {
              "agents": [
                "worker"
              ]
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK",
          "tool_result": "CHILD_READY"
        },
        "tools": [
          {
            "id": "parent-write",
            "name": "write",
            "arguments": {
              "path": "seed.txt",
              "content": "parent\n"
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "start-child",
            "name": "send",
            "arguments": {
              "agent": "worker",
              "message": "CHILD_WRITE_CONFLICT",
              "delivery": "follow_up"
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "conflict-wait",
            "name": "wait",
            "arguments": {
              "agents": [
                "worker"
              ]
            }
          }
        ]
      },
      {
        "when": {
          "user": "CHILD_WRITE_CONFLICT"
        },
        "tools": [
          {
            "id": "child-write",
            "name": "write",
            "arguments": {
              "path": "seed.txt",
              "content": "child\n"
            }
          }
        ]
      },
      {
        "when": {
          "user": "CHILD_WRITE_CONFLICT",
          "tool_result": "file"
        },
        "text": [
          "CHILD_CONFLICT_DONE"
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK",
          "tool_result": "CHILD_CONFLICT_DONE"
        },
        "tools": [
          {
            "id": "inspect-conflict",
            "name": "code",
            "arguments": {
              "code": "const result=await tools.shell({command:['node','-e',\"process.stdout.write(require('fs').readFileSync('seed.txt','utf8'))\"]}); if(!result.success||result.exit_code!==0||!result.text.includes('<<<<<<<'))throw Error('conflict projection missing: '+JSON.stringify(result)); export default {verified:'CONFLICT_PROJECTED'};"
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK",
          "tool_result": "CONFLICT_PROJECTED"
        },
        "tools": [
          {
            "id": "spawn-later",
            "name": "spawn",
            "arguments": {
              "name": "later",
              "task": "LATER_WORKER",
              "role": "worker"
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "join-later",
            "name": "wait",
            "arguments": {
              "agents": [
                "worker",
                "later"
              ]
            }
          }
        ]
      },
      {
        "when": {
          "user": "LATER_WORKER"
        },
        "tools": [
          {
            "id": "later-write",
            "name": "write",
            "arguments": {
              "path": "later.txt",
              "content": "later\n"
            }
          }
        ]
      },
      {
        "when": {
          "user": "LATER_WORKER",
          "tool_result": "file"
        },
        "text": [
          "LATER_DONE"
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK",
          "tool_result": "LATER_DONE"
        },
        "tools": [
          {
            "id": "resolve",
            "name": "write",
            "arguments": {
              "path": "seed.txt",
              "content": "resolved\n"
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "resolved-add",
            "name": "fs",
            "arguments": {
              "command": "add seed.txt"
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "continue",
            "name": "fs",
            "arguments": {
              "command": "merge --continue"
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "verify-later-publication",
            "name": "code",
            "arguments": {
              "code": "const result=await tools.shell({command:['node','-e',\"if(require('fs').readFileSync('later.txt','utf8')!=='later'+String.fromCharCode(10))process.exit(1)\"]}); if(!result.success||result.exit_code!==0)throw Error('deferred child work missing: '+JSON.stringify(result)); export default {verified:'LATER_IN_PARENT_WORKSPACE'};"
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "follow-up",
            "name": "send",
            "arguments": {
              "agent": "worker",
              "message": "CHILD_AFTER_CONFLICT",
              "delivery": "follow_up"
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "follow-up-wait",
            "name": "wait",
            "arguments": {
              "agents": [
                "worker"
              ]
            }
          }
        ]
      },
      {
        "when": {
          "user": "CHILD_AFTER_CONFLICT"
        },
        "text": [
          "CHILD_STILL_ALIVE"
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK",
          "tool_result": "CHILD_STILL_ALIVE"
        },
        "text": [
          "done"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "headless",
      "text": "PARENT_E2E_TASK",
      "answer": "done"
    }
  ],
  "assert": {
    "requests": 22,
    "files": {
      "seed.txt": "resolved\n",
      "later.txt": "later\n"
    },
    "tool_contains": [
      "CONFLICT_PROJECTED",
      "CHILD_CONFLICT_DONE",
      "CHILD_STILL_ALIVE",
      "LATER_DONE",
      "LATER_IN_PARENT_WORKSPACE"
    ]
  },
  "ntfs": true,
  "physical": true
}
