{
  "id": "compaction-background",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "capacity": {
    "context_tokens": 24576,
    "output_tokens": 8192
  },
  "model": {
    "bytes_per_token": 4,
    "steps": [
      {
        "when": {
          "contains": "Summarize the preceding context for the continuing worker."
        },
        "text": [
          "BACKGROUND_SAVED_FACT"
        ]
      },
      {
        "when": {
          "user": "remember BACKGROUND_FACT"
        },
        "text": [
          " BACKGROUND_FIRST_DONE"
        ]
      },
      {
        "when": {
          "user": "continue BACKGROUND_FACT"
        },
        "tools": [
          {
            "id": "recent",
            "name": "spawn",
            "arguments": {
              "task": "BACKGROUND_RECENT_TASK ",
              "name": "recent",
              "role": "advisor"
            }
          }
        ]
      },
      {
        "when": {
          "user": "BACKGROUND_RECENT_TASK"
        },
        "text": [
          "BACKGROUND_RECENT_CHILD_DONE"
        ]
      },
      {
        "when": {
          "tool_result": "recent",
          "user": "continue BACKGROUND_FACT",
          "contains": "BACKGROUND_SAVED_FACT"
        },
        "tools": [
          {
            "id": "wait",
            "name": "wait",
            "arguments": {
              "agents": [
                "recent"
              ]
            }
          }
        ]
      },
      {
        "when": {
          "contains": "BACKGROUND_SAVED_FACT",
          "tool_result": "BACKGROUND_RECENT_CHILD_DONE"
        },
        "text": [
          "BACKGROUND_DONE"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "remember BACKGROUND_FACT "
        },
        {
          "when": {
            "contains": [
              "BACKGROUND_FIRST_DONE",
              "○"
            ]
          },
          "prompt": "continue BACKGROUND_FACT BACKGROUND_CURRENT_TASK "
        },
        {
          "when": {
            "contains": [
              "BACKGROUND_DONE",
              "○",
              "context ≤"
            ]
          },
          "send": "\u0004\u0004"
        }
      ]
    }
  ],
  "assert": {
    "requests": 6,
    "last_model_contains": [
      "BACKGROUND_CURRENT_TASK",
      "BACKGROUND_SAVED_FACT",
      "yyyyyyyyyyyyyyyy",
      "BACKGROUND_RECENT_CHILD_DONE"
    ],
    "last_model_absent": [
      "xxxxxxxxxxxxxxxx",
      "Summarize the preceding context"
    ]
  }
}
