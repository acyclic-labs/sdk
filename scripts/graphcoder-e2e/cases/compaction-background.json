{
  "id": "compaction-background",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "capacity": {
    "context_tokens": 24576,
    "output_tokens": 8192
  },
  "model": {
    "bytes_per_token": 4,
    "steps": [
      {
        "when": {
          "contains": "You manage this worker's context outside its turns."
        },
        "text": [
          "{\"version\":1,\"summary\":\"BACKGROUND_SAVED_FACT\",\"review_at_input_tokens\":18000}"
        ]
      },
      {
        "when": {
          "user": "remember BACKGROUND_FACT"
        },
        "text": [
          " BACKGROUND_FIRST_DONE"
        ]
      },
      {
        "when": {
          "user": "continue BACKGROUND_FACT"
        },
        "tools": [
          {
            "id": "recent",
            "name": "spawn",
            "arguments": {
              "task": "BACKGROUND_RECENT_TASK ",
              "name": "recent",
              "role": "advisor"
            }
          }
        ]
      },
      {
        "when": {
          "user": "BACKGROUND_RECENT_TASK"
        },
        "text": [
          "BACKGROUND_RECENT_CHILD_DONE"
        ]
      },
      {
        "when": {
          "tool_result": "recent",
          "user": "continue BACKGROUND_FACT"
        },
        "tools": [
          {
            "id": "wait",
            "name": "wait",
            "arguments": {
              "agents": [
                "recent"
              ]
            }
          }
        ]
      },
      {
        "when": {
          "contains": "BACKGROUND_SAVED_FACT",
          "tool_result": "BACKGROUND_RECENT_CHILD_DONE"
        },
        "text": [
          "BACKGROUND_DONE"
        ]
      },
      {
        "when": {
          "user": "remember BACKGROUND_FACT",
          "contains": "What slowed you down or blocked you? Append feedback records; reply none if nothing."
        },
        "text": ["none"]
      },
      {
        "when": {
          "user": "BACKGROUND_RECENT_TASK",
          "contains": "What slowed you down or blocked you? Append feedback records; reply none if nothing."
        },
        "text": ["none"]
      },
      {
        "when": {
          "user": "continue BACKGROUND_FACT",
          "tool_result": "BACKGROUND_RECENT_CHILD_DONE",
          "contains": "What slowed you down or blocked you? Append feedback records; reply none if nothing."
        },
        "text": ["none"]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "remember BACKGROUND_FACT "
        },
        {
          "when": {
            "contains": [
              "BACKGROUND_FIRST_DONE",
              "○"
            ]
          },
          "prompt": "continue BACKGROUND_FACT BACKGROUND_CURRENT_TASK "
        },
        {
          "when": {
            "contains": [
              "BACKGROUND_DONE",
              "○",
              "context ≤"
            ]
          },
          "detach": true
        }
      ]
    }
  ],
  "assert": {
    "requests": 9,
    "last_model_contains": [
      "BACKGROUND_CURRENT_TASK",
      "BACKGROUND_SAVED_FACT",
      "yyyyyyyyyyyyyyyy",
      "BACKGROUND_RECENT_CHILD_DONE"
    ],
    "last_model_absent": [
      "xxxxxxxxxxxxxxxx",
      "You manage this worker's context outside its turns."
    ]
  }
}
