{
  "id": "pty-diff-folder-replace",
  "workspace": {
    "kind": "plain",
    "files": {
      ".fixtures/fs.exe": {
        "binary_env": "E2E_FILESYSTEM_BINARY"
      },
      ".fixtures/operation-0.json": "[{\"op\":\"remove_file\",\"path\":\"folder/a.txt\"},{\"op\":\"remove_directory\",\"path\":\"folder\"},{\"op\":\"write\",\"path\":\"folder\",\"text\":\"REPLACED_E2E\\n\"}]",
      "folder/a.txt": "FOLDER_BASE_E2E\n"
    }
  },
  "model": {
    "steps": [
      {
        "tools": [
          {
            "id": "edit",
            "name": "write",
            "arguments": {
              "path": "folder/a.txt",
              "content": "FOLDER_EDIT_E2E\n"
            }
          }
        ]
      },
      {
        "text": [
          "FOLDER_EDIT_READY"
        ]
      },
      {
        "when": {
          "user": "replace folder"
        },
        "tools": [
          {
            "id": "replace",
            "name": "shell",
            "arguments": {
              "command": "./.fixtures/fs.exe .fixtures/operation-0.json"
            }
          }
        ]
      },
      {
        "text": [
          "FOLDER_CHANGE_READY"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "service"
    },
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "edit folder content"
        },
        {
          "when": {
            "contains": [
              "FOLDER_EDIT_READY",
              "○"
            ]
          },
          "prompt": "/diff "
        },
        {
          "when": {
            "contains": [
              "folder/a.txt (modified)",
              "+FOLDER_EDIT_E2E"
            ]
          },
          "prompt": "replace folder"
        },
        {
          "when": {
            "contains": [
              "FOLDER_CHANGE_READY",
              "○"
            ],
            "new_contains": [
              [
                "folder (added)",
                "+REPLACED_E2E"
              ],
              [
                "folder/a.txt (removed)",
                "-FOLDER_BASE_E2E"
              ]
            ]
          },
          "send": "\u001b[6~"
        },
        {
          "when": {
            "new_contains": [
              [
                "folder (added)",
                "+REPLACED_E2E"
              ],
              [
                "folder/a.txt (removed)",
                "-FOLDER_BASE_E2E"
              ]
            ]
          },
          "detach": true
        }
      ]
    },
    {
      "mode": "pty",
      "resume": true,
      "actions": [
        {
          "when": {
            "new_contains": [
              [
                "folder (added)",
                "+REPLACED_E2E"
              ],
              [
                "folder/a.txt (removed)",
                "-FOLDER_BASE_E2E"
              ]
            ]
          },
          "send": "\u001b[6~"
        },
        {
          "when": {
            "new_contains": [
              [
                "folder (added)",
                "+REPLACED_E2E"
              ],
              [
                "folder/a.txt (removed)",
                "-FOLDER_BASE_E2E"
              ]
            ]
          },
          "prompt": "/merge "
        },
        {
          "when": {
            "contains": [
              "Merged into checkout:"
            ]
          },
          "detach": true
        }
      ]
    }
  ],
  "assert": {
    "requests": 4,
    "files": {
      "folder": "REPLACED_E2E\n"
    },
    "absent_files": [
      "folder/a.txt"
    ]
  }
}
