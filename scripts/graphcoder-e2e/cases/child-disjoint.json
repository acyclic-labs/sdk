{
  "id": "child-disjoint",
  "workspace": {
    "kind": "git",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "spawn",
            "name": "spawn",
            "arguments": {
              "name": "worker",
              "task": "CHILD_E2E_TASK"
            }
          }
        ]
      },
      {
        "when": {
          "user": "CHILD_E2E_TASK"
        },
        "tools": [
          {
            "id": "child-write",
            "name": "write",
            "arguments": {
              "path": "child.txt",
              "content": "child\n"
            }
          }
        ]
      },
      {
        "when": {
          "user": "CHILD_E2E_TASK",
          "tool_result": "file"
        },
        "text": [
          "child finished"
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "parent-write",
            "name": "write",
            "arguments": {
              "path": "parent.txt",
              "content": "parent\n"
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "wait",
            "name": "wait",
            "arguments": {
              "agents": [
                "worker"
              ]
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK",
          "tool_result": "child finished"
        },
        "tools": [
          {
            "id": "child-merge",
            "name": "fs",
            "arguments": {
              "command": "merge {{tool_result:/settled/0/branch}}"
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "archive",
            "name": "archive",
            "arguments": {
              "agent": "worker"
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "archive-wait",
            "name": "wait",
            "arguments": {
              "agents": [
                "worker"
              ]
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "tools": [
          {
            "id": "child-diff",
            "name": "fs",
            "arguments": {
              "command": "diff agents/worker"
            }
          }
        ]
      },
      {
        "when": {
          "user": "PARENT_E2E_TASK"
        },
        "text": [
          "done"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "headless",
      "text": "PARENT_E2E_TASK",
      "answer": "done"
    }
  ],
  "assert": {
    "requests": 10,
    "files": {
      "child.txt": "child\n",
      "parent.txt": "parent\n"
    },
    "tool_results": [
      {
        "settled": [
          {
            "name": "worker",
            "branch": "agents/worker",
            "answer": "child finished"
          }
        ]
      }
    ]
  },
  "ntfs": true
}
