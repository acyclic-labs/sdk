{
  "id": "pty-markdown",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "text": [
          "streaming ",
          "**test answer**"
        ]
      },
      {
        "when": {
          "contains": "What slowed you down or blocked you? Append feedback records; reply none if nothing."
        },
        "text": ["none"]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "hello"
        },
        {
          "when": {
            "contains": [
              "test answer",
              "\u25cb"
            ],
            "bold": "test answer",
            "absent": [
              "**test answer**"
            ]
          },
          "after_request": { "path": "responses", "step": 1 },
          "detach": true
        }
      ]
    }
  ],
  "assert": {
    "requests": 2
  }
}
