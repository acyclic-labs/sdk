{
  "id": "pty-markdown",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "text": [
          "streaming ",
          "**test answer**"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "graphcoder"
            ],
            "cursor": true
          },
          "prompt": "hello"
        },
        {
          "when": {
            "contains": [
              "test answer",
              "Enter sends"
            ],
            "bold": "test answer",
            "absent": [
              "**test answer**"
            ]
          },
          "send": "\u0004"
        }
      ]
    }
  ],
  "assert": {
    "requests": 1
  }
}
