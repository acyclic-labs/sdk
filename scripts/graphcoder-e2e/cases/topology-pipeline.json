{
  "id": "topology-pipeline",
  "workspace": {"kind":"plain","files":{}},
  "model": { "steps": [
    {"when":{"user":"TOPOLOGY_PIPELINE_ROOT"},"tools":[{"id":"spawn-coordinator","name":"spawn","arguments":{"name":"coordinator","task":"TOPOLOGY_PIPELINE_COORDINATE","role":"pipeline"}}]},
    {"when":{"user":"TOPOLOGY_PIPELINE_ROOT","tool_result":"agent"},"tools":[{"id":"wait-coordinator","name":"wait","arguments":{"agents":["coordinator"]}}]},
    {"when":{"user":"TOPOLOGY_PIPELINE_COORDINATE","contains":"Coordinate a pipeline"},"tools":[{"id":"spawn-extract","name":"spawn","arguments":{"name":"extract","task":"PIPELINE_EXTRACT: report the original source claim.","role":"worker"}}]},
    {"when":{"user":"PIPELINE_EXTRACT"},"text":["PIPELINE_CLAIM_47"]},
    {"when":{"user":"TOPOLOGY_PIPELINE_COORDINATE","tool_result":"agent"},"tools":[{"id":"wait-extract","name":"wait","arguments":{"agents":["extract"]}}]},
    {"when":{"user":"TOPOLOGY_PIPELINE_COORDINATE","tool_result":"PIPELINE_CLAIM_47"},"tools":[{"id":"spawn-verify","name":"spawn","arguments":{"name":"verify","task":"PIPELINE_VERIFY: verify the original extract report: {{tool_result:/settled/0/answer}}","role":"reviewer"}}]},
    {"when":{"user":"PIPELINE_VERIFY","contains":"PIPELINE_CLAIM_47"},"text":["PIPELINE_VERIFIED_47"]},
    {"when":{"user":"TOPOLOGY_PIPELINE_COORDINATE","tool_result":"agent"},"tools":[{"id":"wait-verify","name":"wait","arguments":{"agents":["verify"]}}]},
    {"when":{"user":"TOPOLOGY_PIPELINE_COORDINATE","tool_result":"PIPELINE_VERIFIED_47"},"text":["TOPOLOGY_PIPELINE_DONE"]},
    {"when":{"user":"TOPOLOGY_PIPELINE_ROOT","tool_result":"TOPOLOGY_PIPELINE_DONE"},"text":["{{tool_result:/settled/0/answer}}"]}
  ] },
  "inputs": [{"mode":"headless","text":"TOPOLOGY_PIPELINE_ROOT","answer":"TOPOLOGY_PIPELINE_DONE"}],
  "assert": {"requests":10,"model_contains":["Coordinate a pipeline"],"tool_contains":["PIPELINE_CLAIM_47","PIPELINE_VERIFIED_47"],"tool_results":[{"settled":[{"phase":"idle","answer":"TOPOLOGY_PIPELINE_DONE"}],"running":[]}]}
}
