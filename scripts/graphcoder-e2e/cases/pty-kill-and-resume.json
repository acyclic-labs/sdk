{
  "id": "pty-kill-and-resume",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "text": [
          "RECOVERED_E2E"
        ],
        "hold": true
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "killed": true,
      "actions": [
        {
          "when": {
            "contains": [
              "graphcoder"
            ],
            "cursor": true
          },
          "prompt": "recover this conversation"
        },
        {
          "when": {
            "contains": [
              "RECOVERED_E2E"
            ]
          },
          "kill": true
        }
      ]
    },
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "task_failure": "model provider unavailable (co",
            "contains": [
              "RECOVERED_E2E"
            ]
          },
          "send": "\u0004"
        }
      ],
      "resume": true,
      "exit": 1
    }
  ],
  "assert": {
    "requests": 1,
    "model_contains": [
      "recover this conversation"
    ]
  }
}
