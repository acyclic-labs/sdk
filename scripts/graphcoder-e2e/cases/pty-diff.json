{
  "id": "pty-diff",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "when": {},
        "tools": [
          {
            "id": "change",
            "name": "write",
            "arguments": {
              "path": "diff.txt",
              "text": "DIFF_E2E_CONTENT\n",
              "media_type": "text/plain",
              "display_name": "diff.txt"
            }
          }
        ]
      },
      {
        "when": {},
        "text": [
          "DONE_EDIT"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "edit a file"
        },
        {
          "when": {
            "contains": [
              "DONE_EDIT",
              "○"
            ]
          },
          "prompt": "/diff "
        },
        {
          "when": {
            "contains": [
              "diff.txt (added) +1 -0",
              "+DIFF_E2E_CONTENT"
            ]
          },
          "send": "\u0004"
        }
      ]
    },
    {
      "actions": [
        {
          "prompt": "/diff ",
          "when": {
            "contains": [
              "GraphCoder",
              "DONE_EDIT"
            ],
            "cursor": true
          }
        },
        {
          "send": "\u0004",
          "when": {
            "contains": [
              "diff.txt (added) +1 -0",
              "+DIFF_E2E_CONTENT"
            ]
          }
        }
      ],
      "resume": true,
      "mode": "pty"
    }
  ],
  "assert": {
    "requests": 2,
    "files": {
      "diff.txt": "DIFF_E2E_CONTENT\n"
    }
  }
}
