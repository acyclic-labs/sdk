{
  "id": "topology-blackboard",
  "workspace": {"kind":"plain","files":{}},
  "model": { "steps": [
    {"when":{"user":"TOPOLOGY_BLACKBOARD_ROOT"},"tools":[{"id":"spawn-coordinator","name":"spawn","arguments":{"name":"coordinator","task":"TOPOLOGY_BLACKBOARD_COORDINATE","role":"blackboard"}}]},
    {"when":{"user":"TOPOLOGY_BLACKBOARD_ROOT","tool_result":"agent"},"tools":[{"id":"wait-coordinator","name":"wait","arguments":{"agents":["coordinator"]}}]},
    {"when":{"user":"TOPOLOGY_BLACKBOARD_COORDINATE","contains":"Coordinate a blackboard"},"tools":[{"id":"spawn-facts","name":"spawn","arguments":{"name":"facts","task":"BOARD_FACTS: supply a fact with its source.","role":"worker"}},{"id":"spawn-risks","name":"spawn","arguments":{"name":"risks","task":"BOARD_RISKS: supply a risk with its source.","role":"reviewer"}}]},
    {"when":{"user":"BOARD_FACTS"},"text":["BOARD_ORIGINAL_FACT"]},
    {"when":{"user":"BOARD_RISKS"},"text":["BOARD_ORIGINAL_RISK"]},
    {"when":{"user":"TOPOLOGY_BLACKBOARD_COORDINATE","tool_result":"agent"},"tools":[{"id":"wait-facts-risks","name":"wait","arguments":{"agents":["facts","risks"]}}]},
    {"when":{"user":"TOPOLOGY_BLACKBOARD_COORDINATE","tool_result":"BOARD_ORIGINAL_RISK"},"tools":[{"id":"write-board","name":"write","arguments":{"path":".volumes/home/board.md","content":"facts: {{tool_result:/settled/0/answer}}\nrisks: {{tool_result:/settled/1/answer}}\nstatus: draft\n"}}]},
    {"when":{"user":"TOPOLOGY_BLACKBOARD_COORDINATE","tool_result":"version"},"tools":[{"id":"edit-board","name":"edit","arguments":{"path":".volumes/home/board.md","version":{"$tool_result":"/version"},"old_text":"status: draft","new_text":"status: reviewed"}}]},
    {"when":{"user":"TOPOLOGY_BLACKBOARD_COORDINATE","tool_result":"version"},"tools":[{"id":"read-board","name":"read","arguments":{"path":".volumes/home/board.md","version":{"$tool_result":"/version"}}}]},
    {"when":{"user":"TOPOLOGY_BLACKBOARD_COORDINATE","tool_result":"status: reviewed"},"text":["TOPOLOGY_BLACKBOARD_DONE"]},
    {"when":{"user":"TOPOLOGY_BLACKBOARD_ROOT","tool_result":"TOPOLOGY_BLACKBOARD_DONE"},"text":["{{tool_result:/settled/0/answer}}"]}
  ] },
  "inputs": [{"mode":"headless","text":"TOPOLOGY_BLACKBOARD_ROOT","answer":"TOPOLOGY_BLACKBOARD_DONE"}],
  "assert": {"requests":11,"model_contains":["Coordinate a blackboard"],"tool_contains":["BOARD_ORIGINAL_FACT","BOARD_ORIGINAL_RISK","status: reviewed"],"tool_results":[{"path":".volumes/home/board.md","text":"facts: BOARD_ORIGINAL_FACT\nrisks: BOARD_ORIGINAL_RISK\nstatus: reviewed\n"}]}
}
