{
  "id": "topology-blackboard",
  "workspace": {"kind":"plain","files":{}},
  "model": { "steps": [
    {"when":{"user":"TOPOLOGY_BLACKBOARD_ROOT"},"tools":[{"id":"spawn-coordinator","name":"spawn","arguments":{"name":"coordinator","task":"TOPOLOGY_BLACKBOARD_COORDINATE","role":"blackboard"}}]},
    {"when":{"user":"TOPOLOGY_BLACKBOARD_ROOT","tool_result":"agent"},"tools":[{"id":"wait-coordinator","name":"wait","arguments":{"agents":["coordinator"]}}]},
    {"when":{"user":"TOPOLOGY_BLACKBOARD_COORDINATE","contains":"Coordinate a blackboard"},"tools":[{"id":"spawn-facts","name":"spawn","arguments":{"name":"facts","task":"BOARD_FACTS: publish a fact with its source in the shared board.","role":"worker"}}]},
    {"when":{"user":"BOARD_FACTS"},"tools":[{"id":"write-board","name":"write","arguments":{"path":".volumes/shared/board.md","content":"facts: BOARD_ORIGINAL_FACT\nrisks: pending\nstatus: draft\n"}}]},
    {"when":{"user":"BOARD_FACTS","tool_result":"version"},"text":["BOARD_ORIGINAL_FACT"]},
    {"when":{"user":"TOPOLOGY_BLACKBOARD_COORDINATE","tool_result":"agent"},"tools":[{"id":"wait-facts","name":"wait","arguments":{"agents":["facts"]}}]},
    {"when":{"user":"TOPOLOGY_BLACKBOARD_COORDINATE","tool_result":"BOARD_ORIGINAL_FACT"},"tools":[{"id":"spawn-risks","name":"spawn","arguments":{"name":"risks","task":"BOARD_RISKS: retain the published fact, add the risk, and reject an obsolete board version.","role":"reviewer"}}]},
    {"when":{"user":"TOPOLOGY_BLACKBOARD_COORDINATE","tool_result":"agent"},"tools":[{"id":"wait-risks","name":"wait","arguments":{"agents":["risks"]}}]},
    {"when":{"user":"BOARD_RISKS"},"tools":[{"id":"read-fact","name":"read","arguments":{"path":".volumes/shared/board.md"}}]},
    {"when":{"user":"BOARD_RISKS","tool_result":"BOARD_ORIGINAL_FACT"},"tools":[{"id":"add-risk","name":"edit","arguments":{"path":".volumes/shared/board.md","version":{"$tool_result":"/version"},"old_text":"risks: pending","new_text":"risks: BOARD_ORIGINAL_RISK"}}]},
    {"when":{"user":"BOARD_RISKS","tool_result":"version"},"tools":[{"id":"review-board","name":"edit","arguments":{"path":".volumes/shared/board.md","version":{"$tool_result":"/version"},"old_text":"status: draft","new_text":"status: reviewed"}},{"id":"stale-board","name":"edit","arguments":{"path":".volumes/shared/board.md","version":{"$tool_result":"/version"},"old_text":"facts: BOARD_ORIGINAL_FACT","new_text":"facts: CORRUPTED"}}]},
    {"when":{"user":"BOARD_RISKS","tool_result":"conflict"},"tools":[{"id":"read-reviewed","name":"read","arguments":{"path":".volumes/shared/board.md"}}]},
    {"when":{"user":"BOARD_RISKS","tool_result":"status: reviewed"},"text":["BOARD_ORIGINAL_RISK"]},
    {"when":{"user":"TOPOLOGY_BLACKBOARD_COORDINATE","tool_result":"BOARD_ORIGINAL_RISK"},"tools":[{"id":"read-board","name":"read","arguments":{"path":".volumes/shared/board.md"}}]},
    {"when":{"user":"TOPOLOGY_BLACKBOARD_COORDINATE","tool_result":"status: reviewed"},"text":["TOPOLOGY_BLACKBOARD_DONE"]},
    {"when":{"user":"TOPOLOGY_BLACKBOARD_ROOT","tool_result":"TOPOLOGY_BLACKBOARD_DONE"},"text":["{{tool_result:/settled/0/answer}}"]},
    {"when":{"user":"TOPOLOGY_BLACKBOARD_REOPEN"},"tools":[{"id":"spawn-reader","name":"spawn","arguments":{"name":"reader","task":"BOARD_REOPEN_READER: read the retained shared board.","role":"blackboard"}}]},
    {"when":{"user":"TOPOLOGY_BLACKBOARD_REOPEN","tool_result":"agent"},"tools":[{"id":"wait-reader","name":"wait","arguments":{"agents":["reader"]}}]},
    {"when":{"user":"BOARD_REOPEN_READER","contains":"Coordinate a blackboard"},"tools":[{"id":"read-retained-board","name":"read","arguments":{"path":".volumes/shared/board.md"}}]},
    {"when":{"user":"BOARD_REOPEN_READER","tool_result":"status: reviewed"},"text":["TOPOLOGY_BLACKBOARD_REOPEN_DONE"]},
    {"when":{"user":"TOPOLOGY_BLACKBOARD_REOPEN","tool_result":"TOPOLOGY_BLACKBOARD_REOPEN_DONE"},"text":["{{tool_result:/settled/0/answer}}"]}
  ] },
  "inputs": [{"mode":"headless","text":"TOPOLOGY_BLACKBOARD_ROOT","answer":"TOPOLOGY_BLACKBOARD_DONE"},{"mode":"headless","operation":"00000000-0000-0000-0000-000000000002","text":"TOPOLOGY_BLACKBOARD_REOPEN","answer":"TOPOLOGY_BLACKBOARD_REOPEN_DONE"}],
  "assert": {"requests":21,"model_contains":["Coordinate a blackboard"],"tool_contains":["BOARD_ORIGINAL_FACT","BOARD_ORIGINAL_RISK","status: reviewed","conflict","session_shared"],"tool_errors":["conflict"],"tool_results":[{"path":".volumes/shared/board.md","text":"facts: BOARD_ORIGINAL_FACT\nrisks: BOARD_ORIGINAL_RISK\nstatus: reviewed\n"}]}
}
