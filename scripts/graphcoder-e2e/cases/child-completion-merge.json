{
  "id": "child-completion-merge",
  "workspace": {
    "kind": "git",
    "files": {
      "root.txt": "ROOT_KEPT\n",
      ".fixtures/fs.exe": { "binary_env": "E2E_FILESYSTEM_BINARY" },
      ".fixtures/write-child.json": "[{\"op\":\"write\",\"path\":\"child.txt\",\"text\":\"CHILD_COMPLETION_CONTENT\\n\"}]",
      ".fixtures/read-parent.json": "[{\"op\":\"read\",\"path\":\"child.txt\"},{\"op\":\"read\",\"path\":\"root.txt\"}]",
      ".acyclic-sdk/control": "SDK_STATE\n"
    }
  },
  "model": {
    "steps": [
      {
        "when": {
          "user": "COMPLETION_PARENT"
        },
        "tools": [
          {
            "id": "spawn",
            "name": "spawn",
            "arguments": {
              "name": "worker",
              "task": "COMPLETION_CHILD",
              "role": "worker",
              "model": "e2e/tiny"
            }
          }
        ]
      },
      {
        "when": {
          "user": "COMPLETION_PARENT",
          "tool_result": "agent"
        },
        "tools": [
          {
            "id": "join",
            "name": "wait",
            "arguments": {
              "agents": [
                "worker"
              ]
            }
          }
        ]
      },
      {
        "when": {
          "user": "COMPLETION_CHILD"
        },
        "tools": [
          {
            "id": "write-child",
            "name": "code",
            "arguments": {
              "code": "const result = await tools.shell({command:['./.fixtures/fs.exe','.fixtures/write-child.json']}); if (!result.success || result.exit_code !== 0) throw Error('child write failed: '+JSON.stringify(result)); export default {written:'CHILD_WRITE_OK'}"
            }
          }
        ]
      },
      {
        "when": {
          "user": "COMPLETION_CHILD",
          "tool_result": "CHILD_WRITE_OK"
        },
        "text": [
          "CHILD_COMPLETED"
        ]
      },
      {
        "when": {
          "user": "COMPLETION_PARENT",
          "tool_result": "CHILD_COMPLETED"
        },
        "tools": [
          {
            "id": "verify-parent",
            "name": "code",
            "arguments": {
              "code": "const result = await tools.shell({command:['./.fixtures/fs.exe','.fixtures/read-parent.json']}); if (!result.success || result.exit_code !== 0) throw Error('parent read failed: '+JSON.stringify(result)); const newline=String.fromCharCode(10); const [child,root] = result.stdout.trimEnd().split(newline).map(JSON.parse); if (child !== 'CHILD_COMPLETION_CONTENT'+newline || root !== 'ROOT_KEPT'+newline) throw Error('child completion did not publish into parent: '+JSON.stringify(result)); export default {verified:'PARENT_HAS_CHILD_WORK'}"
            }
          }
        ]
      },
      {
        "when": {
          "user": "COMPLETION_PARENT",
          "tool_result": "PARENT_HAS_CHILD_WORK"
        },
        "text": [
          "COMPLETION_MERGED"
        ]
      }
    ]
  },
  "inputs": [
    { "mode": "service" },
    {
      "mode": "headless",
      "text": "COMPLETION_PARENT",
      "answer": "COMPLETION_MERGED"
    }
  ],
  "assert": {
    "requests": 6,
    "files": {
      "child.txt": "CHILD_COMPLETION_CONTENT\n",
      "root.txt": "ROOT_KEPT\n"
    }
  },
  "physical": true,
  "adapter": "responses"
}
