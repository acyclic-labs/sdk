{
  "id": "child-completion-merge",
  "workspace": {
    "kind": "git",
    "files": {
      "root.txt": "ROOT_KEPT\n",
      ".acyclic-sdk/control": "SDK_STATE\n"
    }
  },
  "model": {
    "steps": [
      {
        "when": {
          "user": "COMPLETION_PARENT"
        },
        "tools": [
          {
            "id": "spawn",
            "name": "spawn",
            "arguments": {
              "name": "worker",
              "task": "COMPLETION_CHILD",
              "role": "worker",
              "model": "e2e/tiny"
            }
          }
        ]
      },
      {
        "when": {
          "user": "COMPLETION_PARENT",
          "tool_result": "agent"
        },
        "tools": [
          {
            "id": "join",
            "name": "wait",
            "arguments": {
              "agents": [
                "worker"
              ]
            }
          }
        ]
      },
      {
        "when": {
          "user": "COMPLETION_CHILD"
        },
        "tools": [
          {
            "id": "write-child",
            "name": "code",
            "arguments": {
              "code": "const result = await tools.shell({command:['node','-e',\"require('fs').writeFileSync('child.txt','CHILD_COMPLETION_CONTENT' + String.fromCharCode(10))\"]}); if (!result.success || result.exit_code !== 0) throw Error('child write failed: '+JSON.stringify(result)); export default {written:'CHILD_WRITE_OK'}"
            }
          }
        ]
      },
      {
        "when": {
          "user": "COMPLETION_CHILD",
          "tool_result": "CHILD_WRITE_OK"
        },
        "text": [
          "CHILD_COMPLETED"
        ]
      },
      {
        "when": {
          "user": "COMPLETION_PARENT",
          "tool_result": "CHILD_COMPLETED"
        },
        "tools": [
          {
            "id": "verify-parent",
            "name": "code",
            "arguments": {
              "code": "const result = await tools.shell({command:['node','-e',\"const fs=require('fs');if(fs.readFileSync('child.txt','utf8')!=='CHILD_COMPLETION_CONTENT' + String.fromCharCode(10)||fs.readFileSync('root.txt','utf8')!=='ROOT_KEPT' + String.fromCharCode(10))process.exit(1);console.log('PARENT_HAS_CHILD_WORK')\"]}); if (!result.success || result.exit_code !== 0 || !result.text.includes('PARENT_HAS_CHILD_WORK')) throw Error('child completion did not publish into parent: '+JSON.stringify(result)); export default {verified:'PARENT_HAS_CHILD_WORK'}"
            }
          }
        ]
      },
      {
        "when": {
          "user": "COMPLETION_PARENT",
          "tool_result": "PARENT_HAS_CHILD_WORK"
        },
        "text": [
          "COMPLETION_MERGED"
        ]
      }
    ]
  },
  "inputs": [
    { "mode": "service" },
    {
      "mode": "headless",
      "text": "COMPLETION_PARENT",
      "answer": "COMPLETION_MERGED"
    }
  ],
  "assert": {
    "requests": 6,
    "files": {
      "child.txt": "CHILD_COMPLETION_CONTENT\n",
      "root.txt": "ROOT_KEPT\n"
    }
  },
  "physical": true,
  "adapter": "responses"
}
