{
  "id": "child-completion-merge",
  "workspace": {
    "kind": "git",
    "files": {
      "root.txt": "ROOT_KEPT\n",
      ".fixtures/fs.exe": {
        "binary_env": "E2E_FILESYSTEM_BINARY"
      },
      ".fixtures/write-child.json": "[{\"op\":\"write\",\"path\":\"child.txt\",\"text\":\"CHILD_COMPLETION_CONTENT\\n\"}]",
      ".acyclic-sdk/control": "SDK_STATE\n",
      ".fixtures/write-second.json": "[{\"op\":\"write\",\"path\":\"second.txt\",\"text\":\"SECOND_COMPLETION_CONTENT\\n\"}]"
    }
  },
  "model": {
    "steps": [
      {
        "when": {
          "user": "COMPLETION_PARENT"
        },
        "tools": [
          {
            "id": "spawn",
            "name": "spawn",
            "arguments": {
              "name": "worker",
              "task": "COMPLETION_CHILD",
              "role": "worker",
              "model": "e2e/tiny"
            }
          },
          {
            "id": "spawn-second",
            "name": "spawn",
            "arguments": {
              "name": "second",
              "task": "COMPLETION_SECOND",
              "role": "worker",
              "model": "e2e/tiny"
            }
          }
        ]
      },
      {
        "when": {
          "user": "COMPLETION_PARENT",
          "tool_result": "agent"
        },
        "tools": [
          {
            "id": "join",
            "name": "wait",
            "arguments": {
              "agents": [
                "worker",
                "second"
              ]
            }
          }
        ]
      },
      {
        "when": {
          "user": "COMPLETION_CHILD"
        },
        "tools": [
          {
            "id": "write-child",
            "name": "code",
            "arguments": {
              "code": "const result = await tools.shell({command:['./.fixtures/fs.exe','.fixtures/write-child.json']}); if (!result.success || result.exit_code !== 0) throw Error('child write failed: '+JSON.stringify(result)); export default {written:'CHILD_WRITE_OK'}"
            }
          }
        ]
      },
      {
        "when": {
          "user": "COMPLETION_CHILD",
          "tool_result": "CHILD_WRITE_OK"
        },
        "text": [
          "CHILD_COMPLETED"
        ]
      },
      {
        "when": {
          "user": "COMPLETION_SECOND"
        },
        "tools": [
          {
            "id": "write-second",
            "name": "code",
            "arguments": {
              "code": "const result = await tools.shell({command:['./.fixtures/fs.exe','.fixtures/write-second.json']}); if (!result.success || result.exit_code !== 0) throw Error('child write failed: '+JSON.stringify(result)); export default {written:'CHILD_WRITE_OK'}"
            }
          }
        ]
      },
      {
        "when": {
          "user": "COMPLETION_SECOND",
          "tool_result": "CHILD_WRITE_OK"
        },
        "text": [
          "CHILD_COMPLETED"
        ]
      },
      {
        "when": {
          "user": "COMPLETION_PARENT",
          "tool_result": "CHILD_COMPLETED"
        },
        "text": [
          "COMPLETION_MERGED"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "service"
    },
    {
      "mode": "headless",
      "text": "COMPLETION_PARENT",
      "answer": "COMPLETION_MERGED"
    }
  ],
  "assert": {
    "requests": 7,
    "files": {
      "child.txt": "CHILD_COMPLETION_CONTENT\n",
      "root.txt": "ROOT_KEPT\n",
      "second.txt": "SECOND_COMPLETION_CONTENT\n"
    },
    "tool_results": [
      {
        "settled": [
          {
            "name": "worker",
            "answer": "CHILD_COMPLETED"
          },
          {
            "name": "second",
            "answer": "CHILD_COMPLETED"
          }
        ]
      }
    ],
    "jsonl": {
      ".acyclic-sdk/detail/agents.jsonl": [
        {
          "parent": null
        },
        {
          "role": "worker"
        }
      ]
    }
  },
  "physical": true,
  "adapter": "responses",
  "extra_args": [
    "--transcripts",
    "{{workspace}}/.acyclic-sdk/detail"
  ]
}
