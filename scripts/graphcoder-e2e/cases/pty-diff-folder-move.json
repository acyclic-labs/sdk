  "model": {
    "steps": [
      {
        "tools": [
          {
            "id": "edit",
            "name": "write",
            "arguments": {
              "path": "folder/a.txt",
              "content": "FOLDER_EDIT_E2E\n"
            }
          }
        ]
      },
      {
        "text": [
          "FOLDER_EDIT_READY"
        ]
      },
      {
        "when": {
          "user": "move folder"
        },
        "tools": [
          {
            "id": "move",
            "name": "shell",
            "arguments": {
              "command": "node -e \"require('node:fs').renameSync('folder', 'moved')\""
            }
          }
        ]
      },
      {
        "text": [
          "FOLDER_CHANGE_READY"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "edit folder content"
        },
        {
          "when": {
            "contains": [
              "FOLDER_EDIT_READY",
              "○"
            ]
          },
          "prompt": "/diff "
        },
        {
          "when": {
            "contains": [
              "folder/a.txt (modified)",
              "+FOLDER_EDIT_E2E"
            ]
          },
          "prompt": "move folder"
        },
        {
          "when": {
            "contains": [
              "folder/a.txt (removed)",
              "-FOLDER_BASE_E2E",
              "moved/a.txt (added)",
              "+FOLDER_EDIT_E2E",
              "FOLDER_CHANGE_READY",
              "○"
            ]
          },
          "send": "\u0004"
        }
      ]
    },
    {
      "mode": "pty",
      "resume": true,
      "actions": [
        {
          "when": {
            "contains": [
              "folder/a.txt (removed)",
              "-FOLDER_BASE_E2E",
              "moved/a.txt (added)",
              "+FOLDER_EDIT_E2E"
            ]
          },
          "send": "\u0004"
        }
      ]
    }
  ],
  "assert": {
    "requests": 4,
    "files": {
      "moved/a.txt": "FOLDER_EDIT_E2E\n"
    },
    "absent_files": [
      "folder/a.txt"
    ]
  }
}
