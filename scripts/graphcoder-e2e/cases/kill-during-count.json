{
  "id": "kill-during-count",
  "physical": true,
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "capacity": {
    "context_tokens": 4096,
    "output_tokens": 1024
  },
  "model": {
    "input_tokens": 64,
    "steps": [
      {
        "when": {
          "path": "count",
          "user": "count marker"
        },
        "json": {
          "input_tokens": 64
        },
        "hold": true
      },
      {
        "when": {
          "path": "responses",
          "user": "count marker"
        },
        "text": [
          "resumed"
        ]
      },
      {
        "when": {
          "path": "responses",
          "user": "fresh marker"
        },
        "text": [
          "fresh"
        ]
      }
    ]
  },
  "inputs": [
    { "mode": "service", "descendant_custody": false },
    {
      "mode": "headless",
      "text": "count marker",
      "kill_on": {
        "path": "count",
        "step": 0
      }
    },
    { "mode": "service", "kill": "executable" },
    {
      "mode": "headless",
      "text": "count marker",
      "answer": "resumed"
    },
    {
      "mode": "headless",
      "text": "count marker",
      "answer": "resumed"
    },
    {
      "mode": "headless",
      "operation": "00000000-0000-0000-0000-000000000002",
      "text": "fresh marker",
      "answer": "fresh"
    }
  ],
  "assert": {
    "requests": 2
  }
}
