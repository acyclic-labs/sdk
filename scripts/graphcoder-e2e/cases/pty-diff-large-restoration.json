{
  "id": "pty-diff-large-restoration",
  "workspace": {
    "kind": "plain",
    "files": {
      ".fixtures/fs.exe": {
        "binary_env": "E2E_FILESYSTEM_BINARY"
      },
      ".fixtures/operation-0.json": "[{\"op\":\"fill\",\"path\":\"large.txt\",\"byte\":121,\"count\":1048574,\"offset\":1},{\"op\":\"write\",\"path\":\"small.txt\",\"text\":\"SMALL_DIFF_E2E\\n\"}]",
      ".fixtures/operation-1.json": "[{\"op\":\"fill\",\"path\":\"large.txt\",\"byte\":120,\"count\":1048574,\"offset\":1}]",
      "large.txt": {
        "repeat": "x",
        "count": 1048576
      }
    }
  },
  "model": {
    "steps": [
      {
        "tools": [
          {
            "id": "change",
            "name": "shell",
            "arguments": {
              "command": "./.fixtures/fs.exe .fixtures/operation-0.json"
            }
          }
        ]
      },
      {
        "text": [
          "LARGE_CHANGE_DONE"
        ]
      },
      {
        "tools": [
          {
            "id": "restore",
            "name": "shell",
            "arguments": {
              "command": "./.fixtures/fs.exe .fixtures/operation-1.json"
            }
          }
        ]
      },
      {
        "text": [
          "LARGE_RESTORE_DONE"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "change files"
        },
        {
          "when": {
            "contains": [
              "LARGE_CHANGE_DONE",
              "○"
            ]
          },
          "prompt": "/diff "
        },
        {
          "when": {
            "new_contains": [
              ["small.txt (added)", "+SMALL_DIFF_E2E"],
              ["large.txt (modified)"]
            ]
          },
          "send": "\u001b[6~"
        },
        {
          "when": {
            "new_contains": [
              ["small.txt (added)", "+SMALL_DIFF_E2E"],
              ["large.txt (modified)"]
            ]
          },
          "send": "\u001b[5~"
        },
        {
          "when": {
            "new_contains": [
              ["small.txt (added)", "+SMALL_DIFF_E2E"],
              ["large.txt (modified)"]
            ]
          },
          "prompt": "restore large file"
        },
        {
          "when": {
            "contains": [
              "small.txt (added)",
              "+SMALL_DIFF_E2E",
              "LARGE_RESTORE_DONE",
              "○"
            ],
            "absent": [
              "large.txt (modified)"
            ]
          },
          "detach": true
        }
      ]
    },
    {
      "mode": "pty",
      "resume": true,
      "actions": [
        {
          "when": {
            "contains": [
              "small.txt (added)",
              "+SMALL_DIFF_E2E"
            ],
            "absent": [
              "large.txt (modified)"
            ]
          },
          "prompt": "/merge "
        },
        {
          "when": {
            "contains": [
              "Merged into checkout:"
            ]
          },
          "detach": true
        }
      ]
    }
  ],
  "assert": {
    "requests": 4,
    "files": {
      "small.txt": "SMALL_DIFF_E2E\n"
    }
  }
}
