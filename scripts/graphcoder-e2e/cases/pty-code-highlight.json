{
  "id": "pty-code-highlight",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "text": [
          "## Code\n\n```rust\n",
          "fn answer() -> u32 {\n    42\n}\n```\n\nRead [docs](https://example.com/docs)."
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "show code"
        },
        {
          "when": {
            "contains": [
              "answer",
              "rust",
              "docs",
              "○"
            ],
            "absent": [
              "```",
              "## Code"
            ]
          },
          "send": "\u001b[200~/help\u001b[201~\r\u001b[27u\u001b[200~/theme light\u001b[201~\r",
          "assert": {
            "raw": [
              "\u001b]8;;https://example.com/docs\u001b\\"
            ],
            "styles": [
              {
                "text": "fn",
                "fg": [
                  6402031,
                  75,
                  14
                ],
                "bg": true
              },
              {
                "text": "42",
                "fg": [
                  15057019,
                  180,
                  11
                ],
                "bg": true
              }
            ]
          }
        },
        {
          "when": {
            "contains": [
              "answer",
              "○"
            ],
            "styles": [
              {
                "text": "fn",
                "fg": [
                  616922,
                  26,
                  4
                ],
                "bg": true
              },
              {
                "text": "42",
                "fg": [
                  10118912,
                  94,
                  3
                ],
                "bg": true
              }
            ]
          },
          "assert": {
            "absent": [
              "Commands",
              "Help"
            ]
          },
          "prompt": "/theme dark"
        },
        {
          "when": {
            "contains": [
              "answer",
              "○"
            ],
            "styles": [
              {
                "text": "fn",
                "fg": [
                  6402031,
                  75,
                  14
                ],
                "bg": true
              }
            ]
          },
          "detach": true
        }
      ]
    }
  ],
  "assert": {
    "requests": 1
  }
}
