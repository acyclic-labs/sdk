{
  "id": "file-tools-chat",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "when": {},
        "tools": [
          {
            "id": "write",
            "name": "write",
            "arguments": {
              "path": "result.txt",
              "text": "before edit\n",
              "media_type": "text/plain",
              "display_name": "result.txt"
            }
          }
        ]
      },
      {
        "when": {
          "tool_result": "version"
        },
        "tools": [
          {
            "id": "edit",
            "name": "edit",
            "arguments": {
              "old_text": "before",
              "new_text": "after",
              "path": "result.txt",
              "version": {
                "$tool_result": "/version"
              }
            }
          }
        ]
      },
      {
        "when": {
          "tool_result": "version"
        },
        "tools": [
          {
            "id": "read",
            "name": "read",
            "arguments": {
              "path": "result.txt",
              "version": {
                "$tool_result": "/version"
              }
            }
          }
        ]
      },
      {
        "when": {
          "tool_result": "after edit"
        },
        "text": [
          "done"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "headless",
      "text": "hello",
      "answer": "done"
    }
  ],
  "assert": {
    "requests": 4,
    "files": {
      "result.txt": "after edit\n"
    },
    "tool_results": [
      {
        "path": "result.txt",
        "text": "after edit\n"
      }
    ],
    "file_versions": [
      {
        "descriptor": {
          "byte_length": 12
        },
        "volume": {
          "class": "project"
        },
        "path": "result.txt"
      },
      {
        "descriptor": {
          "byte_length": 11
        },
        "volume": {
          "class": "project"
        },
        "path": "result.txt"
      }
    ]
  },
  "adapter": "chat"
}
