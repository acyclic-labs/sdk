{
  "id": "pty-approval-form-deny",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "when": {},
        "tools": [
          {
            "id": "write",
            "name": "write",
            "arguments": {
              "path": "approved.txt",
              "text": "APPROVED_E2E\n",
              "media_type": "text/plain",
              "display_name": "approved.txt"
            }
          }
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "graphcoder"
            ],
            "cursor": true
          },
          "prompt": "write approved file"
        },
        {
          "when": {
            "contains": [
              "E2E approval policy"
            ]
          },
          "prompt": "/feedback "
        },
        {
          "when": {
            "contains": [
              "Enter saves locally"
            ]
          },
          "prompt": "y"
        },
        {
          "when": {
            "contains": [
              "E2E approval policy"
            ],
            "absent": [
              "Enter saves locally"
            ]
          },
          "send": "n\r"
        },
        {
          "when": {
            "contains": [
              "declined",
              "Enter sends"
            ],
            "task_failure": "declined"
          },
          "send": "\u0004"
        }
      ],
      "exit": 1
    }
  ],
  "assert": {
    "requests": 1,
    "files": {},
    "jsonl": {
      "hooks.jsonl": [
        {
          "hook_event_name": "PreToolUse"
        }
      ]
    },
    "absent_files": [
      "approved.txt"
    ]
  },
  "settings": {
    ".claude/settings.json": "{\"hooks\":{\"SessionStart\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" ask\"}]}],\"UserPromptSubmit\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" ask\"}]}],\"PreToolUse\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" ask\"}]}],\"PostToolUse\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" ask\"}]}],\"Stop\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"node \\\"{{support}}/hook.mjs\\\" \\\"{{workspace}}/hooks.jsonl\\\" ask\"}]}]}}"
  }
}
