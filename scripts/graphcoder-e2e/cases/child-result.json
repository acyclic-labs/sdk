{
  "id": "child-result",
  "workspace": { "kind": "plain", "files": {} },
  "model": {
    "steps": [
      { "when": { "user": "PARENT_CHILD_RESULT_TASK" }, "tools": [
        { "id": "spawn", "name": "spawn", "arguments": { "name": "worker", "task": "CHILD_RESULT_TASK" } }
      ] },
      { "when": { "user": "PARENT_CHILD_RESULT_TASK", "tool_result": "agent" },
        "text": ["SPAWNED {{tool_result:/agent}}"] },
      { "when": { "user": "CHILD_RESULT_TASK" }, "text": ["CHILD_RESULT_NATIVE_E2E"] },
      { "when": { "user": "child_done", "contains": "CHILD_RESULT_NATIVE_E2E" },
        "text": ["PARENT_READ_CHILD_RESULT"] },
      { "when": { "user": "REPORT_CHILD_RESULT" }, "text": ["done"] }
    ]
  },
  "inputs": [{ "mode": "conversation", "turns": [
    { "id": "spawn", "text": "PARENT_CHILD_RESULT_TASK" },
    { "id": "report", "text": "REPORT_CHILD_RESULT", "after_request": { "step": 3 }, "answer": "done" }
  ] }],
  "assert": {
    "requests": 5,
    "last_model_contains": ["CHILD_RESULT_NATIVE_E2E", "PARENT_READ_CHILD_RESULT"],
    "tool_contains": ["harness/agents/"],
    "wire_contains": ["SPAWNED harness/agents/", "done"]
  }
}
