{
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "inputs": [
    {
      "mode": "qualification",
      "format": "installed-host",
      "host": "codex",
      "tools": [
        "spawn",
        "wait",
        "resume",
        "archive"
      ],
      "prompt": "NATIVE_PLUGIN_MODEL",
      "answer": "NATIVE_PLUGIN_MODEL_DONE"
    }
  ],
  "model": {
    "steps": [
      {
        "when": {
          "user": "NATIVE_PLUGIN_MODEL"
        },
        "tools": [
          {
            "id": "native_parent",
            "name": "exec_command",
            "arguments": {
              "cmd": "node '{{support}}/../../plugin/tests/hosts/native-effects.mjs' parent '{{workspace}}' codex"
            },
            "namespace": "functions"
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_MODEL",
          "tool_result": "NATIVE_EFFECT_PARENT"
        },
        "tools": [
          {
            "id": "native_spawn_1",
            "name": "spawn",
            "arguments": {
              "reference": "native-child",
              "prompt": "NATIVE_PLUGIN_CHILD"
            },
            "namespace": "mcp__acyclic_sessions"
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_MODEL",
          "tool_result": "inbox"
        },
        "tools": [
          {
            "id": "native_wait_2",
            "name": "wait",
            "arguments": {
              "reference": "native-child"
            },
            "namespace": "mcp__acyclic_sessions"
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_MODEL",
          "tool_result": "NATIVE_PLUGIN_CHILD_DONE"
        },
        "tools": [
          {
            "id": "native_merge",
            "name": "exec_command",
            "arguments": {
              "cmd": "node '{{support}}/../../plugin/tests/hosts/native-effects.mjs' merge '{{workspace}}' codex"
            },
            "namespace": "functions"
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_MODEL",
          "tool_result": "NATIVE_EFFECT_MERGE"
        },
        "tools": [
          {
            "id": "native_resume_4",
            "name": "resume",
            "arguments": {
              "reference": "native-child",
              "prompt": "NATIVE_PLUGIN_RESUMED"
            },
            "namespace": "mcp__acyclic_sessions"
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_MODEL",
          "tool_result": "inbox"
        },
        "tools": [
          {
            "id": "native_wait_5",
            "name": "wait",
            "arguments": {
              "reference": "native-child"
            },
            "namespace": "mcp__acyclic_sessions"
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_MODEL",
          "tool_result": "NATIVE_PLUGIN_CHILD_RESUMED"
        },
        "tools": [
          {
            "id": "native_finish",
            "name": "exec_command",
            "arguments": {
              "cmd": "node '{{support}}/../../plugin/tests/hosts/native-effects.mjs' finish '{{workspace}}' codex"
            },
            "namespace": "functions"
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_MODEL",
          "tool_result": "NATIVE_EFFECT_FINISH"
        },
        "tools": [
          {
            "id": "native_archive_7",
            "name": "archive",
            "arguments": {
              "reference": "native-child"
            },
            "namespace": "mcp__acyclic_sessions"
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_MODEL",
          "tool_result": "archive"
        },
        "text": [
          "NATIVE_PLUGIN_MODEL_DONE"
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_CHILD"
        },
        "tools": [
          {
            "id": "native_child",
            "name": "exec_command",
            "arguments": {
              "cmd": "node '{{support}}/../../plugin/tests/hosts/native-effects.mjs' child '{{workspace}}' codex"
            },
            "namespace": "functions"
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_CHILD",
          "tool_result": "NATIVE_EFFECT_CHILD"
        },
        "text": [
          "NATIVE_PLUGIN_CHILD_DONE"
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_RESUMED"
        },
        "tools": [
          {
            "id": "native_resumed",
            "name": "exec_command",
            "arguments": {
              "cmd": "node '{{support}}/../../plugin/tests/hosts/native-effects.mjs' resumed '{{workspace}}' codex"
            },
            "namespace": "functions"
          }
        ]
      },
      {
        "when": {
          "user": "NATIVE_PLUGIN_RESUMED",
          "tool_result": "NATIVE_EFFECT_RESUMED"
        },
        "text": [
          "NATIVE_PLUGIN_CHILD_RESUMED"
        ]
