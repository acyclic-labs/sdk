    ]
  },
  "id": "installed-codex",
  "assert": {
    "requests": 13,
    "tool_contains": [
      "NATIVE_PLUGIN_CHILD_DONE",
      "NATIVE_PLUGIN_CHILD_RESUMED",
      "Succeeded",
      "NATIVE_EFFECT_MERGE",
      "NATIVE_EFFECT_FINISH"
    ],
    "files": {
      "parent.txt": "PARENT",
      "child.txt": "CHILD",
      "resumed.txt": "RESUMED"
