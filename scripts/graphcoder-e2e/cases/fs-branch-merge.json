{
  "id": "fs-branch-merge",
  "workspace": {
    "kind": [
      "git",
      "plain"
    ],
    "files": {}
  },
  "model": {
    "steps": []
  },
  "inputs": [
    {
      "format": "workspace-fs",
      "steps": [
        {
          "args": [
            "branch",
            "topic"
          ]
        },
        {
          "args": [
            "switch",
            "topic"
          ]
        },
        {
          "write": {
            "path": "topic.txt",
            "content": "TOPIC_E2E\n"
          }
        },
        {
          "args": [
            "add",
            "topic.txt"
          ]
        },
        {
          "args": [
            "commit",
            "-m",
            "topic"
          ]
        },
        {
          "args": [
            "switch",
            "main"
          ]
        },
        {
          "absent": "topic.txt"
        },
        {
          "args": [
            "merge",
            "topic"
          ]
        },
        {
          "args": [
            "diff"
          ]
        },
        {
          "args": [
            "log"
          ]
        },
        {
          "args": [
            "show",
            "HEAD"
          ]
        }
      ],
      "mode": "qualification"
    }
  ],
  "assert": {
    "requests": 0,
    "files": {
