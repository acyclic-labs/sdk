{
  "id": "pty-diff-modified",
  "workspace": {
    "kind": "plain",
    "files": {
      "d.txt": "let value = old_value;\n"
    }
  },
  "model": {
    "steps": [
      {
        "when": {},
        "tools": [
          {
            "id": "change",
            "name": "write",
            "arguments": {
              "path": "d.txt",
              "content": "let value = new_value;\n"
            }
          }
        ]
      },
      {
        "when": {},
        "text": [
          "DONE_EDIT"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "edit a file"
        },
        {
          "when": {
            "contains": [
              "DONE_EDIT",
              "○"
            ]
          },
          "prompt": "/diff "
        },
        {
          "when": {
            "styles": [
              {
                "bold": true,
                "text": "old_value"
              },
              {
                "bold": true,
                "text": "new_value"
              },
              {
                "bold": false,
                "text": "let value = "
              }
            ],
            "contains": [
              "d.txt (modified) +1 -1",
              "old_value",
              "new_value"
            ],
            "separate_rows": [
              [
                "old_value",
                "new_value"
              ]
            ]
          },
          "resize": {
            "cols": 170,
            "rows": 30
          }
        },
        {
          "when": {
            "styles": [
              {
                "bold": true,
                "text": "old_value"
              },
              {
                "bold": true,
                "text": "new_value"
              },
              {
                "bold": false,
                "text": "let value = "
              }
            ],
            "same_row": [
              [
                "old_value",
                "new_value"
              ]
            ],
            "contains": [
              "d.txt (modified) +1 -1",
              "old_value",
              "new_value"
            ]
          },
          "send": " "
        },
        {
          "when": {
            "contains": [
              "d.txt (modified) +1 -1",
              "@@"
            ],
            "absent": [
              "old_value",
              "new_value"
            ]
          },
          "send": " "
        },
        {
          "when": {
            "same_row": [
              [
                "old_value",
                "new_value"
              ]
            ],
            "contains": [
              "d.txt (modified) +1 -1",
              "old_value",
              "new_value"
            ]
          },
          "resize": {
            "cols": 80,
            "rows": 24
          }
        },
        {
          "when": {
            "styles": [
              {
                "bold": true,
                "text": "old_value"
              },
              {
                "bold": true,
                "text": "new_value"
              },
              {
                "bold": false,
                "text": "let value = "
              }
            ],
            "contains": [
              "d.txt (modified) +1 -1",
              "old_value",
              "new_value"
            ],
            "separate_rows": [
              [
                "old_value",
                "new_value"
              ]
            ]
          },
          "prompt": "/merge "
        },
        {
          "when": {
            "contains": [
              "Merged into checkout:"
            ]
          },
          "detach": true
        }
      ]
    }
  ],
  "assert": {
    "requests": 2,
    "files": {
      "d.txt": "let value = new_value;\n"
    }
  }
}
