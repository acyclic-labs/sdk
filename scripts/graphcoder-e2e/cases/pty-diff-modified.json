{
  "id": "pty-diff-modified",
  "workspace": {
    "kind": "plain",
    "files": {
      "d.txt": "DIFF_E2E_BEFORE\n"
    }
  },
  "model": {
    "steps": [
      {
        "when": {},
        "tools": [
          {
            "id": "change",
            "name": "write",
            "arguments": {
              "path": "d.txt",
              "text": "DIFF_E2E_CONTENT\n",
              "media_type": "text/plain",
              "display_name": "d.txt"
            }
          }
        ]
      },
      {
        "when": {},
        "text": [
          "DONE_EDIT"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "edit a file"
        },
        {
          "when": {
            "contains": [
              "DONE_EDIT",
              "○"
            ]
          },
          "prompt": "/diff "
        },
        {
          "when": {
            "contains": [
              "d.txt (modified) +1 -1",
              "-DIFF_E2E_BEFORE",
              "+DIFF_E2E_CONTENT"
            ]
          },
          "send": "\u0004"
        }
      ]
    }
  ],
  "assert": {
    "requests": 2,
    "files": {
      "d.txt": "DIFF_E2E_CONTENT\n"
    }
  }
}
