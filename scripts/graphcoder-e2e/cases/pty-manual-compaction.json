{
  "id": "pty-manual-compaction",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "when": {
          "user": "remember MANUAL_E2E_FACT"
        },
        "text": [
          "MANUAL_E2E_FIRST"
        ]
      },
      {
        "when": {
          "contains": "refuse unmatched summary"
        },
        "status": 400,
        "json": {
          "error": {
            "message": "scripted refusal",
            "type": "invalid_request_error"
          }
        }
      },
      {
        "when": {
          "contains": "preserve the fact"
        },
        "text": [
          "COMPACTED_E2E_FACT"
        ]
      },
      {
        "when": {
          "user": "after compact",
          "contains": "COMPACTED_E2E_FACT"
        },
        "text": [
          "MANUAL_E2E_DONE"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "remember MANUAL_E2E_FACT"
        },
        {
          "when": {
            "contains": [
              "MANUAL_E2E_FIRST",
              "○"
            ]
          },
          "prompt": "/compact refuse unmatched summary",
          "send": "\u001b[200~/compact preserve the fact\u001b[201~\r"
        },
        {
          "when": {
            "contains": [
              "Compacted conversation",
              "○",
              "context ?"
            ]
          },
          "assert": {
            "task_failure": "model HTTP status 400"
          },
          "prompt": "after compact",
          "after_request": {
            "path": "responses",
            "step": 2
          }
        },
        {
          "when": {
            "contains": [
              "MANUAL_E2E_DONE",
              "○"
            ]
          },
          "detach": true
        }
      ]
    }
  ],
  "assert": {
    "requests": 4,
    "last_model_contains": [
      "COMPACTED_E2E_FACT"
    ],
    "last_model_absent": [
      "MANUAL_E2E_FIRST"
    ]
  }
}
