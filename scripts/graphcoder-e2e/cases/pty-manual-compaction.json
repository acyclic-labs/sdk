{
  "id": "pty-manual-compaction",
  "workspace": {
    "kind": "plain",
    "files": {}
  },
  "model": {
    "steps": [
      {
        "when": {
          "user": "remember MANUAL_E2E_FACT"
        },
        "text": [
          "MANUAL_E2E_FIRST"
        ]
      },
      {
        "when": {
          "contains": "preserve the fact"
        },
        "text": [
          "COMPACTED_E2E_FACT"
        ]
      },
      {
        "when": {
          "user": "after compact",
          "contains": "COMPACTED_E2E_FACT"
        },
        "text": [
          "MANUAL_E2E_DONE"
        ]
      }
    ]
  },
  "inputs": [
    {
      "mode": "pty",
      "actions": [
        {
          "when": {
            "contains": [
              "GraphCoder"
            ],
            "cursor": true
          },
          "prompt": "remember MANUAL_E2E_FACT"
        },
        {
          "when": {
            "contains": [
              "MANUAL_E2E_FIRST",
              "○"
            ]
          },
          "prompt": "/compact refuse unmatched summary"
        },
        {
          "when": {
            "contains": [
              "MANUAL_E2E_FIRST",
              "○"
            ],
            "task_failure": "model HTTP status 409"
          },
          "prompt": "/compact preserve the fact",
          "after_request": {
            "path": "responses",
            "step": null
          }
        },
        {
          "when": {
            "contains": [
              "Compacted conversation",
              "○"
            ]
          },
          "prompt": "after compact",
          "after_request": {
            "path": "responses",
            "step": 1
          }
        },
        {
          "when": {
            "contains": [
              "MANUAL_E2E_DONE",
              "○"
            ]
          },
          "send": "\u0004"
        }
      ]
    }
  ],
  "assert": {
    "requests": 4,
    "last_model_contains": [
      "COMPACTED_E2E_FACT"
    ],
    "last_model_absent": [
      "MANUAL_E2E_FIRST"
    ]
  }
}
